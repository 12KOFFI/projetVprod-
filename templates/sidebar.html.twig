{#
    Navigation latérale, par rôle.

    ROLE_ADMIN hérite de tous les autres rôles : sans la clause
    « and not is_granted('ROLE_ADMIN') », les menus Recevabilité et Accueil
    s'afficheraient pour lui alors que leurs écrans s'appuient sur le centre de
    rattachement — qu'un administrateur n'a pas. Ils ne mèneraient qu'à des
    écrans « sans centre ».
#}
{% set nav_classes = {
    base_link: 'flex items-center space-x-3 px-4 py-3 rounded-xl transition group',
    inactive_link: 'text-indigo-100 hover:bg-white/10 hover:text-white',
    active_link: 'bg-white/20 text-white',
    active_indicator: 'ml-auto w-1.5 h-5 bg-white rounded-full',
    menu_button: 'w-full flex items-center justify-between px-4 py-3 rounded-xl text-indigo-100 hover:bg-white/10 hover:text-white transition group',
    menu_button_icon: 'fas fa-chevron-down text-xs transition-transform duration-200',
    sous_lien: 'flex items-center space-x-3 px-4 py-2 rounded-lg text-sm transition'
} %}

{% set est_admin = is_granted('ROLE_ADMIN') %}

<nav class="space-y-2">
    <!-- Logo pour sidebar réduite -->
    <div class="flex justify-center mb-8 sidebar-logo-text">
        <a href="{{ path('app_home') }}">
            <img src="{{ asset('image/logo.png') }}" class="h-10 rounded" alt="DAIP">
        </a>
    </div>

    <!-- Tableau de bord -->
    <a href="{{ path('app_dashboard') }}"
       class="{{ nav_classes.base_link }} {{ app.current_route starts with 'app_dashboard' or app.current_route == 'app_admin_dashboard' ? nav_classes.active_link : nav_classes.inactive_link }}">
        <i class="fas fa-tachometer-alt w-5 text-lg"></i>
        <span class="nav-text text-sm font-medium">Tableau de bord</span>
        {% if app.current_route starts with 'app_dashboard' or app.current_route == 'app_admin_dashboard' %}
        <span class="{{ nav_classes.active_indicator }}"></span>
        {% endif %}
    </a>

    {% if is_granted('ROLE_CANDIDAT') and not est_admin %}
    <!-- Espace candidat (module M3) -->
    <a href="{{ path('app_candidat_dashboard') }}"
       class="{{ nav_classes.base_link }} {{ app.current_route == 'app_candidat_dashboard' or app.current_route starts with 'app_candidat_candidature' ? nav_classes.active_link : nav_classes.inactive_link }}">
        <i class="fas fa-folder-open w-5 text-lg"></i>
        <span class="nav-text text-sm font-medium">Mon dossier</span>
        {% if app.current_route == 'app_candidat_dashboard' or app.current_route starts with 'app_candidat_candidature' %}
        <span class="{{ nav_classes.active_indicator }}"></span>
        {% endif %}
    </a>

    <a href="{{ path('app_candidat_paiements') }}"
       class="{{ nav_classes.base_link }} {{ app.current_route starts with 'app_candidat_paiement' ? nav_classes.active_link : nav_classes.inactive_link }}">
        <i class="fas fa-credit-card w-5 text-lg"></i>
        <span class="nav-text text-sm font-medium">Mes paiements</span>
        {% if app.current_route starts with 'app_candidat_paiement' %}
        <span class="{{ nav_classes.active_indicator }}"></span>
        {% endif %}
    </a>
    {% endif %}

    {% if is_granted('ROLE_CONSEILLER') and not est_admin %}
    <!-- Espace conseiller VAE (module M4) -->
    <div x-data="{ open: {{ app.current_route starts with 'app_conseiller_' ? 'true' : 'false' }} }">
        <button @click="open = !open" class="{{ nav_classes.menu_button }}">
            <div class="flex items-center space-x-3">
                <i class="fas fa-user-tie w-5 text-lg"></i>
                <span class="nav-text text-sm font-medium">Recevabilité</span>
            </div>
            <i class="{{ nav_classes.menu_button_icon }}" :class="{ 'rotate-180': open }"></i>
        </button>

        <div x-show="open" x-transition:enter="transition ease-out duration-200"
             x-transition:enter-start="opacity-0 -translate-y-2"
             x-transition:enter-end="opacity-100 translate-y-0"
             class="pl-12 mt-1 space-y-1">
            <a href="{{ path('app_conseiller_dashboard') }}"
               class="{{ nav_classes.sous_lien }} {{ app.current_route == 'app_conseiller_dashboard' ? nav_classes.active_link : nav_classes.inactive_link }}">
                <i class="fas fa-gauge w-4"></i>
                <span class="nav-text">Tableau de bord</span>
            </a>
            <a href="{{ path('app_conseiller_candidatures') }}"
               class="{{ nav_classes.sous_lien }} {{ app.current_route starts with 'app_conseiller_candidature' ? nav_classes.active_link : nav_classes.inactive_link }}">
                <i class="fas fa-folder-open w-4"></i>
                <span class="nav-text">Étude de dossier</span>
            </a>
        </div>
    </div>
    {% endif %}

    {% if is_granted('ROLE_AGENT_ACCEUIL') and not est_admin %}
    <!-- Espace agent d'accueil (module M3) -->
    <div x-data="{ open: {{ app.current_route starts with 'app_accueil_' ? 'true' : 'false' }} }">
        <button @click="open = !open" class="{{ nav_classes.menu_button }}">
            <div class="flex items-center space-x-3">
                <i class="fas fa-bell-concierge w-5 text-lg"></i>
                <span class="nav-text text-sm font-medium">Accueil</span>
            </div>
            <i class="{{ nav_classes.menu_button_icon }}" :class="{ 'rotate-180': open }"></i>
        </button>

        <div x-show="open" x-transition:enter="transition ease-out duration-200"
             x-transition:enter-start="opacity-0 -translate-y-2"
             x-transition:enter-end="opacity-100 translate-y-0"
             class="pl-12 mt-1 space-y-1">
            <a href="{{ path('app_accueil_dashboard') }}"
               class="{{ nav_classes.sous_lien }} {{ app.current_route == 'app_accueil_dashboard' ? nav_classes.active_link : nav_classes.inactive_link }}">
                <i class="fas fa-gauge w-4"></i>
                <span class="nav-text">Tableau de bord</span>
            </a>
            <a href="{{ path('app_accueil_inscription') }}"
               class="{{ nav_classes.sous_lien }} {{ app.current_route == 'app_accueil_inscription' ? nav_classes.active_link : nav_classes.inactive_link }}">
                <i class="fas fa-user-plus w-4"></i>
                <span class="nav-text">Nouvelle préinscription</span>
            </a>
             <a href="{{ path('app_accueil_candidatures') }}"
               class="{{ nav_classes.sous_lien }} {{ app.current_route == 'app_accueil_candidatures' ? nav_classes.active_link : nav_classes.inactive_link }}">
                <i class="fas fa-list w-4"></i>
                <span class="nav-text">Candidatures du centre</span>
            </a>
            <a href="{{ path('app_accueil_reprise') }}"
               class="{{ nav_classes.sous_lien }} {{ app.current_route == 'app_accueil_reprise' ? nav_classes.active_link : nav_classes.inactive_link }}">
                <i class="fas fa-folder-plus w-4"></i>
                <span class="nav-text">Reprise de dossier</span>
            </a>
           
            <a href="{{ path('app_accueil_conseillers') }}"
               class="{{ nav_classes.sous_lien }} {{ app.current_route == 'app_accueil_conseillers' ? nav_classes.active_link : nav_classes.inactive_link }}">
                <i class="fas fa-user-tie w-4"></i>
                <span class="nav-text">Conseillers VAE</span>
            </a>
        </div>
    </div>
    {% endif %}

    {% if est_admin %}
    <!-- Dossiers, toutes vues confondues -->
    {% set dans_candidatures = app.current_route starts with 'app_admin_candidature' or app.current_route starts with 'app_admin_suivi_' %}
    <div x-data="{ open: {{ dans_candidatures ? 'true' : 'false' }} }">
        <button @click="open = !open" class="{{ nav_classes.menu_button }}">
            <div class="flex items-center space-x-3">
                <i class="fas fa-folder-open w-5 text-lg"></i>
                <span class="nav-text text-sm font-medium">Candidatures</span>
            </div>
            <i class="{{ nav_classes.menu_button_icon }}" :class="{ 'rotate-180': open }"></i>
        </button>

        <div x-show="open" x-transition:enter="transition ease-out duration-200"
             x-transition:enter-start="opacity-0 -translate-y-2"
             x-transition:enter-end="opacity-100 translate-y-0"
             class="pl-12 mt-1 space-y-1">
            <a href="{{ path('app_admin_candidature_index') }}"
               class="{{ nav_classes.sous_lien }} {{ app.current_route starts with 'app_admin_candidature' ? nav_classes.active_link : nav_classes.inactive_link }}">
                <i class="fas fa-list w-4"></i>
                <span class="nav-text">Tous les dossiers</span>
            </a>
            <a href="{{ path('app_admin_suivi_recevables') }}"
               class="{{ nav_classes.sous_lien }} {{ app.current_route == 'app_admin_suivi_recevables' ? nav_classes.active_link : nav_classes.inactive_link }}">
                <i class="fas fa-circle-check w-4"></i>
                <span class="nav-text">Candidats recevables</span>
            </a>
            <a href="{{ path('app_admin_suivi_eligibles') }}"
               class="{{ nav_classes.sous_lien }} {{ app.current_route == 'app_admin_suivi_eligibles' ? nav_classes.active_link : nav_classes.inactive_link }}">
                <i class="fas fa-clipboard-check w-4"></i>
                <span class="nav-text">Candidats éligibles</span>
            </a>
        </div>
    </div>
    {% endif %}

    {% if is_granted('ROLE_CONSEILLER') or is_granted('ROLE_ACCOMPAGNATEUR') %}
    <!-- Indicateurs : écran transverse, fermé au candidat et à l'agent d'accueil (cf. security.yaml) -->
    <a href="{{ path('app_indicateurs') }}"
       class="{{ nav_classes.base_link }} {{ app.current_route == 'app_indicateurs' ? nav_classes.active_link : nav_classes.inactive_link }}">
        <i class="fas fa-chart-column w-5 text-lg"></i>
        <span class="nav-text text-sm font-medium">Indicateurs</span>
        {% if app.current_route == 'app_indicateurs' %}
        <span class="{{ nav_classes.active_indicator }}"></span>
        {% endif %}
    </a>
    {% endif %}

    <!-- Impressions : écran transverse, tous rôles -->
    <a href="{{ path('app_impressions') }}"
       class="{{ nav_classes.base_link }} {{ app.current_route starts with 'app_impressions' ? nav_classes.active_link : nav_classes.inactive_link }}">
        <i class="fas fa-print w-5 text-lg"></i>
        <span class="nav-text text-sm font-medium">Impressions</span>
        {% if app.current_route starts with 'app_impressions' %}
        <span class="{{ nav_classes.active_indicator }}"></span>
        {% endif %}
    </a>

    {% if est_admin %}
    {% if jury_imports_actifs %}
   
    <div x-data="{ open: {{ app.current_route starts with 'app_admin_jury_' ? 'true' : 'false' }} }">
        <button @click="open = !open" class="{{ nav_classes.menu_button }}">
            <div class="flex items-center space-x-3">
                <i class="fas fa-gavel w-5 text-lg"></i>
                <span class="nav-text text-sm font-medium">Chargement</span>
            </div>
            <i class="{{ nav_classes.menu_button_icon }}" :class="{ 'rotate-180': open }"></i>
        </button>

        <div x-show="open" x-transition:enter="transition ease-out duration-200"
             x-transition:enter-start="opacity-0 -translate-y-2"
             x-transition:enter-end="opacity-100 translate-y-0"
             class="pl-12 mt-1 space-y-1">
            <a href="{{ path('app_admin_jury_eligibilite') }}"
               class="{{ nav_classes.sous_lien }} {{ app.current_route == 'app_admin_jury_eligibilite' ? nav_classes.active_link : nav_classes.inactive_link }}">
                <i class="fas fa-file-import w-4"></i>
                <span class="nav-text">Décisions d'éligibilité</span>
            </a>
            <a href="{{ path('app_admin_jury_admission') }}"
               class="{{ nav_classes.sous_lien }} {{ app.current_route == 'app_admin_jury_admission' ? nav_classes.active_link : nav_classes.inactive_link }}">
                <i class="fas fa-award w-4"></i>
                <span class="nav-text">Décisions d'admission</span>
            </a>
        </div>
    </div>
    {% endif %}

    <!-- Suivi des paiements (module M5) -->
    <a href="{{ path('app_admin_paiement_index') }}"
       class="{{ nav_classes.base_link }} {{ app.current_route starts with 'app_admin_paiement' ? nav_classes.active_link : nav_classes.inactive_link }}">
        <i class="fas fa-money-bill-transfer w-5 text-lg"></i>
        <span class="nav-text text-sm font-medium">Paiements</span>
        {% if app.current_route starts with 'app_admin_paiement' %}
        <span class="{{ nav_classes.active_indicator }}"></span>
        {% endif %}
    </a>

    <!-- Paramètres : référentiels d'administration (module M2) -->
    {% set dans_parametres = app.current_route starts with 'app_admin_direction_regionale'
        or app.current_route starts with 'app_admin_localite'
        or app.current_route starts with 'app_admin_filiere'
        or app.current_route starts with 'app_admin_metier'
        or app.current_route starts with 'app_admin_centre'
        or app.current_route starts with 'app_admin_personnel' %}
    <div x-data="{ open: {{ dans_parametres ? 'true' : 'false' }} }">
        <button @click="open = !open" class="{{ nav_classes.menu_button }}">
            <div class="flex items-center space-x-3">
                <i class="fas fa-sliders w-5 text-lg"></i>
                <span class="nav-text text-sm font-medium">Paramètres</span>
            </div>
            <i class="{{ nav_classes.menu_button_icon }}" :class="{ 'rotate-180': open }"></i>
        </button>

        <div x-show="open" x-transition:enter="transition ease-out duration-200"
             x-transition:enter-start="opacity-0 -translate-y-2"
             x-transition:enter-end="opacity-100 translate-y-0"
             class="pl-12 mt-1 space-y-1">
            <a href="{{ path('app_admin_direction_regionale_index') }}"
               class="{{ nav_classes.sous_lien }} {{ app.current_route starts with 'app_admin_direction_regionale' ? nav_classes.active_link : nav_classes.inactive_link }}">
                <i class="fas fa-sitemap w-4"></i>
                <span class="nav-text">Directions régionales</span>
            </a>
            <a href="{{ path('app_admin_localite_index') }}"
               class="{{ nav_classes.sous_lien }} {{ app.current_route starts with 'app_admin_localite' ? nav_classes.active_link : nav_classes.inactive_link }}">
                <i class="fas fa-location-dot w-4"></i>
                <span class="nav-text">Localités</span>
            </a>
            <a href="{{ path('app_admin_filiere_index') }}"
               class="{{ nav_classes.sous_lien }} {{ app.current_route starts with 'app_admin_filiere' ? nav_classes.active_link : nav_classes.inactive_link }}">
                <i class="fas fa-layer-group w-4"></i>
                <span class="nav-text">Filières</span>
            </a>
            <a href="{{ path('app_admin_metier_index') }}"
               class="{{ nav_classes.sous_lien }} {{ app.current_route starts with 'app_admin_metier' ? nav_classes.active_link : nav_classes.inactive_link }}">
                <i class="fas fa-screwdriver-wrench w-4"></i>
                <span class="nav-text">Métiers</span>
            </a>
            <a href="{{ path('app_admin_centre_index') }}"
               class="{{ nav_classes.sous_lien }} {{ app.current_route starts with 'app_admin_centre' ? nav_classes.active_link : nav_classes.inactive_link }}">
                <i class="fas fa-building w-4"></i>
                <span class="nav-text">Centres</span>
            </a>
            <a href="{{ path('app_admin_personnel_index') }}"
               class="{{ nav_classes.sous_lien }} {{ app.current_route starts with 'app_admin_personnel' ? nav_classes.active_link : nav_classes.inactive_link }}">
                <i class="fas fa-users-gear w-4"></i>
                <span class="nav-text">Comptes du personnel</span>
            </a>
        </div>
    </div>
    {% endif %}
</nav>
