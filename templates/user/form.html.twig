{% extends 'base_dashboard.html.twig' %}

{% block title %}{{ is_edit ? 'Modifier' : 'Créer' }} un compte | {{ parent() }}{% endblock %}

{# Définition de la classe CSS réutilisable #}
{% set input_class = 'w-full px-4 py-2 rounded-lg border border-slate-200 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition' %}

{% block body %}
<div class="mx-auto">
    <!-- ==================== EN-TÊTE ==================== -->
    <div class="bg-gradient-to-r from-indigo-600 to-purple-600 rounded-2xl p-8 mb-8 text-white">
        <div class="flex items-center gap-4">
            <div class="w-16 h-16 bg-white/20 rounded-full flex items-center justify-center">
                <i class="fas {{ is_edit ? 'fa-user-edit' : 'fa-user-plus' }} text-3xl"></i>
            </div>
            <div>
                <h1 class="text-2xl font-bold">
                    {{ is_edit ? 'Modifier mon profil' : 'Créer un compte candidat' }}
                </h1>
                <p class="text-white/80">
                    {{ is_edit ? 'Mettez à jour vos informations personnelles' : 'Remplissez vos informations pour créer votre espace personnel' }}
                </p>
            </div>
        </div>
    </div>

    <!-- ==================== MESSAGES FLASH ==================== -->
    {% include 'partials/_flash_messages.html.twig' %}

    <!-- ==================== FORMULAIRE ==================== -->
    <div class="bg-white rounded-2xl shadow-xl border border-slate-200 overflow-hidden p-8">
            {{ form_start(form, {'attr': {'class': 'space-y-6', 'novalidate': 'novalidate'}}) }}

            <!-- Identité -->
            <h3 class="text-md font-semibold text-slate-800 mb-4">Identité</h3>
            <div class="grid grid-cols-2 gap-4">
                <div>{{ form_row(form.nom, {'attr': {'class': input_class ~ ' uppercase', 'placeholder': 'Votre nom'}}) }}</div>
                <div>{{ form_row(form.prenoms, {'attr': {'class': input_class, 'placeholder': 'Vos prénoms'}}) }}</div>
                <div>{{ form_row(form.nomjeunefille, {'attr': {'class': input_class, 'placeholder': 'Si applicable'}}) }}</div>
                <div>{{ form_row(form.sexe, {'attr': {'class': input_class}}) }}</div>
            </div>

            <!-- Naissance -->
            <h3 class="text-md font-semibold text-slate-800 mb-4">Naissance et nationalité</h3>
            <div class="grid grid-cols-2 gap-4">
                <div>{{ form_row(form.datenaissance, {'attr': {'class': input_class}}) }}</div>
                <div>{{ form_row(form.lieunaissance, {'attr': {'class': input_class, 'placeholder': 'Ville de naissance'}}) }}</div>
                <div>{{ form_row(form.nationalite, {'attr': {'class': input_class}}) }}</div>
                <div>{{ form_row(form.numextrait, {'attr': {'class': input_class, 'placeholder': 'Numéro d\'extrait'}}) }}</div>
            </div>

            <!-- Contact -->
            <h3 class="text-md font-semibold text-slate-800 mb-4">Résidence et contact</h3>
            <div class="grid grid-cols-2 gap-4">
                <div>{{ form_row(form.residence, {'attr': {'class': input_class, 'placeholder': 'Votre ville de résidence'}}) }}</div>
                <div>{{ form_row(form.contact, {'attr': {'class': input_class, 'placeholder': 'Ex: 0708091011', 'pattern': '[0-9]{10}', 'maxlength': '10'}}) }}</div>
                <div>{{ form_row(form.situationmat, {'attr': {'class': input_class}}) }}</div>
            </div>

            <!-- Parents -->
            <h3 class="text-md font-semibold text-slate-800 mb-4">Informations sur les parents</h3>
            <div class="grid grid-cols-2 gap-4">
                <div>{{ form_row(form.nompere, {'attr': {'class': input_class, 'placeholder': 'Nom du père'}}) }}</div>
                <div>{{ form_row(form.nommere, {'attr': {'class': input_class, 'placeholder': 'Nom de la mère'}}) }}</div>
            </div>

            <!-- Acceptation -->
            {% if not is_edit %}
            <div class="p-4 bg-slate-50 rounded-lg">
                <div class="flex items-start">
                    <input type="checkbox" id="accept" class="mt-1 mr-3" required>
                    <label for="accept" class="text-sm text-slate-600">
                        J'accepte que les informations fournies soient utilisées dans le cadre de ma candidature 
                        et j'atteste sur l'honneur leur exactitude.
                    </label>
                </div>
            </div>
            {% endif %}
            
            
            {% if not is_edit %}
<div class="bg-indigo-50 rounded-xl p-5">
    <h3 class="text-md font-semibold text-indigo-800 mb-4">Identifiants de connexion</h3>
    <div class="grid grid-cols-2 gap-4">
        <div class="col-span-2">
            {{ form_row(form.email, {'attr': {'class': is_edit ? input_class ~ ' bg-slate-100 cursor-not-allowed' : input_class}}) }}
        </div>
        {% if is_register %}
            <div>{{ form_row(form.password.first, {'attr': {'class': input_class}}) }}</div>
            <div>{{ form_row(form.password.second, {'attr': {'class': input_class}}) }}</div>
        {% endif %}
    </div>
</div>
            {% endif %}

            <!-- Boutons -->
            <div class="flex justify-between items-center pt-4 border-t border-slate-200">
                
                <button type="submit" class="px-8 py-3 bg-gradient-to-r from-indigo-600 to-purple-600 text-white font-semibold rounded-lg hover:from-indigo-700 hover:to-purple-700 transition transform hover:scale-105 shadow-lg">
                    <i class="fas {{ is_edit ? 'fa-save' : 'fa-user-plus' }} mr-2"></i>
                    {{ is_edit ? 'Mettre à jour' : 'Créer mon compte' }}
                </button>
            </div>

            {{ form_end(form) }}
        </div>

    {% if not is_edit %}
    <!-- Lien connexion -->
    <div class="text-center mt-6">
        <p class="text-slate-600">
            Déjà inscrit ? 
            <a href="{{ path('app_login') }}" class="text-indigo-600 hover:text-indigo-800 font-semibold inline-flex items-center">
                Connectez-vous
                <i class="fas fa-arrow-right ml-1 text-sm"></i>
            </a>
        </p>
    </div>
    {% endif %}
</div>

<!-- ==================== JAVASCRIPT ==================== -->
<script>
document.addEventListener('DOMContentLoaded', function() {
    // Animation des champs au focus
    const inputs = document.querySelectorAll('input, select');
    inputs.forEach(input => {
        input.addEventListener('focus', function() {
            this.classList.add('ring-2', 'ring-indigo-300');
        });
        input.addEventListener('blur', function() {
            this.classList.remove('ring-2', 'ring-indigo-300');
        });
    });
});
</script>
{% endblock %}