{#
    Indicateurs : écran de pilotage partagé, contenu réduit au périmètre du rôle.

    L'administration filtre tout l'écran (filtres en cascade, pastilles, parts
    d'anneau) sans rechargement : indicateursDynamiques (assets/app.js)
    redemande le contenu au serveur, qui ne renvoie alors que
    indicateurs/_contenu.html.twig, et met l'URL à jour.
#}
{% extends 'base_dashboard.html.twig' %}

{% block title %}Indicateurs — Côte d'Ivoire VAE{% endblock %}

{% block body %}
{% if est_admin %}
    <div x-data="indicateursDynamiques()"
         @click="lien($event)" @submit.prevent="soumettre($event)" @etape-change="etapeChangee($event.detail.etape)">
        <div x-show="erreur" x-cloak role="alert"
             class="mb-4 flex flex-col gap-3 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800 sm:flex-row sm:items-center sm:justify-between">
            <p><i class="fas fa-circle-exclamation mr-2" aria-hidden="true"></i>Les indicateurs n'ont pas pu être mis à jour. Vérifiez la connexion puis réessayez.</p>
            <button type="button" @click="reessayer()"
                    class="inline-flex min-h-[44px] items-center gap-2 self-start rounded-lg border border-red-300 bg-white px-4 font-semibold text-red-700 hover:bg-red-50
                           focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-red-600 focus-visible:ring-offset-2">
                <i class="fas fa-rotate-right text-xs" aria-hidden="true"></i>Réessayer
            </button>
        </div>
        <div x-ref="contenu" :aria-busy="chargement ? 'true' : 'false'"
             class="transition-opacity duration-200 motion-reduce:transition-none" :class="chargement && 'pointer-events-none opacity-60'">
            {% include 'indicateurs/_contenu.html.twig' %}
        </div>
    </div>
{% else %}
    {% include 'indicateurs/_contenu.html.twig' %}
{% endif %}
{% endblock %}
