{% extends 'base_dashboard.html.twig' %}

{% block title %}{{ is_admin ? 'Gestion des candidatures' : 'Mes candidatures' }} | {{ parent() }}{% endblock %}

{% block body %}

{# ===== EN-TÊTE ===== #}
<div class="bg-gradient-to-r from-indigo-600 to-purple-600 rounded-2xl p-6 md:p-8 mb-8 text-white relative overflow-hidden">
    <div class="absolute -top-14 -right-14 w-52 h-52 rounded-full bg-white/5 pointer-events-none"></div>
    <div class="absolute -bottom-20 left-1/3 w-72 h-72 rounded-full bg-white/[0.03] pointer-events-none"></div>

    <div class="relative z-10 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div class="flex items-center gap-4">
            <div class="w-14 h-14 rounded-2xl bg-white/15 backdrop-blur border border-white/20 flex items-center justify-center text-2xl shrink-0">
                <i class="fas fa-{{ is_admin ? 'users' : 'file-alt' }}"></i>
            </div>
            <div>
                <h1 class="text-xl md:text-2xl font-bold tracking-tight">
                    {{ is_admin ? 'Gestion des candidatures' : 'Mes candidatures' }}
                </h1>
                <p class="text-white/70 text-sm mt-0.5">
                    {% if is_admin %}{{ candidatures|length }} candidature(s) au total
                    {% else %}{{ candidatures|length }} candidature(s) soumise(s){% endif %}
                </p>
            </div>
        </div>

        {% if is_admin %}
            <div class="flex gap-2 flex-wrap">
                <a href="{{ path('app_candidature_impressions') }}"
                   class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-white/10 hover:bg-white/20 border border-white/20 text-sm font-medium transition-all duration-200 hover:-translate-y-0.5">
                    <i class="fas fa-download"></i> Exports
                </a>
                <a href="{{ path('app_candidature_stat') }}"
                   class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-white/10 hover:bg-white/20 border border-white/20 text-sm font-medium transition-all duration-200 hover:-translate-y-0.5">
                    <i class="fas fa-chart-bar"></i> Statistiques
                </a>
            </div>
        {% else %}
            <a href="{{ path('app_candidature_new') }}"
               class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-white text-indigo-600 hover:bg-indigo-50 border border-white text-sm font-semibold transition-all duration-200 hover:-translate-y-0.5 w-full md:w-auto justify-center">
                <i class="fas fa-plus-circle"></i> Nouvelle candidature
            </a>
        {% endif %}
    </div>
</div>

{# ===== FLASH MESSAGES ===== #}
{% for type, messages in app.flashes %}
    {% for message in messages %}
        {% set colors = type == 'success' ? 'bg-green-50 border-green-300 text-green-700' : (type == 'error' ? 'bg-red-50 border-red-300 text-red-700' : 'bg-blue-50 border-blue-300 text-blue-700') %}
        {% set icon = type == 'success' ? 'check-circle' : (type == 'error' ? 'exclamation-circle' : 'info-circle') %}
        <div class="flex items-center gap-3 px-5 py-4 rounded-xl border mb-4 text-sm font-medium {{ colors }}">
            <i class="fas fa-{{ icon }}"></i>
            {{ message|raw }}
        </div>
    {% endfor %}
{% endfor %}

{# ===== TABLEAU ===== #}
{% if candidatures|length > 0 %}
<div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">

    {# Toolbar #}
    <div class="flex flex-wrap items-center justify-between gap-3 px-6 py-4 border-b border-slate-100 bg-slate-50/60">
        <div class="flex items-center gap-2 text-sm text-slate-500 font-medium">
            <span>Afficher</span>
            <select id="pageSizeSelect"
                    class="border border-slate-200 rounded-lg px-2 py-1 text-sm text-slate-700 bg-white cursor-pointer outline-none focus:border-indigo-400 font-medium">
                <option value="10">10</option>
                <option value="25" selected>25</option>
                <option value="50">50</option>
                <option value="100">100</option>
            </select>
            <span>éléments</span>
        </div>
        <div class="flex items-center gap-2 bg-white border border-slate-200 rounded-xl px-3 py-2 focus-within:border-indigo-400 focus-within:ring-2 focus-within:ring-indigo-100 transition-all">
            <i class="fas fa-search text-slate-400 text-xs"></i>
            <input id="tableSearch" type="text" placeholder="Rechercher…"
                   class="outline-none text-sm text-slate-700 placeholder-slate-300 w-44 bg-transparent">
        </div>
    </div>

    {# Table #}
    <div class="overflow-x-auto">
        <table class="w-full min-w-[850px]">
            <thead>
                <tr class="bg-slate-50 border-b border-slate-100">
                    <th class="px-5 py-3 text-left text-[0.7rem] font-semibold uppercase tracking-widest text-slate-400">N°</th>
                    <th class="px-5 py-3 text-left text-[0.7rem] font-semibold uppercase tracking-widest text-slate-400">N° Candidature</th>
                    {% if is_admin %}<th class="px-5 py-3 text-left text-[0.7rem] font-semibold uppercase tracking-widest text-slate-400">Candidat</th>{% endif %}
                    <th class="px-5 py-3 text-left text-[0.7rem] font-semibold uppercase tracking-widest text-slate-400">Métier</th>
                    <th class="px-5 py-3 text-left text-[0.7rem] font-semibold uppercase tracking-widest text-slate-400">Établissement</th>
                    {% if is_admin %}<th class="px-5 py-3 text-left text-[0.7rem] font-semibold uppercase tracking-widest text-slate-400">Jury</th>{% endif %}
                    <th class="px-5 py-3 text-left text-[0.7rem] font-semibold uppercase tracking-widest text-slate-400">Statut</th>
                    <th class="px-5 py-3 text-left text-[0.7rem] font-semibold uppercase tracking-widest text-slate-400">Date</th>
                    <th class="px-5 py-3 text-right text-[0.7rem] font-semibold uppercase tracking-widest text-slate-400">Actions</th>
                </tr>
            </thead>
            <tbody id="tableBody" class="divide-y divide-slate-50">
                {% for candidature in candidatures %}
                <tr class="hover:bg-slate-50/70 transition-colors duration-100">
                    <td class="px-5 py-4 text-sm text-slate-400 font-medium">{{ loop.index }}</td>
                    <td class="px-5 py-4">
                        <a href="{{ path('app_candidature_edit', {'id': candidature.id}) }}"
                           class="font-mono text-xs bg-indigo-50 text-indigo-600 border border-indigo-100 px-2.5 py-1 rounded-lg hover:bg-indigo-600 hover:text-white hover:border-indigo-600 transition-all duration-150 inline-block font-medium">
                            {{ candidature.numero }}
                        </a>
                    </td>

                    {% if is_admin %}
                    <td class="px-5 py-4">
                        {% set fullName = candidature.user ? ((candidature.user.nom|default('') ~ ' ' ~ candidature.user.prenoms|default(''))|trim) : '' %}
                        <div class="text-sm font-semibold text-slate-800">{{ fullName ?: 'Utilisateur indisponible' }}</div>
                        <div class="text-xs text-slate-400 mt-0.5">{{ candidature.user ? (candidature.user.contact|default('-')) : '-' }}</div>
                    </td>
                    {% endif %}

                    <td class="px-5 py-4 text-sm font-medium text-slate-700">{{ candidature.metier ? candidature.metier.nom : '-' }}</td>
                    <td class="px-5 py-4 text-sm text-slate-500">{{ candidature.etablissement ? candidature.etablissement.nom : '-' }}</td>

                    {% if is_admin %}
                    <td class="px-5 py-4 text-sm text-slate-400">{{ candidature.jury ?: '–' }}</td>
                    {% endif %}

                    <td class="px-2 py-4">
                        {% if candidature.resultat == 2 %}
                            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[0.6rem] font-semibold bg-green-50 text-green-700 border border-green-200 hover:bg-green-500 hover:text-white transition-all duration-150">
                                <span class="w-1.5 h-1.5 rounded-full bg-green-500 shrink-0"></span>Admis
                            </span>
                        {% elseif candidature.entstatut == 2 %}
                            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[0.6rem] font-semibold bg-blue-50 text-blue-700 border border-blue-200 hover:bg-blue-500 hover:text-white transition-all duration-150">
                                <span class="w-1.5 h-1.5 rounded-full bg-blue-500 shrink-0"></span>Admissible
                            </span>
                        {% elseif candidature.etustatut == 2 %}
                            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[0.6rem] font-semibold bg-amber-50 text-amber-700 border border-amber-200 hover:bg-amber-500 hover:text-white transition-all duration-150">
                                <span class="w-1.5 h-1.5 rounded-full bg-amber-500 shrink-0"></span>Dossier OK
                            </span>
                        {% elseif candidature.etustatut == 1 %}
                            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[0.6rem] font-semibold bg-red-50 text-red-700 border border-red-200 hover:bg-red-500 hover:text-white transition-all duration-150">
                                <span class="w-1.5 h-1.5 rounded-full bg-red-500 shrink-0"></span>Rejeté
                            </span>
                        {% else %}
                            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[0.6rem] font-semibold bg-slate-100 text-slate-500 border border-slate-200 hover:bg-slate-500 hover:text-white transition-all duration-150">
                                <span class="w-1.5 h-1.5 rounded-full bg-slate-400 shrink-0"></span>En attente
                            </span>
                        {% endif %}
                    </td>

                    <td class="px-5 py-4 text-xs text-slate-400">{{ candidature.creation|date('d/m/Y') }}</td>

                    <td class="px-5 py-4">
                        <div class="flex items-center justify-end gap-1.5">
                            <a href="{{ path('app_candidature_edit', {'id': candidature.id}) }}"
                               title="Modifier"
                               class="w-8 h-8 flex items-center justify-center rounded-lg bg-amber-50 text-amber-600 hover:bg-amber-500 hover:text-white transition-all duration-150 hover:-translate-y-px text-sm">
                                <i class="fas fa-pen"></i>
                            </a>
                            <a href="{{ path('app_candidature_print', {'type': 'fiche', 'numero': candidature.numero}) }}"
                               target="_blank" title="Imprimer la fiche"
                               class="w-8 h-8 flex items-center justify-center rounded-lg bg-emerald-50 text-emerald-600 hover:bg-emerald-500 hover:text-white transition-all duration-150 hover:-translate-y-px text-sm">
                                <i class="fas fa-print"></i>
                            </a>
                            {% if candidature.entstatut == 2 %}
                            <a href="{{ path('app_candidature_print', {'type': 'convocation', 'numero': candidature.numero}) }}"
                               target="_blank" title="Imprimer la convocation"
                               class="w-8 h-8 flex items-center justify-center rounded-lg bg-purple-50 text-purple-600 hover:bg-purple-500 hover:text-white transition-all duration-150 hover:-translate-y-px text-sm">
                                <i class="fas fa-envelope-open-text"></i>
                            </a>
                            {% endif %}

                            {# Bouton supprimer — ROLE_ADMIN ou ROLE_ENT uniquement #}
                            {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_ENT') %}
                            <form method="post"
                                  action="{{ path('app_candidature_delete', {'id': candidature.id}) }}"
                                  onsubmit="return confirm('Supprimer la candidature {{ candidature.numero }} ? Cette action est irréversible.');"
                                  class="inline">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ candidature.id) }}">
                                <button type="submit" title="Supprimer"
                                        class="w-8 h-8 flex items-center justify-center rounded-lg bg-red-50 text-red-500 hover:bg-red-500 hover:text-white transition-all duration-150 hover:-translate-y-px text-sm">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </form>
                            {% endif %}
                        </div>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    {# Pagination #}
    <div class="flex flex-wrap items-center justify-between gap-3 px-6 py-4 border-t border-slate-100 bg-slate-50/60">
        <p id="paginationInfo" class="text-xs text-slate-400 font-medium"></p>
        <nav id="paginationNav" class="flex items-center gap-1" aria-label="Pagination"></nav>
    </div>
</div>

{% else %}
{# ===== ÉTAT VIDE ===== #}
<div class="bg-white rounded-2xl shadow-sm border border-slate-200 py-16 px-8 text-center">
    <div class="w-16 h-16 rounded-2xl bg-indigo-50 flex items-center justify-center mx-auto mb-5 text-3xl text-indigo-500">
        <i class="fas fa-{{ is_admin ? 'inbox' : 'file-alt' }}"></i>
    </div>
    <h3 class="text-lg font-bold text-slate-800 mb-2">Aucune candidature</h3>
    <p class="text-sm text-slate-500 mb-7">
        {% if is_admin %}Il n'y a pas encore de candidatures dans le système.
        {% else %}Vous n'avez pas encore soumis de candidature.{% endif %}
    </p>
    {% if not is_admin %}
    <a href="{{ path('app_candidature_new') }}"
       class="inline-flex items-center gap-2 px-6 py-2.5 bg-gradient-to-r from-indigo-600 to-purple-600 text-white text-sm font-semibold rounded-xl shadow-lg shadow-indigo-200 hover:shadow-indigo-300 hover:-translate-y-0.5 transition-all duration-200">
        <i class="fas fa-plus-circle"></i> Déposer ma première candidature
    </a>
    {% endif %}
</div>
{% endif %}

{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
(function () {
    const tbody = document.getElementById('tableBody');
    if (!tbody) return;

    const allRows        = Array.from(tbody.querySelectorAll('tr'));
    const info           = document.getElementById('paginationInfo');
    const nav            = document.getElementById('paginationNav');
    const searchInput    = document.getElementById('tableSearch');
    const pageSizeSelect = document.getElementById('pageSizeSelect');

    let pageSize    = parseInt(pageSizeSelect.value);
    let currentPage = 1;
    let filtered    = [...allRows];

    function applyFilter(q) {
        const term = q.toLowerCase().trim();
        filtered = allRows.filter(r => !term || r.textContent.toLowerCase().includes(term));
        currentPage = 1;
        render();
    }

    function render() {
        const total = filtered.length;
        const pages = Math.max(1, Math.ceil(total / pageSize));
        currentPage = Math.min(currentPage, pages);

        const start = (currentPage - 1) * pageSize;
        const end   = Math.min(start + pageSize, total);

        allRows.forEach(r => r.style.display = 'none');
        filtered.slice(start, end).forEach(r => r.style.display = '');

        info.innerHTML = total === 0
            ? 'Aucun résultat trouvé'
            : `Affichage de <strong class="text-slate-600">${start + 1}</strong> à <strong class="text-slate-600">${end}</strong> sur <strong class="text-slate-600">${total}</strong> élément(s)`;

        buildPagination(pages);
    }

    function buildPagination(pages) {
        nav.innerHTML = '';
        const base     = 'inline-flex items-center justify-center min-w-[34px] h-[34px] px-2 rounded-lg text-xs font-semibold border transition-colors duration-150 ';
        const idle     = base + 'bg-white border-slate-200 text-slate-500 hover:bg-indigo-50 hover:text-indigo-600 hover:border-indigo-200 cursor-pointer';
        const active   = base + 'bg-indigo-600 border-indigo-600 text-white cursor-default pointer-events-none';
        const disabled = base + 'bg-white border-slate-100 text-slate-300 cursor-not-allowed pointer-events-none opacity-40';

        const makeBtn = (label, page, cls) => {
            const el = document.createElement('button');
            el.innerHTML = label; el.className = cls;
            if (cls === idle) el.addEventListener('click', () => { currentPage = page; render(); });
            return el;
        };

        nav.appendChild(makeBtn('<i class="fas fa-chevron-left" style="font-size:0.6rem"></i>', currentPage - 1, currentPage === 1 ? disabled : idle));
        getPageRange(currentPage, pages).forEach(p => {
            if (p === '...') {
                const el = document.createElement('span');
                el.textContent = '···';
                el.className = 'inline-flex items-center justify-center w-8 h-[34px] text-xs text-slate-300 font-bold tracking-wider select-none';
                nav.appendChild(el);
            } else {
                nav.appendChild(makeBtn(p, p, p === currentPage ? active : idle));
            }
        });
        nav.appendChild(makeBtn('<i class="fas fa-chevron-right" style="font-size:0.6rem"></i>', currentPage + 1, currentPage === pages ? disabled : idle));
    }

    function getPageRange(cur, total) {
        if (total <= 7) return Array.from({ length: total }, (_, i) => i + 1);
        const set    = new Set([1, total, cur, cur - 1, cur + 1].filter(p => p >= 1 && p <= total));
        const sorted = [...set].sort((a, b) => a - b);
        const result = [];
        sorted.forEach((p, i) => { if (i > 0 && p - sorted[i - 1] > 1) result.push('...'); result.push(p); });
        return result;
    }

    searchInput.addEventListener('input', e => applyFilter(e.target.value));
    pageSizeSelect.addEventListener('change', e => { pageSize = parseInt(e.target.value); currentPage = 1; render(); });
    render();
})();
</script>
{% endblock %}
