{% extends 'base.html.twig' %}

{% block title %}Candidature soumise avec succès | DAIP{% endblock %}

{% block body %}
<div class="min-h-screen bg-gray-50 py-12">
    <div class="max-w-3xl mx-auto px-4">
        <!-- Message de succès -->
        <div class="bg-white rounded-2xl shadow-xl border border-slate-200 overflow-hidden mb-6">
            <div class="bg-gradient-to-r from-green-500 to-emerald-600 px-6 py-8 text-center">
                <div class="w-20 h-20 bg-white/20 rounded-full flex items-center justify-center mx-auto mb-4">
                    <i class="fas fa-check-circle text-white text-4xl"></i>
                </div>
                <h1 class="text-3xl font-bold text-white mb-2">Félicitations !</h1>
                <p class="text-white/90 text-lg">Votre candidature a été enregistrée avec succès</p>
            </div>
            
            <div class="p-8">
                <!-- Numéro de candidature -->
                <div class="text-center mb-8">
                    <p class="text-sm text-slate-500 mb-2">Votre numéro d'inscription</p>
                    <div class="inline-block bg-indigo-50 px-6 py-3 rounded-lg border border-indigo-200">
                        <span class="text-2xl font-mono font-bold text-indigo-700">{{ candidature.numero }}</span>
                    </div>
                    <p class="text-xs text-slate-500 mt-2">Conservez précieusement ce numéro</p>
                </div>
                
                <!-- Actions -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-8">
                    <a href="{{ path('app_candidature_print', {'type': 'fiche', 'numero': candidature.numero, 'nom': candidature.user.nom}) }}" 
                       target="_blank"
                       class="flex items-center justify-center gap-3 p-4 bg-indigo-50 rounded-xl border border-indigo-200 hover:bg-indigo-100 transition group">
                        <div class="w-10 h-10 bg-indigo-100 rounded-full flex items-center justify-center group-hover:bg-indigo-200">
                            <i class="fas fa-file-pdf text-indigo-600"></i>
                        </div>
                        <div class="text-left">
                            <p class="font-semibold text-indigo-700">Télécharger ma fiche</p>
                            <p class="text-xs text-indigo-500">Fiche d'inscription PDF</p>
                        </div>
                    </a>
                    
                    <a href="{{ path('app_candidature_index') }}" 
                       class="flex items-center justify-center gap-3 p-4 bg-slate-50 rounded-xl border border-slate-200 hover:bg-slate-100 transition group">
                        <div class="w-10 h-10 bg-slate-100 rounded-full flex items-center justify-center group-hover:bg-slate-200">
                            <i class="fas fa-list text-slate-600"></i>
                        </div>
                        <div class="text-left">
                            <p class="font-semibold text-slate-700">Mes candidatures</p>
                            <p class="text-xs text-slate-500">Voir toutes mes candidatures</p>
                        </div>
                    </a>
                </div>
                
                <!-- Informations supplémentaires -->
                <div class="bg-amber-50 rounded-xl p-5 border border-amber-200 mb-6">
                    <div class="flex items-start gap-3">
                        <i class="fas fa-info-circle text-amber-600 mt-1"></i>
                        <div>
                            <p class="text-sm font-medium text-amber-800 mb-1">Prochaines étapes</p>
                            <ul class="text-xs text-amber-700 space-y-1 list-disc list-inside">
                                <li>Votre dossier sera examiné par nos équipes</li>
                                <li>Vous serez informé(e) de la date de votre entretien</li>
                                <li>Préparez les documents originaux pour l'entretien</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- QR Code (optionnel) -->
        <div class="bg-white rounded-xl shadow-lg border border-slate-200 p-4 max-w-xs mx-auto text-center">
            <img src="https://api.qrserver.com/v1/create-qr-code/?size=100x100&data={{ candidature.numero }}" 
                 alt="QR Code" 
                 class="w-24 h-24 mx-auto mb-2">
            <p class="text-xs text-slate-500">Scannez pour accéder à votre fiche</p>
        </div>
    </div>
</div>
{% endblock %}