{% extends 'base.html.twig' %}

{% block title %}Statistiques détaillées | {{ parent() }}{% endblock %}

{% block stylesheets %}
{{ parent() }}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/chart.js@3.9.1/dist/chart.min.css">
<style>
    .stat-card {
        transition: all 0.3s ease;
    }
    .stat-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
    }
    .chart-container {
        position: relative;
        height: 250px;
        width: 100%;
    }
</style>
{% endblock %}

{% block body %}
<div class="mx-auto px-4 pb-16">
        <div class="bg-gradient-to-r from-indigo-600 to-purple-600 rounded-2xl p-8 mb-8 text-white">
            <form method="get" action="{{ path('app_candidature_stat') }}" class="flex flex-wrap gap-4 items-end">
                <div class="flex-1 min-w-[200px]">
                    <label class="block text-sm font-medium text-white/80 mb-1">Établissement</label>
                    <select name="etablissement" id="etablissement-filter" class="w-full px-4 py-2 rounded-lg bg-white/20 border border-white/30 text-white focus:outline-none focus:ring-2 focus:ring-white">
                        <option value="" class="text-slate-900">Tous les établissements</option>
                        {% for etab in etablissements %}
                            <option value="{{ etab.id }}" class="text-slate-900" 
                                {{ etablissement_selectionne and etablissement_selectionne.id == etab.id ? 'selected' : '' }}>
                                {{ etab.nom }}
                            </option>
                        {% endfor %}
                    </select>
                </div>
                
                <div class="flex-1 min-w-[200px]">
                    <label class="block text-sm font-medium text-white/80 mb-1">Métier</label>
                    <select name="metier" id="metier-filter" class="w-full px-4 py-2 rounded-lg bg-white/20 border border-white/30 text-white focus:outline-none focus:ring-2 focus:ring-white" {{ not etablissement_selectionne ? 'disabled' }}>
                        <option value="" class="text-slate-900">Tous les métiers</option>
                        {% for m in metiers %}
                            <option value="{{ m.id }}" class="text-slate-900" 
                                {{ metier_selectionne and metier_selectionne.id == m.id ? 'selected' : '' }}>
                                {{ m.nom }}
                            </option>
                        {% endfor %}
                    </select>
                </div>
                
                <div class="flex gap-2">
                    <button type="submit" class="px-6 py-2 bg-white text-indigo-600 rounded-lg hover:bg-indigo-50 transition font-medium">
                        <i class="fas fa-filter mr-2"></i>Filtrer
                    </button>
                    
                    <a href="{{ path('app_candidature_stat', {'export': 'true', 'etablissement': etablissement_selectionne.id|default, 'metier': metier_selectionne.id|default}) }}" 
                       class="px-6 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 transition font-medium inline-flex items-center">
                        <i class="fas fa-file-excel mr-2"></i>Exporter
                    </a>
                    
                    <a href="{{ path('app_candidature_stat') }}" class="px-6 py-2 bg-slate-600 text-white rounded-lg hover:bg-slate-700 transition font-medium inline-flex items-center">
                        <i class="fas fa-undo mr-2"></i>Réinitialiser
                    </a>
                </div>
            </form>
        </div>

    <!-- Cartes de résumé -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-4 mb-8">
        <div class="bg-white rounded-xl shadow-lg p-6 border-l-4 border-indigo-500 stat-card">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm text-slate-500 mb-1">Total candidatures</p>
                    <p class="text-3xl font-bold text-indigo-600">{{ totals.total }}</p>
                </div>
                <div class="w-12 h-12 bg-indigo-100 rounded-full flex items-center justify-center">
                    <i class="fas fa-users text-indigo-600 text-xl"></i>
                </div>
            </div>
        </div>
        
        <div class="bg-white rounded-xl shadow-lg p-6 border-l-4 border-green-500 stat-card">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm text-slate-500 mb-1">Éligibles</p>
                    <p class="text-3xl font-bold text-green-600">{{ totals.eligible }}</p>
                    <p class="text-xs text-slate-400">{{ totals.total > 0 ? ((totals.eligible / totals.total) * 100)|number_format(1) : 0 }}%</p>
                </div>
                <div class="w-12 h-12 bg-green-100 rounded-full flex items-center justify-center">
                    <i class="fas fa-check-circle text-green-600 text-xl"></i>
                </div>
            </div>
        </div>
        
        <div class="bg-white rounded-xl shadow-lg p-6 border-l-4 border-blue-500 stat-card">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm text-slate-500 mb-1">Évalués</p>
                    <p class="text-3xl font-bold text-blue-600">{{ totals.evalue }}</p>
                    <p class="text-xs text-slate-400">{{ totals.total > 0 ? ((totals.evalue / totals.total) * 100)|number_format(1) : 0 }}%</p>
                </div>
                <div class="w-12 h-12 bg-blue-100 rounded-full flex items-center justify-center">
                    <i class="fas fa-clipboard-check text-blue-600 text-xl"></i>
                </div>
            </div>
        </div>
        
        <div class="bg-white rounded-xl shadow-lg p-6 border-l-4 border-yellow-500 stat-card">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm text-slate-500 mb-1">Admissibles</p>
                    <p class="text-3xl font-bold text-yellow-600">{{ totals.admissible }}</p>
                    <p class="text-xs text-slate-400">{{ totals.total > 0 ? ((totals.admissible / totals.total) * 100)|number_format(1) : 0 }}%</p>
                </div>
                <div class="w-12 h-12 bg-yellow-100 rounded-full flex items-center justify-center">
                    <i class="fas fa-star text-yellow-600 text-xl"></i>
                </div>
            </div>
        </div>
        
        <div class="bg-white rounded-xl shadow-lg p-6 border-l-4 border-purple-500 stat-card">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm text-slate-500 mb-1">Admis</p>
                    <p class="text-3xl font-bold text-purple-600">{{ totals.admis }}</p>
                    <p class="text-xs text-slate-400">{{ totals.total > 0 ? ((totals.admis / totals.total) * 100)|number_format(1) : 0 }}%</p>
                </div>
                <div class="w-12 h-12 bg-purple-100 rounded-full flex items-center justify-center">
                    <i class="fas fa-graduation-cap text-purple-600 text-xl"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Cartes Prospection -->
    {% if prospection_totals is defined %}
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-8">
        <div class="bg-white rounded-xl shadow-lg p-6 border-l-4 border-teal-500 stat-card">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm text-slate-500 mb-1">Entreprises prospectées</p>
                    <p class="text-3xl font-bold text-teal-600">{{ prospection_totals.nb_entreprises }}</p>
                </div>
                <div class="w-12 h-12 bg-teal-100 rounded-full flex items-center justify-center">
                    <i class="fas fa-building text-teal-600 text-xl"></i>
                </div>
            </div>
        </div>
        <div class="bg-white rounded-xl shadow-lg p-6 border-l-4 border-orange-500 stat-card">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm text-slate-500 mb-1">Postes d'apprentissage trouvés</p>
                    <p class="text-3xl font-bold text-orange-600">{{ prospection_totals.total_postes }}</p>
                </div>
                <div class="w-12 h-12 bg-orange-100 rounded-full flex items-center justify-center">
                    <i class="fas fa-briefcase text-orange-600 text-xl"></i>
                </div>
            </div>
        </div>
    </div>
    {% endif %}

    <!-- Graphiques circulaires -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
        <!-- Répartition par sexe -->
        <div class="bg-white rounded-2xl shadow-xl p-6">
            <h3 class="text-lg font-semibold text-slate-800 mb-4 flex items-center">
                <div class="w-8 h-8 bg-indigo-100 rounded-lg flex items-center justify-center mr-3">
                    <i class="fas fa-venus-mars text-indigo-600"></i>
                </div>
                Répartition par sexe
            </h3>
            <div class="chart-container">
                <canvas id="genderChart"></canvas>
            </div>
            <div class="flex justify-center gap-6 mt-4">
                <div class="flex items-center">
                    <span class="w-3 h-3 bg-blue-500 rounded-full mr-2"></span>
                    <span class="text-sm">Hommes: {{ totals.hommes }}</span>
                </div>
                <div class="flex items-center">
                    <span class="w-3 h-3 bg-pink-500 rounded-full mr-2"></span>
                    <span class="text-sm">Femmes: {{ totals.femmes }}</span>
                </div>
            </div>
        </div>

        <!-- Statut des dossiers -->
        <div class="bg-white rounded-2xl shadow-xl p-6">
            <h3 class="text-lg font-semibold text-slate-800 mb-4 flex items-center">
                <div class="w-8 h-8 bg-green-100 rounded-lg flex items-center justify-center mr-3">
                    <i class="fas fa-file-alt text-green-600"></i>
                </div>
                Statut des dossiers
            </h3>
            <div class="chart-container">
                <canvas id="dossierChart"></canvas>
            </div>
            <div class="flex flex-wrap justify-center gap-4 mt-4">
                <div class="flex items-center">
                    <span class="w-3 h-3 bg-green-500 rounded-full mr-2"></span>
                    <span class="text-sm">Éligible: {{ totals.eligible }}</span>
                </div>
                <div class="flex items-center">
                    <span class="w-3 h-3 bg-red-500 rounded-full mr-2"></span>
                    <span class="text-sm">Non éligible: {{ totals.non_eligible }}</span>
                </div>
            </div>
        </div>

        <!-- État d'évaluation -->
        <div class="bg-white rounded-2xl shadow-xl p-6">
            <h3 class="text-lg font-semibold text-slate-800 mb-4 flex items-center">
                <div class="w-8 h-8 bg-blue-100 rounded-lg flex items-center justify-center mr-3">
                    <i class="fas fa-clipboard-list text-blue-600"></i>
                </div>
                État d'évaluation
            </h3>
            <div class="chart-container">
                <canvas id="evaluationChart"></canvas>
            </div>
            <div class="flex flex-wrap justify-center gap-4 mt-4">
                <div class="flex items-center">
                    <span class="w-3 h-3 bg-blue-500 rounded-full mr-2"></span>
                    <span class="text-sm">Évalué: {{ totals.evalue }}</span>
                </div>
                <div class="flex items-center">
                    <span class="w-3 h-3 bg-amber-500 rounded-full mr-2"></span>
                    <span class="text-sm">Non évalué: {{ totals.non_evalue }}</span>
                </div>
            </div>
        </div>

        <!-- Progression vers l'admission -->
        <div class="bg-white rounded-2xl shadow-xl p-6">
            <h3 class="text-lg font-semibold text-slate-800 mb-4 flex items-center">
                <div class="w-8 h-8 bg-purple-100 rounded-lg flex items-center justify-center mr-3">
                    <i class="fas fa-chart-line text-purple-600"></i>
                </div>
                Progression vers l'admission
            </h3>
            <div class="chart-container">
                <canvas id="admissionChart"></canvas>
            </div>
            <div class="flex flex-wrap justify-center gap-4 mt-4">
                <div class="flex items-center">
                    <span class="w-3 h-3 bg-green-500 rounded-full mr-2"></span>
                    <span class="text-sm">Admis: {{ totals.admis }}</span>
                </div>
                <div class="flex items-center">
                    <span class="w-3 h-3 bg-yellow-500 rounded-full mr-2"></span>
                    <span class="text-sm">Admissible: {{ totals.admissible }}</span>
                </div>
                <div class="flex items-center">
                    <span class="w-3 h-3 bg-red-500 rounded-full mr-2"></span>
                    <span class="text-sm">Autres: {{ totals.total - totals.admissible }}</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Tableau détaillé -->
    <div class="bg-white rounded-2xl shadow-xl border border-slate-200 overflow-hidden">
        <div class="px-6 py-4 bg-slate-50 border-b border-slate-200 flex justify-between items-center">
            <h3 class="text-lg font-semibold text-slate-800">
                <i class="fas fa-list mr-2 text-indigo-600"></i>
                Détail par établissement et métier
            </h3>
            <span class="text-sm text-slate-500">{{ stats|length }} ligne(s)</span>
        </div>
        
        <div class="overflow-x-auto">
            <table class="w-full">
                <thead class="bg-slate-50 border-b border-slate-200">
                    <tr>
                        <th class="px-4 py-3 text-left text-xs font-semibold text-slate-600 uppercase">Établissement</th>
                        <th class="px-4 py-3 text-left text-xs font-semibold text-slate-600 uppercase">Métier</th>
                        <th class="px-4 py-3 text-center text-xs font-semibold text-slate-600 uppercase">Total</th>
                        <th class="px-4 py-3 text-center text-xs font-semibold text-slate-600 uppercase">H</th>
                        <th class="px-4 py-3 text-center text-xs font-semibold text-slate-600 uppercase">F</th>
                        <th class="px-4 py-3 text-center text-xs font-semibold text-slate-600 uppercase">Éligible</th>
                        <th class="px-4 py-3 text-center text-xs font-semibold text-slate-600 uppercase">Évalué</th>
                        <th class="px-4 py-3 text-center text-xs font-semibold text-slate-600 uppercase">Admissible</th>
                        <th class="px-4 py-3 text-center text-xs font-semibold text-slate-600 uppercase">Admis</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-200">
                    {% for stat in stats %}
                    <tr class="hover:bg-slate-50 transition">
                        <td class="px-4 py-3 text-sm font-medium text-slate-800">{{ stat.etablissement_nom }}</td>
                        <td class="px-4 py-3 text-sm text-slate-600">{{ stat.metier_nom }}</td>
                        <td class="px-4 py-3 text-sm text-center font-semibold text-indigo-600">{{ stat.total }}</td>
                        <td class="px-4 py-3 text-sm text-center text-slate-600">{{ stat.hommes }}</td>
                        <td class="px-4 py-3 text-sm text-center text-slate-600">{{ stat.femmes }}</td>
                        <td class="px-4 py-3 text-sm text-center {% if stat.eligible > 0 %}text-green-600 font-semibold{% else %}text-slate-600{% endif %}">
                            {{ stat.eligible }}
                        </td>
                        <td class="px-4 py-3 text-sm text-center {% if stat.evalue > 0 %}text-blue-600 font-semibold{% else %}text-slate-600{% endif %}">
                            {{ stat.evalue }}
                        </td>
                        <td class="px-4 py-3 text-sm text-center {% if stat.admissible > 0 %}text-yellow-600 font-semibold{% else %}text-slate-600{% endif %}">
                            {{ stat.admissible }}
                        </td>
                        <td class="px-4 py-3 text-sm text-center {% if stat.admis > 0 %}text-purple-600 font-semibold{% else %}text-slate-600{% endif %}">
                            {{ stat.admis }}
                        </td>
                    </tr>
                    {% else %}
                    <tr>
                        <td colspan="9" class="px-4 py-8 text-center text-slate-500">
                            <i class="fas fa-chart-bar text-4xl mb-3 opacity-50"></i>
                            <p>Aucune donnée disponible</p>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script src="https://cdn.jsdelivr.net/npm/chart.js@3.9.1/dist/chart.min.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function() {
    // Données pour les graphiques
    const totals = {{ totals|json_encode|raw }};
    
    // Graphique 1: Répartition par sexe
    new Chart(document.getElementById('genderChart'), {
        type: 'pie',
        data: {
            labels: ['Hommes', 'Femmes'],
            datasets: [{
                data: [totals.hommes, totals.femmes],
                backgroundColor: ['#3b82f6', '#ec4899'],
                borderWidth: 0
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: { display: false }
            }
        }
    });
    
    // Graphique 2: Statut des dossiers (Éligible vs Non éligible)
    new Chart(document.getElementById('dossierChart'), {
        type: 'doughnut',
        data: {
            labels: ['Éligible', 'Non éligible'],
            datasets: [{
                data: [totals.eligible, totals.non_eligible],
                backgroundColor: ['#10b981', '#ef4444'],
                borderWidth: 0
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: { display: false }
            },
            cutout: '60%'
        }
    });
    
    // Graphique 3: État d'évaluation
    new Chart(document.getElementById('evaluationChart'), {
        type: 'doughnut',
        data: {
            labels: ['Évalué', 'Non évalué'],
            datasets: [{
                data: [totals.evalue, totals.non_evalue],
                backgroundColor: ['#3b82f6', '#f59e0b'],
                borderWidth: 0
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: { display: false }
            },
            cutout: '60%'
        }
    });
    
    // Graphique 4: Progression vers l'admission
    new Chart(document.getElementById('admissionChart'), {
        type: 'doughnut',
        data: {
            labels: ['Admis', 'Admissible', 'Autres'],
            datasets: [{
                data: [totals.admis, totals.admissible, totals.total - totals.admissible],
                backgroundColor: ['#096B96', '#f59e0b', '#94a3b8'],
                borderWidth: 0
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: { display: false }
            },
            cutout: '60%'
        }
    });
    
    // Gestion du filtre métier dynamique
    const etablissementFilter = document.getElementById('etablissement-filter');
    const metierFilter = document.getElementById('metier-filter');
    
    if (etablissementFilter) {
        etablissementFilter.addEventListener('change', function() {
            const etablissementId = this.value;
            
            if (etablissementId) {
                // Activer et charger les métiers
                metierFilter.disabled = false;
                
                fetch(`/candidature/stat/etablissement/${etablissementId}/metiers`)
                    .then(response => response.json())
                    .then(metiers => {
                        metierFilter.innerHTML = '<option value="">Tous les métiers</option>';
                        metiers.forEach(m => {
                            metierFilter.innerHTML += `<option value="${m.id}">${m.nom}</option>`;
                        });
                    });
            } else {
                // Désactiver et vider
                metierFilter.disabled = true;
                metierFilter.innerHTML = '<option value="">Tous les métiers</option>';
            }
        });
    }
});
</script>
{% endblock %}