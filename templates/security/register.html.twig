{% extends 'public/base.html.twig' %}

{% block title %}Préinscription candidat | DAIP - Direction de l'Apprentissage et de l'Insertion Professionnelle{% endblock %}

{% block meta %}
{{ parent() }}
<meta name="description" content="Créez votre compte candidat pour postuler aux formations professionnelles de la DAIP et intégrer l'École de la Deuxième Chance">
{% endblock %}

{# Définition de la classe CSS réutilisable #}
{% set input_class = 'min-h-[44px] w-full rounded-lg border border-slate-500 bg-white px-3 py-2.5 text-sm text-slate-900 caret-indigo-600 placeholder:text-slate-500 transition duration-150 motion-reduce:transition-none focus:border-indigo-600 focus:outline-none focus:ring-2 focus:ring-indigo-600' %}

{% block body %}
{% import _self as page %}
{% import 'partials/_ui.html.twig' as ui %}


{# L'en-tête public fixe est déjà compensée par le correcteur de hauteur de
   public/base.html.twig (72 px) : inutile d'ajouter un padding-top ici, ce
   qui repoussait le formulaire vers le haut plutôt que de le centrer. #}
<div class="min-h-screen bg-slate-50 flex flex-col items-center justify-center py-10">
<!-- ==================== MESSAGES ==================== -->
<div class="container mx-auto px-4 mb-6 max-w-4xl">
    {% include 'partials/_flash_messages.html.twig' %}
</div>

<!-- ==================== FORMULAIRE DE PRÉINSCRIPTION (WIZARD) ==================== -->
<div class="container mx-auto px-4">
    <div class="max-w-4xl mx-auto">
        <!-- Barre de progression -->
        <div class="mb-8">
            <div class="flex items-center justify-between mb-4">
                <div class="flex items-center">
                    <span class="text-sm font-semibold text-indigo-600" id="step-indicator">Étape 1/4</span>
                    <span class="text-sm text-slate-500 ml-2" id="step-name">Identité</span>
                </div>
                <span class="text-sm text-slate-500" id="progress-percent">25%</span>
            </div>
            <div class="w-full bg-slate-200 rounded-full h-2.5">
                <div class="bg-indigo-600 h-2.5 rounded-full transition-all duration-300" id="progress-bar" style="width: 25%"></div>
            </div>
        </div>

        {# Pas d'overflow-hidden : la liste des nationalités doit pouvoir dépasser
           de la carte ; le bandeau arrondit lui-même ses coins. #}
        <div class="bg-white rounded-lg border border-slate-200">
            <div class="relative rounded-t-lg bg-gradient-to-br from-primary-900 to-secondary-800 px-6 py-4">
                <h1 class="flex items-center text-xl font-semibold text-white">
                    Préinscription - Validation Des Acquis De L'Expérience (VAE)
                </h1>
                <div class="absolute inset-x-0 bottom-0 h-1 bg-[#ED8F33]" aria-hidden="true"></div>
            </div>
        
            <div class="p-8">
                {{ form_start(form, {'attr': {'class': 'space-y-6', 'novalidate': 'novalidate', 'id': 'register-form'}}) }}

                {# Erreurs globales du formulaire (jeton de sécurité expiré…). #}
                {% if form.vars.errors|length > 0 %}
                    <div class="rounded-lg border border-red-200 bg-red-50 p-4 text-sm text-red-800">{{ form_errors(form) }}</div>
                {% endif %}

                <!-- Champ caché pour la redirection -->
                {% if redirect is defined and redirect %}
                    <input type="hidden" name="redirect" value="{{ redirect }}">
                {% endif %}

                <!-- ÉTAPE 1 : Identité -->
                <div class="step" id="step1">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <!-- Nom -->
                        <div class="md:col-span-1">
                            <label class="block text-sm font-medium text-slate-700 mb-1">
                                Nom
                            </label>
                            {{ form_widget(form.nom, {
                                'attr': {
                                    'class': input_class ~ ' text-uppercase',
                                    'placeholder': 'Votre nom'
                                }
                            }) }}
                            {{ form_errors(form.nom) }}
                        </div>
                        
                        <!-- Prénoms -->
                        <div class="md:col-span-1">
                            <label class="block text-sm font-medium text-slate-700 mb-1">
                                Prénoms
                            </label>
                            {{ form_widget(form.prenoms, {
                                'attr': {
                                    'class': input_class,
                                    'placeholder': 'Vos prénoms'
                                }
                            }) }}
                            {{ form_errors(form.prenoms) }}
                        </div>

                        <!-- Sexe -->
                        <div class="md:col-span-1">
                            <label class="block text-sm font-medium text-slate-700 mb-1">
                                Sexe
                            </label>
                            {{ form_widget(form.sexe, {
                                'attr': {
                                    'class': input_class
                                }
                            }) }}
                            {{ form_errors(form.sexe) }}
                        </div>
                        
                        <!-- Situation matrimoniale -->
                        <div class="md:col-span-1">
                            <label class="block text-sm font-medium text-slate-700 mb-1">
                                Situation matrimoniale
                            </label>
                            {{ form_widget(form.situationmat, {
                                'attr': {
                                    'class': input_class
                                }
                            }) }}
                            {{ form_errors(form.situationmat) }}
                        </div>
                    </div>
                </div>
        
                <!-- ÉTAPE 2 : Naissance, nationalité et parents -->
                <div class="step hidden" id="step2">
                    <!-- Naissance et nationalité -->
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
                        <!-- Date de naissance : saisie « jj/mm/aaaa », barres posées pendant
                             la frappe ; le calendrier du téléphone reste disponible à droite. -->
                        {% set date_erreur = form.datenaissance.vars.errors|length > 0 %}
                        <div class="md:col-span-1">
                            <label for="{{ form.datenaissance.vars.id }}" class="block text-sm font-medium text-slate-700 mb-1">
                                Date de naissance
                            </label>
                            <div data-date-boite class="flex min-h-[44px] rounded-lg border bg-white transition duration-150 motion-reduce:transition-none focus-within:ring-2 {{ date_erreur ? 'border-red-600 focus-within:border-red-600 focus-within:ring-red-600' : 'border-slate-500 focus-within:border-indigo-600 focus-within:ring-indigo-600' }}">
                                {{ form_widget(form.datenaissance, {
                                    'attr': {
                                        'class': 'min-h-[44px] min-w-0 flex-1 rounded-l-lg border-0 bg-transparent px-3 py-2.5 text-base tabular-nums text-slate-900 caret-indigo-600 placeholder:text-slate-500 focus:outline-none focus:ring-0',
                                        'data-date-fr': '1',
                                        'data-sans-anneau': '1',
                                        'aria-describedby': form.datenaissance.vars.id ~ '-aide',
                                        'aria-invalid': date_erreur ? 'true' : 'false'
                                    }
                                }) }}
                                {# Le vrai sélecteur de date, invisible, recouvre le bouton :
                                   un toucher ouvre le calendrier natif du téléphone. #}
                                <span class="relative flex w-12 shrink-0 items-center justify-center rounded-r-[7px] border-l border-slate-300 bg-slate-50 text-slate-700 focus-within:bg-indigo-50 focus-within:text-indigo-700 hover:bg-slate-100">
                                    <i class="fas fa-calendar-days" aria-hidden="true"></i>
                                    <input type="date" data-calendrier max="{{ 'now'|date('Y-m-d') }}" min="1930-01-01"
                                           aria-label="Choisir la date dans le calendrier"
                                           class="absolute inset-0 h-full w-full cursor-pointer opacity-0" data-sans-anneau="1">
                                </span>
                            </div>
                            <p id="{{ form.datenaissance.vars.id }}-aide" class="mt-1 text-sm text-slate-600">Tapez les chiffres, les barres s'ajoutent seules. Ex. : 15/03/1985</p>
                            <p id="{{ form.datenaissance.vars.id }}-erreur" class="mt-1 hidden text-sm font-medium text-red-700" role="alert"></p>
                            {{ form_errors(form.datenaissance) }}
                        </div>
                        
                        <!-- Lieu de naissance -->
                        <div class="md:col-span-1">
                            <label class="block text-sm font-medium text-slate-700 mb-1">
                                Lieu de naissance
                            </label>
                            {{ form_widget(form.lieunaissance, {
                                'attr': {
                                    'class': input_class,
                                    'placeholder': 'Ville de naissance'
                                }
                            }) }}
                            {{ form_errors(form.lieunaissance) }}
                        </div>
                        
                        <!-- Nationalité : liste déroulante avec recherche intégrée, comme
                             e-justice.ci (Select2), écrite en Alpine + Tailwind. Sans JavaScript,
                             la liste native reste affichée. La condition (nationalité ivoirienne)
                             est vérifiée à la soumission. -->
                        {% set nationalite = form.nationalite %}
                        {% set nationalite_erreur = nationalite.vars.errors|length > 0 %}
                        <div class="md:col-span-1">
                            <label id="nationalite-libelle" for="{{ nationalite.vars.id }}" class="block text-sm font-medium text-slate-700 mb-1">Nationalité</label>
                            <div class="relative" x-data="listeDeroulante"
                                 @click.outside="fermer(false)" @keydown.escape="if (ouverte) { $event.preventDefault(); fermer(true); }"
                                 @focusout="quitter($event)">
                                {{ form_widget(nationalite, {
                                    'attr': {
                                        'class': input_class,
                                        'x-ref': 'natif',
                                        'aria-describedby': 'nationalite-aide',
                                        'aria-invalid': nationalite_erreur ? 'true' : 'false'
                                    }
                                }) }}
                                <button type="button" x-cloak x-ref="bouton" @click="ouverte ? fermer(true) : ouvrir()"
                                        @keydown.arrow-down.prevent="ouvrir()" @keydown.arrow-up.prevent="ouvrir()"
                                        aria-haspopup="listbox" :aria-expanded="ouverte ? 'true' : 'false'"
                                        aria-labelledby="nationalite-libelle nationalite-valeur" aria-describedby="nationalite-aide"
                                        aria-invalid="{{ nationalite_erreur ? 'true' : 'false' }}"
                                        class="flex min-h-[44px] w-full items-center gap-3 rounded-lg border bg-white px-3 text-left text-base text-slate-900 transition duration-150 motion-reduce:transition-none focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-600 {{ nationalite_erreur ? 'border-red-600' : 'border-slate-500' }}"
                                        :class="ouverte ? 'border-indigo-600 ring-2 ring-indigo-600' : ''">
                                    <span x-show="valeur === '{{ constant('App\\Entity\\User::NATIONALITE_IVOIRIENNE')|e('js') }}'" class="flex shrink-0">{{ include('partials/_drapeau_ci.html.twig') }}</span>
                                    <span id="nationalite-valeur" class="min-w-0 flex-1 truncate" :class="valeur ? '' : 'text-slate-500'">
                                        <span x-text="choisie ? choisie.principal : 'Sélectionnez votre nationalité'"></span>
                                        <span x-show="choisie && choisie.secondaire" class="text-slate-600" x-text="choisie ? '· ' + choisie.secondaire : ''"></span>
                                    </span>
                                    <i class="fas fa-chevron-down shrink-0 text-sm text-slate-600 transition-transform duration-200 motion-reduce:transition-none" :class="ouverte ? 'rotate-180' : ''" aria-hidden="true"></i>
                                </button>
                                {{ include('partials/_liste_deroulante.html.twig', {libelle_liste: 'Nationalités', libelle_recherche: 'Rechercher une nationalité'}) }}
                            </div>
                            <p id="nationalite-aide" class="mt-1 text-sm text-slate-600">Condition de candidature : être de nationalité ivoirienne.</p>
                            {{ form_errors(nationalite) }}
                        </div>
                        
                    </div>
        
                </div>
        
                <!-- ÉTAPE 3 : Résidence et contact -->
                <div class="step hidden" id="step3">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <!-- Ville de résidence -->
                        <div class="md:col-span-1">
                            <label for="{{ form.residence.vars.id }}" class="block text-sm font-medium text-slate-700 mb-1">
                                Ville de résidence
                            </label>
                            {{ form_widget(form.residence, {
                                'attr': {
                                    'class': input_class,
                                    'placeholder': 'Votre ville, par exemple Bouaké'
                                }
                            }) }}
                            {{ form_errors(form.residence) }}
                        </div>

                        <!-- Boîte postale -->
                        <div class="md:col-span-1">
                            <label for="{{ form.boitePostale.vars.id }}" class="block text-sm font-medium text-slate-700 mb-1">
                                Boîte postale <span class="font-normal text-slate-600">(facultatif)</span>
                            </label>
                            {{ form_widget(form.boitePostale, {
                                'attr': {
                                    'class': input_class,
                                    'placeholder': 'Par exemple 01 BP 1234 Abidjan 01'
                                }
                            }) }}
                            {{ form_errors(form.boitePostale) }}
                        </div>

                        <div class="md:col-span-1">
                            {{ ui.champ_telephone(form.contact, '', "Votre numéro principal : choisissez l'indicatif, puis tapez le numéro.", false, '07 08 09 10 11', 'tel-national') }}
                        </div>

                        <div class="md:col-span-1">
                            {{ ui.champ_telephone(form.contact2, '', 'Un autre numéro où vous joindre.', true, '05 06 07 08 09', 'off') }}
                        </div>
                    </div>
                </div>

                <!-- ÉTAPE 4 : Identifiants de connexion et validation -->
                <div class="step hidden" id="step4">
                    <!-- Identifiants -->
                    <div class="space-y-4 mb-6">
                        <!-- Email -->
                        <div>
                            <label class="block text-sm font-medium text-slate-700 mb-1">
                                Email
                            </label>
                            {{ form_widget(form.email, {
                                'attr': {
                                    'class': input_class,
                                    'placeholder': 'exemple@email.com'
                                }
                            }) }}
                            {{ form_errors(form.email) }}
                        </div>
                        
                        <!-- Mot de passe et confirmation -->
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div>
                                <label class="block text-sm font-medium text-slate-700 mb-1">
                                    Mot de passe
                                </label>
                                <div class="relative" x-data="{ visible: false }">
                                    {{ form_widget(form.password.first, {
                                        'attr': {
                                            'class': input_class ~ ' pr-12',
                                            'placeholder': '8 caractères minimum',
                                            ':type': "visible ? 'text' : 'password'"
                                        }
                                    }) }}
                                    <button type="button" @click="visible = !visible"
                                            :aria-label="visible ? 'Masquer le mot de passe' : 'Afficher le mot de passe'"
                                            :aria-pressed="visible.toString()"
                                            class="absolute inset-y-0 right-0 flex w-11 items-center justify-center rounded-r-lg text-slate-600 hover:text-slate-900 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-indigo-600">
                                        <i class="fas" :class="visible ? 'fa-eye-slash' : 'fa-eye'" aria-hidden="true"></i>
                                    </button>
                                </div>
                            </div>
                            
                            <div>
                                <label class="block text-sm font-medium text-slate-700 mb-1">
                                    Confirmation
                                </label>
                                <div class="relative" x-data="{ visible: false }">
                                    {{ form_widget(form.password.second, {
                                        'attr': {
                                            'class': input_class ~ ' pr-12',
                                            'placeholder': '••••••••',
                                            ':type': "visible ? 'text' : 'password'"
                                        }
                                    }) }}
                                    <button type="button" @click="visible = !visible"
                                            :aria-label="visible ? 'Masquer le mot de passe' : 'Afficher le mot de passe'"
                                            :aria-pressed="visible.toString()"
                                            class="absolute inset-y-0 right-0 flex w-11 items-center justify-center rounded-r-lg text-slate-600 hover:text-slate-900 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-indigo-600">
                                        <i class="fas" :class="visible ? 'fa-eye-slash' : 'fa-eye'" aria-hidden="true"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                
                    {# Erreurs du mot de passe (vide, trop court, confirmation différente) :
                       le RepeatedType les rattache à son premier champ (error_mapping). #}
                    {{ form_errors(form.password) }}
                    {{ form_errors(form.password.first) }}
                    <p id="mot-de-passe-erreur" class="mt-1.5 hidden text-sm font-medium text-red-700" role="alert"></p>

                    <div class="mt-6 p-4 bg-slate-50 rounded-lg">
                        <div class="flex items-start">
                            {{ form_widget(form.attestation, {attr: {class: 'mt-1 mr-3 h-4 w-4 shrink-0 accent-indigo-600'}}) }}
                            <label for="{{ form.attestation.vars.id }}" class="text-sm text-slate-600">
                                {{ form.attestation.vars.label }}
                            </label>
                        </div>
                        {{ form_errors(form.attestation) }}
                        <p id="attestation-erreur" class="mt-1.5 hidden text-sm font-medium text-red-700" role="alert"></p>
                    </div>
                </div>
        
                <!-- Boutons de navigation -->
                <div class="flex justify-between items-center pt-6 border-t border-slate-200">
                    <button type="button" id="prev-btn" class="px-6 py-2 border border-slate-300 rounded-lg text-slate-700 hover:bg-slate-50 transition disabled:opacity-50 disabled:cursor-not-allowed" disabled>
                        <i class="fas fa-arrow-left mr-2"></i>
                        Précédent
                    </button>
                    
                    <div class="flex gap-3">
                        <button type="button" id="next-btn" class="px-6 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 transition">
                            Suivant
                            <i class="fas fa-arrow-right ml-2"></i>
                        </button>
                        
                        <button type="submit" id="submit-btn" class="px-8 py-2 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold rounded-lg transition hidden focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-600 focus-visible:ring-offset-2">
                            <span class="spinner-border spinner-border-sm hidden mr-2" id="spinner"></span>
                            <i class="fas fa-check-circle mr-2"></i>
                            Finaliser ma préinscription
                        </button>
                    </div>
                </div>
        
                {{ form_end(form) }}
            </div>
        </div>
    </div>

    <!-- Lien retour accueil et retour page précédente -->
    <div class="text-center mt-4 space-y-2">
        {% if redirect is defined and redirect %}
            <a href="{{ redirect }}" class="text-sm text-slate-500 hover:text-indigo-600 transition inline-flex items-center mr-4">
                <i class="fas fa-arrow-left mr-1"></i>
                Retour à la page précédente
            </a>
        {% endif %}
        <a href="{{ path('app_home') }}" class="text-sm text-slate-500 hover:text-indigo-600 transition inline-flex items-center">
            <i class="fas fa-home mr-1"></i>
            Retour à l'accueil
        </a>
    </div>
</div>

<!-- ==================== JAVASCRIPT ==================== -->
<script>
document.addEventListener('DOMContentLoaded', function() {
    const form = document.getElementById('register-form');
    const steps = document.querySelectorAll('.step');
    const prevBtn = document.getElementById('prev-btn');
    const nextBtn = document.getElementById('next-btn');
    const submitBtn = document.getElementById('submit-btn');
    const stepIndicator = document.getElementById('step-indicator');
    const stepName = document.getElementById('step-name');
    const progressBar = document.getElementById('progress-bar');
    const progressPercent = document.getElementById('progress-percent');
    const spinner = document.getElementById('spinner');
    
    const stepNames = ['Identité', 'Naissance', 'Contact', 'Connexion'];
    let currentStep = 0;
    const totalSteps = steps.length;

    // Fonction pour mettre à jour l'affichage des étapes
    function updateSteps() {
        steps.forEach((step, index) => {
            if (index === currentStep) {
                step.classList.remove('hidden');
            } else {
                step.classList.add('hidden');
            }
        });

        prevBtn.disabled = currentStep === 0;
        
        if (currentStep === totalSteps - 1) {
            nextBtn.classList.add('hidden');
            submitBtn.classList.remove('hidden');
        } else {
            nextBtn.classList.remove('hidden');
            submitBtn.classList.add('hidden');
        }

        stepIndicator.textContent = `Étape ${currentStep + 1}/${totalSteps}`;
        stepName.textContent = stepNames[currentStep];
        
        const progress = ((currentStep + 1) / totalSteps) * 100;
        progressBar.style.width = `${progress}%`;
        progressPercent.textContent = `${Math.round(progress)}%`;
    }

    // Contrôle des numéros selon l'indicatif choisi (même règle que le serveur,
    // App\\Referentiel\\Telephone) : +225, exactement 10 chiffres ; ailleurs, 6 à 13
    // chiffres sans le 0 composé dans le pays (conservé en Italie).
    function paysDe(champ) {
        var liste = champ.closest('[data-telephone-boite]').querySelector('select');
        return liste ? liste.value : 'CI';
    }
    function cleTelephone(champ) {
        var chiffres = champ.value.replace(/\D/g, ''), pays = paysDe(champ);
        if (pays !== 'CI' && pays !== 'IT') { chiffres = chiffres.replace(/^0/, ''); }
        return chiffres === '' ? '' : pays + ':' + chiffres;
    }
    function messageTelephone(champ) {
        var cle = cleTelephone(champ), pays = paysDe(champ);
        if (cle === '') {
            return champ.dataset.obligatoire === '1' ? 'Saisissez votre numéro de téléphone.' : '';
        }
        var n = cle.split(':')[1].length;
        if (pays === 'CI' && n !== 10) {
            return 'Un numéro ivoirien compte exactement 10 chiffres (ici ' + n + ').';
        }
        if (pays !== 'CI' && (n < 6 || n > 13)) {
            return "Le numéro doit compter entre 6 et 13 chiffres, sans l'indicatif.";
        }
        return '';
    }

    function afficherErreurTelephone(champ, message) {
        var zone = document.getElementById(champ.id + '-erreur');
        var boite = champ.closest('[data-telephone-boite]');
        zone.textContent = message;
        zone.classList.toggle('hidden', !message);
        champ.setAttribute('aria-invalid', message ? 'true' : 'false');
        boite.classList.toggle('border-red-600', !!message);
        boite.classList.toggle('border-slate-500', !message);
    }

    function validerTelephones() {
        var champs = Array.from(document.querySelectorAll('[data-telephone-fr]'));
        var premier = null;
        champs.forEach(function (champ) {
            var message = messageTelephone(champ);
            if (!message && champ !== champs[0] && cleTelephone(champ) !== '' &&
                cleTelephone(champ) === cleTelephone(champs[0])) {
                message = 'Le 2ᵉ contact doit être différent du premier.';
            }
            afficherErreurTelephone(champ, message);
            if (message && !premier) { premier = champ; }
        });
        return premier;
    }

    // Date de naissance « jj/mm/aaaa » : même logique qu'e-justice.ci (barres
    // ajoutées pendant la frappe, date réelle, pas dans le futur).
    var champDate = document.querySelector('[data-date-fr]');
    var calendrier = document.querySelector('[data-calendrier]');

    function messageDate(champ) {
        var v = champ.value.trim();
        if (v === '') { return ''; }
        var m = /^(\d{2})\/(\d{2})\/(\d{4})$/.exec(v);
        if (!m) { return 'Saisissez la date complète : jj/mm/aaaa, par exemple 15/03/1985.'; }
        var j = +m[1], mo = +m[2], a = +m[3];
        var d = new Date(a, mo - 1, j);
        if (d.getFullYear() !== a || d.getMonth() !== mo - 1 || d.getDate() !== j) { return "Cette date n'existe pas : vérifiez le jour et le mois."; }
        if (d > new Date()) { return 'La date de naissance ne peut pas être dans le futur.'; }
        if (a < 1930) { return "Vérifiez l'année de naissance."; }
        return '';
    }

    function afficherErreurDate(message) {
        var zone = document.getElementById(champDate.id + '-erreur');
        var boite = champDate.closest('[data-date-boite]');
        zone.textContent = message;
        zone.classList.toggle('hidden', !message);
        champDate.setAttribute('aria-invalid', message ? 'true' : 'false');
        boite.classList.toggle('border-red-600', !!message);
        boite.classList.toggle('border-slate-500', !message);
    }

    function formaterDate(champ) {
        var c = champ.value.replace(/\D/g, '').slice(0, 8);
        champ.value = c.length > 4 ? c.slice(0, 2) + '/' + c.slice(2, 4) + '/' + c.slice(4)
            : c.length > 2 ? c.slice(0, 2) + '/' + c.slice(2) : c;
    }

    if (champDate) {
        champDate.addEventListener('input', function () {
            formaterDate(champDate);
            if (champDate.value.length === 10 || champDate.getAttribute('aria-invalid') === 'true') { afficherErreurDate(messageDate(champDate)); }
        });
        champDate.addEventListener('blur', function () { afficherErreurDate(messageDate(champDate)); });
    }
    if (champDate && calendrier) {
        // Ouvre le calendrier sur la date déjà saisie ; reporte le choix en jj/mm/aaaa.
        calendrier.addEventListener('click', function () {
            var m = /^(\d{2})\/(\d{2})\/(\d{4})$/.exec(champDate.value);
            calendrier.value = m ? m[3] + '-' + m[2] + '-' + m[1] : '';
            if (typeof calendrier.showPicker === 'function') { try { calendrier.showPicker(); } catch (e) {} }
        });
        calendrier.addEventListener('change', function () {
            var p = calendrier.value.split('-');
            if (p.length === 3) { champDate.value = p[2] + '/' + p[1] + '/' + p[0]; afficherErreurDate(messageDate(champDate)); }
        });
    }

    function validateStep(step) {
        if (champDate && steps[step].contains(champDate)) {
            var messageD = messageDate(champDate);
            afficherErreurDate(messageD);
            if (messageD) { champDate.focus(); return false; }
        }
        if (!steps[step].querySelector('[data-telephone-fr]')) { return true; }
        var invalide = validerTelephones();
        if (invalide) { invalide.focus(); return false; }
        return true;
    }

    // Navigation suivante
    nextBtn.addEventListener('click', function() {
        if (currentStep < totalSteps - 1) {
            if (validateStep(currentStep)) {
                currentStep++;
                updateSteps();
            }
        }
    });

    // Navigation précédente
    prevBtn.addEventListener('click', function() {
        if (currentStep > 0) {
            currentStep--;
            updateSteps();
        }
    });

    // Animation du spinner au submit
    form.addEventListener('submit', function(e) {
        // Vérification finale avant soumission : on ramène l'utilisateur à l'étape des numéros.
        var invalide = validerTelephones();
        if (invalide) {
            e.preventDefault();
            currentStep = Array.from(steps).indexOf(invalide.closest('.step'));
            updateSteps();
            invalide.focus();
            return;
        }
        // Mot de passe et attestation : même règle que le serveur (UserType).
        var mdp = document.getElementById('{{ form.password.first.vars.id }}');
        var confirmation = document.getElementById('{{ form.password.second.vars.id }}');
        var attestation = document.getElementById('{{ form.attestation.vars.id }}');
        var messageMdp = mdp.value.length < 8 ? 'Choisissez un mot de passe de 8 caractères au moins.'
            : (mdp.value !== confirmation.value ? 'Les mots de passe ne correspondent pas.' : '');
        var zoneMdp = document.getElementById('mot-de-passe-erreur');
        var zoneAttestation = document.getElementById('attestation-erreur');
        zoneMdp.textContent = messageMdp;
        zoneMdp.classList.toggle('hidden', !messageMdp);
        zoneAttestation.textContent = attestation.checked ? '' : "Cochez la case pour attester sur l'honneur l'exactitude de vos informations.";
        zoneAttestation.classList.toggle('hidden', attestation.checked);
        if (messageMdp || !attestation.checked) {
            e.preventDefault();
            (messageMdp ? mdp : attestation).focus();
            return;
        }
        
        spinner.classList.remove('hidden');
        submitBtn.disabled = true;
    });

    // Animation des champs au focus
    const inputs = document.querySelectorAll('input:not([data-sans-anneau]), select');
    inputs.forEach(input => {
        input.addEventListener('focus', function() {
            this.classList.add('ring-2', 'ring-indigo-300');
        });
        input.addEventListener('blur', function() {
            this.classList.remove('ring-2', 'ring-indigo-300');
        });
    });

    // La mise en forme pendant la frappe est faite par le champ partagé
    // (ui.champ_telephone, formaterNumero) ; ici, seulement le contrôle.
    document.querySelectorAll('[data-telephone-fr]').forEach(function (champ) {
        champ.addEventListener('input', function () {
            if (champ.getAttribute('aria-invalid') === 'true') { afficherErreurTelephone(champ, messageTelephone(champ)); }
        });
        champ.addEventListener('blur', function () {
            if (champ.value !== '') { afficherErreurTelephone(champ, messageTelephone(champ)); }
        });
    });

    // Après une erreur renvoyée par le serveur, on rouvre l'étape qui la porte.
    var enErreur = document.querySelector('.step [aria-invalid="true"], .step ul [role="alert"]');
    if (enErreur) { currentStep = Array.from(steps).indexOf(enErreur.closest('.step')); }

    // Initialisation
    updateSteps();
});
</script>

<style>
/* Style pour le texte en majuscules */
.text-uppercase {
    text-transform: uppercase;
}

/* Animation de pulsation pour le bouton désactivé */
@keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.7; }
}
button[type="submit"]:disabled {
    animation: pulse 1.5s infinite;
    cursor: not-allowed;
}

/* Transition fluide */
.step {
    transition: opacity 0.3s ease-in-out;
}
</style>
</div>
{% endblock %}
