{% extends 'public/base.html.twig' %}

{% block title %}Mot de passe oublié | {{ parent() }}{% endblock %}

{% block body %}
{# pt-28 : dégage l'en-tête public fixe de 72 px. #}
<div class="min-h-screen bg-slate-50 pt-28">
<div class="container mx-auto px-4 mb-6 max-w-md">
    {% include 'partials/_flash_messages.html.twig' %}
</div>

<div class="container mx-auto px-4 pb-16">
    <div class="max-w-md mx-auto">
        <div class="bg-white rounded-lg border border-slate-200 overflow-hidden">
            <div class="px-6 pt-8 pb-2 text-center">
                <h1 class="text-2xl font-bold text-slate-900 mb-1">
                    {% if step == 1 %}Mot de passe oublié{% else %}Nouveau mot de passe{% endif %}
                </h1>
                <p class="text-sm text-slate-500">
                    {% if step == 1 %}Vérifiez votre identité pour réinitialiser{% else %}Créez un nouveau mot de passe{% endif %}
                </p>
            </div>

            <div class="p-6 md:p-8 pt-2">
                {% if step == 1 %}
                    <form method="post" class="space-y-6">
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('forgot_password_verify') }}">
                        <div>
                            <label for="identifier" class="block text-sm font-medium text-slate-700 mb-2">E-mail ou numéro de téléphone</label>
                            <input type="text" name="identifier" id="identifier" class="w-full px-4 py-3 rounded-lg border border-slate-500 focus:outline-none focus:ring-2 focus:ring-indigo-600 focus:border-indigo-600 transition" placeholder="exemple@email.com ou 0123456789" autocomplete="username" required autofocus>
                            <p class="text-xs text-slate-600 mt-1">Utilisez l'identifiant fourni lors de l'inscription.</p>
                        </div>
                        <div>
                            <label for="lastFourDigits" class="block text-sm font-medium text-slate-700 mb-2">4 derniers chiffres du téléphone</label>
                            <input type="text" name="last_four_digits" id="lastFourDigits" class="w-full px-4 py-3 rounded-lg border border-slate-500 focus:outline-none focus:ring-2 focus:ring-indigo-600 focus:border-indigo-600 transition" placeholder="Ex: 6789" maxlength="4" pattern="[0-9]{4}" inputmode="numeric" required>
                        </div>
                        <button type="submit" name="verify_user" class="w-full py-3 px-4 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold rounded-lg transition flex items-center justify-center focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-600 focus-visible:ring-offset-2">
                            <i class="fas fa-check mr-2"></i>Vérifier
                        </button>
                    </form>
                {% else %}
                    <form method="post" class="space-y-6">
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('forgot_password_reset') }}">
                        <div class="bg-indigo-50 border border-indigo-200 rounded-lg p-4 text-center">
                            <p class="text-sm text-indigo-700"><i class="fas fa-user-check mr-2"></i>Identité vérifiée pour <strong>{{ identifier }}</strong></p>
                        </div>
                        <div>
                            <label for="newPassword" class="block text-sm font-medium text-slate-700 mb-2">Nouveau mot de passe</label>
                            <input type="password" name="new_password" id="newPassword" class="w-full px-4 py-3 rounded-lg border border-slate-500 focus:outline-none focus:ring-2 focus:ring-indigo-600 focus:border-indigo-600 transition" minlength="8" autocomplete="new-password" required>
                            <p class="text-xs text-slate-600 mt-1">Minimum 8 caractères.</p>
                        </div>
                        <div>
                            <label for="confirmPassword" class="block text-sm font-medium text-slate-700 mb-2">Confirmer le mot de passe</label>
                            <input type="password" name="confirm_password" id="confirmPassword" class="w-full px-4 py-3 rounded-lg border border-slate-500 focus:outline-none focus:ring-2 focus:ring-indigo-600 focus:border-indigo-600 transition" minlength="8" autocomplete="new-password" required>
                        </div>
                        <button type="submit" name="reset_password" class="w-full py-3 px-4 bg-green-600 hover:bg-green-700 text-white font-semibold rounded-lg transition flex items-center justify-center focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-600 focus-visible:ring-offset-2">
                            <i class="fas fa-save mr-2"></i>Enregistrer le mot de passe
                        </button>
                    </form>
                {% endif %}
                <div class="mt-6 pt-6 border-t border-slate-200 text-center">
                    <a href="{{ path('app_login') }}" class="text-sm text-indigo-600 hover:text-indigo-800 font-medium inline-flex items-center"><i class="fas fa-arrow-left mr-1"></i>Retour à la connexion</a>
                </div>
            </div>
        </div>
    </div>
</div>
</div>
{% endblock %}