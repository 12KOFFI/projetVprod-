<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="DAIP - Dashboard">
    <title>{% block title %}DAIP - Tableau de bord{% endblock %}</title>
    
    {{ encore_entry_link_tags('app') }}
    <style>
    select:required, input:required {
    border-left-width: 3px;
    border-left-color: #0B669D;
}
input:disabled, select:disabled {
    background-color: #f8fafc;
    cursor: not-allowed;
}
optgroup {
    font-weight: 600;
    color: #0B669D;
}

/* Style personnalisé pour DataTables */
.dataTables_wrapper {
    padding: 1rem;
}

.dataTables_length {
    margin-bottom: 1rem;
}

.dataTables_length select {
    @apply w-auto px-3 py-1.5 rounded-lg border border-slate-200 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition;
    margin: 0 0.5rem;
}

.dataTables_filter {
    margin-bottom: 1rem;
}

.dataTables_filter input {
    @apply px-3 py-1.5 rounded-lg border border-slate-200 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition;
    margin-left: 0.5rem;
    width: 250px;
}

.dataTables_info {
    @apply text-sm text-slate-600;
    padding-top: 1rem !important;
}

.dataTables_paginate {
    @apply flex justify-end gap-1;
    padding-top: 1rem !important;
}

.dataTables_paginate .paginate_button {
    @apply px-3 py-1.5 rounded-lg border border-slate-200 text-slate-600 hover:bg-indigo-50 hover:border-indigo-300 transition cursor-pointer;
    margin: 0 2px;
}

.dataTables_paginate .paginate_button.current {
    @apply bg-gradient-to-r from-indigo-600 to-purple-600 text-white border-transparent;
}

.dataTables_paginate .paginate_button.disabled {
    @apply opacity-50 cursor-not-allowed hover:bg-transparent;
}

.dataTables_paginate .paginate_button:hover:not(.disabled):not(.current) {
    @apply bg-indigo-50 border-indigo-300;
}

table.dataTable {
    @apply w-full;
}

table.dataTable thead th {
    @apply px-6 py-4 text-left text-sm font-semibold text-slate-600 bg-slate-50 border-b border-slate-200;
}

table.dataTable thead th.sorting_asc:after,
table.dataTable thead th.sorting_desc:after {
    @apply ml-1 text-indigo-600;
}

table.dataTable tbody td {
    @apply px-6 py-4 text-sm border-b border-slate-200;
}

table.dataTable tbody tr:hover {
    @apply bg-slate-50;
}

.dataTables_processing {
    @apply bg-white/80 backdrop-blur-sm;
}
</style>
    
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    
    <style>
        body { font-family: 'Plus Jakarta Sans', sans-serif; }
        .sidebar-transition {
            transition: width 0.3s ease-in-out;
        }
        .sidebar-transition * {
            transition: opacity 0.2s ease-in-out;
        }
        [x-cloak] { display: none !important; }
    </style>
    
    {% block stylesheets %}{% endblock %}
</head>
<body class="bg-gray-50">
    <div class="flex h-screen overflow-hidden">
        <!-- Sidebar -->
        <aside class="relative w-64 bg-gradient-to-b from-primary-900 to-secondary-900 text-white flex-shrink-0 overflow-y-auto sidebar-transition" x-data="{ collapsed: false }">
            <div class="p-6">
                {% block sidebar %}
                    {% include 'sidebar.html.twig' %}
                {% endblock %}
            </div>
        </aside>
        
        <!-- Main Content -->
        <div class="flex-1 flex flex-col overflow-hidden">
            <!-- Navbar -->
            <header class="border-b border-slate-200 bg-white">
                <div class="px-6 py-4 flex justify-between items-center">
                    <button id="sidebarToggle" type="button" aria-label="Réduire ou déployer le menu" class="inline-flex min-h-[44px] min-w-[44px] items-center justify-center rounded-lg text-slate-600 transition hover:bg-slate-100 hover:text-indigo-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-600">
                        <i class="fas fa-bars text-xl"></i>
                    </button>
                    
                    <div class="flex items-center space-x-4">
                        {% if app.user %}
                        <div class="relative" x-data="{ open: false }">
                            <button type="button" @click="open = !open" class="flex min-h-[44px] items-center space-x-3 rounded-lg px-2 text-slate-700 transition hover:text-indigo-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-600">
                                <div class="flex h-9 w-9 items-center justify-center rounded-full bg-indigo-600 text-white">
                                    <i class="fas fa-user text-sm"></i>
                                </div>
                                <span class="text-sm font-medium hidden md:inline">{{ app.user.email|slice(0, 20) }}</span>
                                <i class="fas fa-chevron-down text-xs transition-transform" :class="{ 'rotate-180': open }"></i>
                            </button>
                            
                            <div x-show="open" @click.away="open = false" x-transition:enter="transition ease-out duration-200" x-transition:enter-start="opacity-0 -translate-y-2" x-transition:enter-end="opacity-100 translate-y-0" class="absolute right-0 z-50 mt-2 w-48 rounded-lg border border-slate-200 bg-white py-2 shadow-lg">
                                <a href="{{ path('app_profil_modifier') }}" class="flex min-h-[44px] items-center px-4 text-sm text-slate-700 transition hover:bg-indigo-50 hover:text-indigo-700 focus-visible:bg-indigo-50 focus-visible:outline-none">
                                    <i class="fas fa-user-pen w-5 mr-3"></i>Mon profil
                                </a>
                                <a href="{{ path('app_logout') }}" class="flex min-h-[44px] items-center px-4 text-sm text-slate-700 transition hover:bg-red-50 hover:text-red-700 focus-visible:bg-red-50 focus-visible:outline-none">
                                    <i class="fas fa-sign-out-alt w-5 mr-3"></i>Déconnexion
                                </a>
                            </div>
                        </div>
                        {% endif %}
                    </div>
                </div>
            </header>
            
            <!-- Page Content -->
            {#
                `relative` est indispensable : les éléments `sr-only` (texte réservé aux
                lecteurs d'écran) sont en position absolue. Sans ancêtre positionné, ils
                se placent par rapport à la fenêtre, échappent au défilement interne de
                <main> et allongent la page, qui défile alors au-delà de la barre latérale.
            #}
            <main class="relative flex-1 overflow-y-auto bg-gray-50 p-4 sm:p-6 lg:p-8 selection:bg-indigo-100 selection:text-indigo-900">
                {% for label, messages in app.flashes %}
                    {% for message in messages %}
                        <div role="{{ label == 'error' ? 'alert' : 'status' }}" class="mb-6 rounded-lg p-4 text-sm {% if label == 'success' %}bg-green-50 text-green-800 border border-green-200{% elseif label == 'error' %}bg-red-50 text-red-800 border border-red-200{% else %}bg-blue-50 text-blue-800 border border-blue-200{% endif %}">
                            <div class="flex items-center">
                                <i class="fas {% if label == 'success' %}fa-check-circle text-green-600{% elseif label == 'error' %}fa-exclamation-circle text-red-600{% else %}fa-info-circle text-blue-600{% endif %} mr-3 text-lg" aria-hidden="true"></i>
                                {{ message|raw }}
                            </div>
                        </div>
                    {% endfor %}
                {% endfor %}
                
                {% block body %}{% endblock %}
            </main>
        </div>
    </div>
    
    {{ encore_entry_script_tags('app') }}
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.4/js/jquery.dataTables.min.js"></script>
    
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const sidebar = document.querySelector('aside');
            const toggleBtn = document.getElementById('sidebarToggle');
            const navTexts = sidebar.querySelectorAll('.nav-text');
            const sidebarLogo = sidebar.querySelector('.sidebar-logo-text');
            
            if (toggleBtn) {
                toggleBtn.addEventListener('click', function() {
                    sidebar.classList.toggle('w-64');
                    sidebar.classList.toggle('w-20');
                    
                    // Cacher/monther les textes
                    navTexts.forEach(el => el.classList.toggle('hidden'));
                    if (sidebarLogo) sidebarLogo.classList.toggle('hidden');
                });
            }
        });
    </script>
    
    <script>
    $(document).ready(function() {
        $('#dataTable').DataTable({
            language: {
                url: '//cdn.datatables.net/plug-ins/1.13.4/i18n/fr-FR.json',
                search: "Rechercher :",
                lengthMenu: "Afficher _MENU_ éléments",
                info: "Affichage de _START_ à _END_ sur _TOTAL_ éléments",
                infoEmpty: "Affichage de 0 à 0 sur 0 élément",
                infoFiltered: "(filtré sur _MAX_ éléments au total)",
                paginate: {
                    first: "Premier",
                    last: "Dernier",
                    next: "Suivant",
                    previous: "Précédent"
                }
            },
            pageLength: 25,
            order: [[1, 'asc']],
            columnDefs: [
                { orderable: false, targets: [5] },
                { searchable: false, targets: [0, 3, 4, 5] },
                { className: "text-center", targets: [3, 4] },
                { className: "text-right", targets: [5] }
            ]
        });
    });
    </script>
    
    
    {% block javascripts %}{% endblock %}
</body>
</html>
