<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="DAIP - Dashboard">
    <title>{% block title %}DAIP - Tableau de bord{% endblock %}</title>
    
    {{ encore_entry_link_tags('app') }}
    <style>
    select:required, input:required {
    border-left-width: 3px;
    border-left-color: #0B669D;
}
input:disabled, select:disabled {
    background-color: #f8fafc;
    cursor: not-allowed;
}
optgroup {
    font-weight: 600;
    color: #0B669D;
}
</style>

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    
    <style>
        body { font-family: 'Plus Jakarta Sans', sans-serif; }
        [x-cloak] { display: none !important; }
    </style>
    
    {% block stylesheets %}{% endblock %}
</head>
<body class="bg-gray-50">
    {#
        Sous lg, la barre latérale devient un tiroir hors-champ : à 375 px, ses
        256 px ne laissaient que 119 px de contenu. Au-dessus de lg, elle
        retrouve sa place dans le flux et son repli w-64 / w-20 inchangé.
        Le défilement interne (h-screen + overflow) ne vaut lui aussi qu'à
        partir de lg : sur téléphone, c'est la page qui défile, ce qui laisse
        la barre d'adresse du navigateur se replier.
    #}
    <div class="flex min-h-screen lg:h-screen lg:overflow-hidden"
         x-data="{ menuOuvert: false }"
         @keydown.escape.window="menuOuvert = false">

        <!-- Voile du tiroir, mobile uniquement -->
        <div x-show="menuOuvert" x-cloak
             @click="menuOuvert = false"
             x-transition:enter="transition ease-out duration-200"
             x-transition:enter-start="opacity-0"
             x-transition:enter-end="opacity-100"
             x-transition:leave="transition ease-in duration-150"
             x-transition:leave-start="opacity-100"
             x-transition:leave-end="opacity-0"
             class="fixed inset-0 z-40 bg-slate-900/60 lg:hidden"
             aria-hidden="true"></div>

        <!-- Sidebar -->
        <aside id="menu-lateral"
               :class="menuOuvert ? 'translate-x-0' : '-translate-x-full'"
               @click="if ($event.target.closest('a')) menuOuvert = false"
               class="fixed inset-y-0 left-0 z-50 w-72 max-w-[85vw] -translate-x-full overflow-y-auto bg-gradient-to-b from-primary-900 to-secondary-900 text-white transition-all duration-300 ease-in-out motion-reduce:transition-none lg:relative lg:z-auto lg:w-64 lg:max-w-none lg:flex-shrink-0 lg:translate-x-0">
            <div class="p-6">
                <button type="button" @click="menuOuvert = false" x-ref="fermerMenu"
                        class="mb-4 inline-flex min-h-[44px] min-w-[44px] items-center justify-center gap-2 rounded-lg px-3 text-sm font-semibold text-indigo-100 transition hover:bg-white/10 hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white lg:hidden">
                    <i class="fas fa-xmark" aria-hidden="true"></i>Fermer le menu
                </button>
                {% block sidebar %}
                    {% include 'sidebar.html.twig' %}
                {% endblock %}
            </div>
        </aside>

        {# `overflow-hidden` seulement à partir de lg : sous ce seuil, un conteneur
           de débordement casserait le `sticky` de la barre supérieure, qui se
           positionne alors par rapport à lui et non à la fenêtre. #}
        <!-- Main Content -->
        <div class="flex-1 flex flex-col lg:overflow-hidden">
            <!-- Navbar -->
            <header class="sticky top-0 z-30 border-b border-slate-200 bg-white lg:static">
                <div class="px-4 py-3 sm:px-6 sm:py-4 flex justify-between items-center gap-3">
                    {# Deux commandes distinctes plutôt qu'une seule au comportement
                       variable : ouvrir le tiroir sous lg, replier la barre au-dessus. #}
                    <button type="button" @click="menuOuvert = true; $nextTick(() => $refs.fermerMenu.focus())"
                            :aria-expanded="menuOuvert ? 'true' : 'false'"
                            aria-controls="menu-lateral"
                            class="inline-flex min-h-[44px] min-w-[44px] items-center justify-center rounded-lg text-slate-600 transition hover:bg-slate-100 hover:text-indigo-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-600 lg:hidden">
                        <span class="sr-only">Ouvrir le menu</span>
                        <i class="fas fa-bars text-xl" aria-hidden="true"></i>
                    </button>

                    <button id="sidebarToggle" type="button" aria-label="Réduire ou déployer le menu" class="hidden min-h-[44px] min-w-[44px] items-center justify-center rounded-lg text-slate-600 transition hover:bg-slate-100 hover:text-indigo-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-600 lg:inline-flex">
                        <i class="fas fa-bars text-xl" aria-hidden="true"></i>
                    </button>

                    <div class="flex items-center space-x-4">
                        {% if app.user %}
                        <div class="relative" x-data="{ open: false }">
                            <button type="button" @click="open = !open" class="flex min-h-[44px] items-center space-x-3 rounded-lg px-2 text-slate-700 transition hover:text-indigo-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-600">
                                <div class="flex h-9 w-9 items-center justify-center rounded-full bg-indigo-600 text-white">
                                    <i class="fas fa-user text-sm"></i>
                                </div>
                                <span class="text-sm font-medium hidden md:inline">{{ app.user.email|slice(0, 20) }}</span>
                                <i class="fas fa-chevron-down text-xs transition-transform" :class="{ 'rotate-180': open }"></i>
                            </button>
                            
                            <div x-show="open" @click.away="open = false" x-transition:enter="transition ease-out duration-200" x-transition:enter-start="opacity-0 -translate-y-2" x-transition:enter-end="opacity-100 translate-y-0" class="absolute right-0 z-50 mt-2 w-48 rounded-lg border border-slate-200 bg-white py-2 shadow-lg">
                                <a href="{{ path('app_profil_modifier') }}" class="flex min-h-[44px] items-center px-4 text-sm text-slate-700 transition hover:bg-indigo-50 hover:text-indigo-700 focus-visible:bg-indigo-50 focus-visible:outline-none">
                                    <i class="fas fa-user-pen w-5 mr-3"></i>Mon profil
                                </a>
                                <a href="{{ path('app_logout') }}" class="flex min-h-[44px] items-center px-4 text-sm text-slate-700 transition hover:bg-red-50 hover:text-red-700 focus-visible:bg-red-50 focus-visible:outline-none">
                                    <i class="fas fa-sign-out-alt w-5 mr-3"></i>Déconnexion
                                </a>
                            </div>
                        </div>
                        {% endif %}
                    </div>
                </div>
            </header>
            
            <!-- Page Content -->
            {#
                `relative` est indispensable : les éléments `sr-only` (texte réservé aux
                lecteurs d'écran) sont en position absolue. Sans ancêtre positionné, ils
                se placent par rapport à la fenêtre, échappent au défilement interne de
                <main> et allongent la page, qui défile alors au-delà de la barre latérale.
            #}
            {# pb-24 réserve la hauteur de la barre d'onglets basse ; lg:pb-8 la
               rend à sa valeur normale dès que cette barre disparaît. #}
            <main class="relative flex-1 bg-gray-50 p-4 pb-24 sm:p-6 sm:pb-24 lg:overflow-y-auto lg:p-8 lg:pb-8 selection:bg-indigo-100 selection:text-indigo-900">
                {% for label, messages in app.flashes %}
                    {% for message in messages %}
                        <div role="{{ label == 'error' ? 'alert' : 'status' }}" class="mb-6 rounded-lg p-4 text-sm {% if label == 'success' %}bg-green-50 text-green-800 border border-green-200{% elseif label == 'error' %}bg-red-50 text-red-800 border border-red-200{% else %}bg-blue-50 text-blue-800 border border-blue-200{% endif %}">
                            <div class="flex items-center">
                                <i class="fas {% if label == 'success' %}fa-check-circle text-green-600{% elseif label == 'error' %}fa-exclamation-circle text-red-600{% else %}fa-info-circle text-blue-600{% endif %} mr-3 text-lg" aria-hidden="true"></i>
                                {{ message|raw }}
                            </div>
                        </div>
                    {% endfor %}
                {% endfor %}
                
                {% block body %}{% endblock %}
            </main>
        </div>

        {% include 'partials/_nav_mobile.html.twig' %}
    </div>

    {{ encore_entry_script_tags('app') }}

    <script>
        // Repli de la barre latérale, sur grand écran uniquement : les classes
        // basculées portent le préfixe lg: pour ne pas entrer en conflit avec
        // la largeur du tiroir mobile (w-72), qui reste seule sous 1024 px.
        document.addEventListener('DOMContentLoaded', function() {
            const sidebar = document.getElementById('menu-lateral');
            const toggleBtn = document.getElementById('sidebarToggle');
            if (!sidebar || !toggleBtn) { return; }

            const navTexts = sidebar.querySelectorAll('.nav-text');
            const sidebarLogo = sidebar.querySelector('.sidebar-logo-text');

            toggleBtn.addEventListener('click', function() {
                sidebar.classList.toggle('lg:w-64');
                sidebar.classList.toggle('lg:w-20');

                // Cacher/montrer les textes
                navTexts.forEach(el => el.classList.toggle('lg:hidden'));
                if (sidebarLogo) sidebarLogo.classList.toggle('lg:hidden');
            });
        });
    </script>
    
    {% block javascripts %}{% endblock %}
</body>
</html>
