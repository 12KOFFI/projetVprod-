{#
    Barre d'onglets basse, sous 1024 px uniquement.

    Sur téléphone, la barre latérale est repliée en tiroir : sans elle, chaque
    déplacement demanderait deux gestes (ouvrir le tiroir, puis choisir). Cette
    barre remonte les trois destinations les plus fréquentes du rôle courant, la
    quatrième commande ouvrant le tiroir pour le reste.

    Les conditions de rôle reproduisent exactement celles de `sidebar.html.twig`
    — mêmes routes, mêmes exclusions ROLE_ADMIN : aucune destination nouvelle
    n'est ouverte ici, et aucune règle d'accès n'est contournée.

    Le lien actif est repéré par la couleur et par un filet supérieur, jamais
    par la seule couleur.
#}
{% set est_admin = is_granted('ROLE_ADMIN') %}

{% if est_admin %}
    {% set onglets = [
        { url: path('app_dashboard'), libelle: 'Tableau', icone: 'fa-gauge-high', routes: ['app_dashboard', 'app_admin_dashboard'] },
        { url: path('app_admin_candidature_index'), libelle: 'Dossiers', icone: 'fa-folder-open', routes: ['app_admin_candidature', 'app_admin_suivi_'] },
        { url: path('app_admin_paiement_index'), libelle: 'Paiements', icone: 'fa-money-bill-transfer', routes: ['app_admin_paiement'] }
    ] %}
{% elseif is_granted('ROLE_CONSEILLER') %}
    {% set onglets = [
        { url: path('app_conseiller_dashboard'), libelle: 'Tableau', icone: 'fa-gauge-high', routes: ['app_conseiller_dashboard'] },
        { url: path('app_conseiller_candidatures'), libelle: 'Dossiers', icone: 'fa-folder-open', routes: ['app_conseiller_candidature', 'app_conseiller_mes_analyses'] },
        { url: path('app_indicateurs'), libelle: 'Indicateurs', icone: 'fa-chart-column', routes: ['app_indicateurs'] }
    ] %}
{% elseif is_granted('ROLE_AGENT_ACCEUIL') %}
    {% set onglets = [
        { url: path('app_accueil_dashboard'), libelle: 'Tableau', icone: 'fa-gauge-high', routes: ['app_accueil_dashboard'] },
        { url: path('app_accueil_inscription'), libelle: 'Préinscrire', icone: 'fa-user-plus', routes: ['app_accueil_inscription', 'app_accueil_reprise'] },
        { url: path('app_accueil_candidatures'), libelle: 'Dossiers', icone: 'fa-folder-open', routes: ['app_accueil_candidatures', 'app_accueil_candidature'] }
    ] %}
{% elseif is_granted('ROLE_CANDIDAT') %}
    {% set onglets = [
        { url: path('app_candidat_candidature'), libelle: 'Candidature', icone: 'fa-file-lines', routes: ['app_candidat_candidature'] },
        { url: path('app_candidat_dashboard'), libelle: 'Suivi', icone: 'fa-route', routes: ['app_candidat_dashboard'] },
        { url: path('app_candidat_paiements'), libelle: 'Paiements', icone: 'fa-credit-card', routes: ['app_candidat_paiement'] }
    ] %}
{% elseif is_granted('ROLE_ACCOMPAGNATEUR') %}
    {% set onglets = [
        { url: path('app_dashboard'), libelle: 'Tableau', icone: 'fa-gauge-high', routes: ['app_dashboard'] },
        { url: path('app_indicateurs'), libelle: 'Indicateurs', icone: 'fa-chart-column', routes: ['app_indicateurs'] },
        { url: path('app_impressions'), libelle: 'Impressions', icone: 'fa-print', routes: ['app_impressions'] }
    ] %}
{% else %}
    {% set onglets = [
        { url: path('app_dashboard'), libelle: 'Tableau', icone: 'fa-gauge-high', routes: ['app_dashboard'] },
        { url: path('app_impressions'), libelle: 'Impressions', icone: 'fa-print', routes: ['app_impressions'] }
    ] %}
{% endif %}

{# z-30 et non z-40 : le voile du tiroir (z-40) doit passer par-dessus cette
   barre, sans quoi elle reste allumée derrière le menu ouvert. #}
<nav aria-label="Navigation principale"
     class="fixed inset-x-0 bottom-0 z-30 border-t border-slate-200 bg-white pb-[max(0.25rem,env(safe-area-inset-bottom))] lg:hidden">
    <ul class="flex items-stretch">
        {% for onglet in onglets %}
            {# `filter` et non une boucle : en Twig, une affectation faite dans un
               `for` ne survit pas à la sortie de la boucle. #}
            {% set actif = onglet.routes|filter(prefixe => app.current_route starts with prefixe)|length > 0 %}
            <li class="flex-1">
                <a href="{{ onglet.url }}"
                   {% if actif %}aria-current="page"{% endif %}
                   class="relative flex min-h-[56px] flex-col items-center justify-center gap-1 px-1 py-2 text-center text-xs font-semibold transition-colors duration-150 motion-reduce:transition-none focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-indigo-600 {{ actif ? 'text-indigo-700' : 'text-slate-600 hover:text-indigo-700' }}">
                    {% if actif %}<span class="absolute inset-x-3 top-0 h-0.5 rounded-full bg-indigo-700" aria-hidden="true"></span>{% endif %}
                    <i class="fas {{ onglet.icone }} text-lg" aria-hidden="true"></i>
                    <span class="leading-tight">{{ onglet.libelle }}</span>
                </a>
            </li>
        {% endfor %}

        <li class="flex-1">
            <button type="button" @click="menuOuvert = true; $nextTick(() => $refs.fermerMenu.focus())"
                    :aria-expanded="menuOuvert ? 'true' : 'false'"
                    aria-controls="menu-lateral"
                    class="flex min-h-[56px] w-full flex-col items-center justify-center gap-1 px-1 py-2 text-center text-xs font-semibold text-slate-600 transition-colors duration-150 motion-reduce:transition-none hover:text-indigo-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-indigo-600">
                <i class="fas fa-bars text-lg" aria-hidden="true"></i>
                <span class="leading-tight">Menu</span>
            </button>
        </li>
    </ul>
</nav>
