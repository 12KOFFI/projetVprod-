{# Écran E2.1 : liste des directions régionales + formulaire de création en modale. #}
{% extends 'base_dashboard.html.twig' %}
{% import 'partials/_ui.html.twig' as ui %}

{% block title %}Directions régionales — Administration VAE{% endblock %}

{% block body %}
<div x-data="{ modale: {{ form.vars.submitted and not form.vars.valid ? 'true' : 'false' }} }">

    {{ ui.bandeau(
        'Directions régionales',
        'Découpage administratif de premier niveau : chaque localité en dépend.',
        'sitemap',
        pagination.getTotalItemCount,
        'enregistrée(s)'
    ) }}

    <div class="bg-white rounded-lg border border-slate-200 overflow-hidden">
        <div class="px-6 py-5 border-b border-slate-200 flex flex-col md:flex-row md:items-center justify-between gap-4">
            <form method="get" class="relative flex-1 max-w-sm">
                <i class="fas fa-magnifying-glass absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-500 text-sm"></i>
                <input type="search" name="q" value="{{ recherche }}" placeholder="Rechercher une direction régionale"
                       class="w-full pl-10 pr-3.5 py-2.5 rounded-lg border border-slate-500 text-sm text-slate-700
                              focus:outline-none focus:ring-2 focus:ring-indigo-600 focus:border-indigo-600 transition duration-200">
            </form>

            <button type="button" @click="modale = true"
                    class="inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-lg text-sm font-medium text-white
                           bg-indigo-600 hover:bg-indigo-700 transition duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-600 focus-visible:ring-offset-2">
                <i class="fas fa-plus text-xs"></i>
                Nouvelle direction régionale
            </button>
        </div>

        {% if pagination.getTotalItemCount > 0 %}
            <div class="overflow-x-auto">
                <table class="w-full min-w-[540px]">
                    <thead class="bg-slate-50 border-b border-slate-200">
                        <tr>
                            {{ ui.th('Libellé') }}
                            {{ ui.th('Créée le') }}
                            {{ ui.th('Actions', 'text-right') }}
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        {% for direction_regionale in pagination %}
                            <tr class="hover:bg-slate-50/70 transition duration-200">
                                <td class="px-6 py-4 text-sm font-medium text-slate-700">
                                    {{ direction_regionale.libelle }}
                                </td>
                                <td class="px-6 py-4 text-sm text-slate-600">
                                    {{ direction_regionale.creation ? direction_regionale.creation|date('d/m/Y') : '—' }}
                                </td>
                                <td class="px-6 py-4">
                                    <div class="flex items-center justify-end gap-2">
                                        {{ ui.bouton_lien(
                                            path('app_admin_localite_index', {dr: direction_regionale.id}),
                                            'location-dot', 'Voir les localités', 'indigo'
                                        ) }}
                                        {{ ui.bouton_lien(
                                            path('app_admin_direction_regionale_modifier', {id: direction_regionale.id}),
                                            'pen', 'Modifier'
                                        ) }}
                                        {{ ui.bouton_post(
                                            path('app_admin_direction_regionale_supprimer', {id: direction_regionale.id}),
                                            'supprimer_dr_' ~ direction_regionale.id,
                                            'trash', 'Supprimer', 'red',
                                            'Supprimer « ' ~ direction_regionale.libelle ~ ' » ?'
                                        ) }}
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>

            {{ ui.pagination(pagination) }}
        {% else %}
            {{ ui.etat_vide(
                'sitemap',
                recherche ? 'Aucun résultat' : 'Aucune direction régionale',
                recherche
                    ? 'Aucune direction régionale ne correspond à « ' ~ recherche ~ ' ».'
                    : 'Les directions régionales sont le point de départ du référentiel : créez-les avant les localités.',
                recherche ? null : 'Utilisez le bouton « Nouvelle direction régionale »'
            ) }}
        {% endif %}
    </div>

    {# Modale de création. #}
    <div x-show="modale" style="display: none" class="fixed inset-0 z-40 flex items-center justify-center p-4">
        <div class="absolute inset-0 bg-slate-900/50 backdrop-blur-sm" @click="modale = false"></div>

        <div x-show="modale"
             x-transition:enter="transition ease-out duration-200"
             x-transition:enter-start="opacity-0 translate-y-3"
             x-transition:enter-end="opacity-100 translate-y-0"
             class="relative bg-white rounded-lg shadow-xl border border-slate-200 w-full max-w-md">
            <div class="px-6 py-5 border-b border-slate-200 flex items-center justify-between">
                <h2 class="text-base font-semibold text-slate-800">Nouvelle direction régionale</h2>
                <button type="button" @click="modale = false"
                        class="w-8 h-8 rounded-lg bg-slate-100 text-slate-600 hover:bg-slate-200 transition duration-150">
                    <i class="fas fa-xmark text-xs"></i>
                </button>
            </div>

            {{ form_start(form, {attr: {class: 'px-6 py-6 space-y-5'}}) }}
                {{ ui.champ(form.libelle) }}

                <div class="flex items-center justify-end gap-3 pt-2">
                    <button type="button" @click="modale = false"
                            class="px-4 py-2.5 rounded-lg text-sm font-medium text-slate-500 hover:bg-slate-100 transition duration-200">
                        Annuler
                    </button>
                    <button type="submit"
                            class="inline-flex items-center gap-2 px-4 py-2.5 rounded-lg text-sm font-medium text-white
                                   bg-indigo-600 hover:bg-indigo-700 transition duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-600 focus-visible:ring-offset-2">
                        <i class="fas fa-check text-xs"></i>
                        Enregistrer
                    </button>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}
