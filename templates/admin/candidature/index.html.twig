{# Liste nationale des dossiers : onglets par étape, filtres centre et recherche. #}
{% extends 'base_dashboard.html.twig' %}
{% import 'partials/_ui.html.twig' as ui %}

{% block title %}Dossiers — Administration VAE{% endblock %}

{% block body %}
{{ ui.bandeau(
    'Tous les dossiers',
    filtre_centre ? filtre_centre.nom : 'Tous les centres',
    'folder-open',
    pagination.getTotalItemCount,
    'dossier(s)'
) }}

<div class="bg-white rounded-lg border border-slate-200 overflow-hidden">

    {# ===== Onglets d'étape ===== #}
    <div class="border-b border-slate-200 px-4 sm:px-6 overflow-x-auto">
        <nav class="flex gap-1 -mb-px" aria-label="Étape du parcours">
            {% for cle, onglet in onglets %}
                {% set actif = cle == onglet_actif %}
                <a href="{{ path('app_admin_candidature_index', app.request.query.all|merge({onglet: cle, page: 1})) }}"
                   {{ actif ? 'aria-current="page"' : '' }}
                   class="whitespace-nowrap border-b-2 px-4 py-3.5 text-sm font-medium transition duration-200
                          {{ actif
                             ? 'border-indigo-600 text-indigo-700'
                             : 'border-transparent text-slate-600 hover:border-slate-300 hover:text-slate-800' }}">
                    {{ onglet.libelle }}
                </a>
            {% endfor %}
        </nav>
    </div>

    {# ===== Filtres ===== #}
    <div class="px-6 py-5 border-b border-slate-200">
        <form method="get" class="flex flex-col sm:flex-row flex-wrap gap-3">
            <input type="hidden" name="onglet" value="{{ onglet_actif }}">

            <div class="relative flex-1 min-w-[16rem]">
                <i class="fas fa-magnifying-glass absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-500 text-sm" aria-hidden="true"></i>
                <label for="recherche-dossier" class="sr-only">Rechercher un dossier</label>
                <input type="search" id="recherche-dossier" name="q" value="{{ recherche }}"
                       placeholder="Numéro VAE, nom, prénoms ou contact"
                       class="w-full pl-10 pr-3.5 py-2.5 rounded-lg border border-slate-500 text-sm text-slate-700
                              focus:outline-none focus:ring-2 focus:ring-indigo-600 focus:border-indigo-600 transition duration-200">
            </div>

            <label for="filtre-centre" class="sr-only">Filtrer par centre</label>
            <select name="centre" id="filtre-centre" onchange="this.form.submit()"
                    class="px-3.5 py-2.5 rounded-lg border border-slate-500 text-sm text-slate-700 bg-white
                           focus:outline-none focus:ring-2 focus:ring-indigo-600 focus:border-indigo-600 transition duration-200">
                <option value="">Tous les centres</option>
                {% for centre in centres %}
                    <option value="{{ centre.id }}" {{ filtre_centre and filtre_centre.id == centre.id ? 'selected' : '' }}>
                        {{ centre.nom }}
                    </option>
                {% endfor %}
            </select>

            <button type="submit"
                    class="inline-flex min-h-[44px] items-center justify-center gap-2 px-4 rounded-lg text-sm font-medium
                           text-slate-700 bg-slate-100 hover:bg-slate-200 transition duration-200">
                <i class="fas fa-filter text-xs" aria-hidden="true"></i>Filtrer
            </button>

            {% if recherche or filtre_centre %}
                <a href="{{ path('app_admin_candidature_index', {onglet: onglet_actif}) }}"
                   class="inline-flex min-h-[44px] items-center justify-center gap-2 px-4 rounded-lg text-sm font-medium
                          text-slate-700 border border-slate-300 hover:bg-slate-50 transition duration-200">
                    <i class="fas fa-rotate-left text-xs" aria-hidden="true"></i>Réinitialiser
                </a>
            {% endif %}
        </form>
    </div>

    {% if pagination.items is not empty %}
        {# ===== Tableau, à partir de l'écran large ===== #}
        <div class="hidden lg:block overflow-x-auto">
            <table class="w-full min-w-[980px]">
                <thead class="bg-slate-50 border-b border-slate-200">
                    <tr>
                        {{ ui.th('Numéro') }}
                        {{ ui.th('Candidat') }}
                        {{ ui.th('Centre') }}
                        {{ ui.th('Métier') }}
                        {{ ui.th('Statut') }}
                        {{ ui.th('Déposé le') }}
                        {{ ui.th('Actions', 'text-right') }}
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    {% for candidature in pagination.items %}
                        <tr class="hover:bg-slate-50/70 transition duration-200">
                            <td class="px-4 py-3 font-mono text-sm font-semibold text-slate-900 tabular-nums">
                                {{ candidature.numero }}
                            </td>
                            <td class="px-4 py-3 text-sm text-slate-700">
                                {{ candidature.user ? candidature.user.nomComplet : '—' }}
                            </td>
                            <td class="px-4 py-3 text-sm text-slate-700">
                                {{ candidature.centre ? candidature.centre.nom : '—' }}
                            </td>
                            <td class="px-4 py-3 text-sm text-slate-700">
                                {{ candidature.metier ? candidature.metier.libelle : '—' }}
                            </td>
                            <td class="px-4 py-3">
                                {{ include('partials/_statut_badge.html.twig', { statut: statut_candidature(candidature) }) }}
                            </td>
                            <td class="px-4 py-3 text-sm text-slate-700 tabular-nums">
                                {{ candidature.creation ? candidature.creation|date('d/m/Y') : '—' }}
                            </td>
                            <td class="px-4 py-3 text-right">
                                {# L'administrateur passe par les mêmes routes que l'agent d'accueil : la voter
                                   CandidatureVoter lui accorde VIEW et EDIT sur tout dossier, quel que soit le centre. #}
                                <div class="inline-flex items-center justify-end gap-2">
                                    {{ ui.bouton_lien(path('app_accueil_candidature', {id: candidature.id, mode: 'lecture'}), 'eye', 'Consulter', 'indigo', 'le dossier ' ~ candidature.numero) }}
                                    {% if is_granted('CANDIDATURE_EDIT', candidature) %}
                                        {{ ui.bouton_lien(path('app_accueil_candidature_modifier', {id: candidature.id}), 'pen', 'Modifier', 'amber', 'le dossier ' ~ candidature.numero) }}
                                    {% endif %}
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        {# ===== Liste empilée, sur petit écran ===== #}
        <ul class="lg:hidden divide-y divide-slate-100">
            {% for candidature in pagination.items %}
                <li class="px-4 py-4">
                    <div class="flex items-start justify-between gap-3">
                        <div class="min-w-0">
                            <p class="font-mono text-xs font-semibold text-slate-900 tabular-nums">{{ candidature.numero }}</p>
                            <p class="text-sm font-medium text-slate-800 mt-1 truncate">
                                {{ candidature.user ? candidature.user.nomComplet : '—' }}
                            </p>
                            <p class="text-xs text-slate-600 mt-0.5">
                                {{ candidature.centre ? candidature.centre.nom : '—' }}
                                · {{ candidature.metier ? candidature.metier.libelle : '—' }}
                            </p>
                            {% if candidature.creation %}
                                <p class="text-xs text-slate-600 mt-0.5 tabular-nums">
                                    Déposé le {{ candidature.creation|date('d/m/Y') }}
                                </p>
                            {% endif %}
                        </div>
                        <div class="shrink-0">
                            {{ include('partials/_statut_badge.html.twig', { statut: statut_candidature(candidature) }) }}
                        </div>
                    </div>
                    <div class="mt-3 grid grid-cols-2 gap-2">
                        {{ ui.bouton_lien(path('app_accueil_candidature', {id: candidature.id, mode: 'lecture'}), 'eye', 'Consulter', 'indigo', 'le dossier ' ~ candidature.numero) }}
                        {% if is_granted('CANDIDATURE_EDIT', candidature) %}
                            {{ ui.bouton_lien(path('app_accueil_candidature_modifier', {id: candidature.id}), 'pen', 'Modifier', 'amber', 'le dossier ' ~ candidature.numero) }}
                        {% endif %}
                    </div>
                </li>
            {% endfor %}
        </ul>

        {{ ui.pagination(pagination) }}
    {% else %}
        {{ ui.etat_vide(
            'folder-open',
            'Aucun dossier',
            recherche or filtre_centre
                ? 'Aucun dossier ne correspond à ces critères. Élargissez la recherche ou réinitialisez les filtres.'
                : 'Aucun dossier ne se trouve à cette étape du parcours pour le moment.'
        ) }}
    {% endif %}
</div>
{% endblock %}
