{# Écran E6.5 : rapport détaillé d'un import (F6.7). #}
{% extends 'base_dashboard.html.twig' %}
{% import 'partials/_ui.html.twig' as ui %}

{% block title %}Rapport d'import — Administration VAE{% endblock %}

{% block body %}
{{ ui.bandeau(
    'Rapport d\'import',
    import.nomFichier ~ ' — ' ~ import.type.libelle,
    'file-lines'
) }}

{% if import.statut.value == 'annule' %}
    <div class="mb-6 rounded-lg bg-red-50 border border-red-200 p-4">
        <div class="flex items-start gap-3">
            <i class="fas fa-circle-xmark text-red-500 mt-0.5"></i>
            <div>
                <p class="text-sm font-semibold text-red-900">Import annulé</p>
                <p class="text-xs text-red-800 mt-1 leading-relaxed">
                    Le taux d'erreur dépassait le seuil admis : <strong>aucune décision n'a été
                    appliquée</strong>. Corrigez le fichier d'après le détail ci-dessous, puis relancez l'import.
                </p>
            </div>
        </div>
    </div>
{% endif %}

{# ===== Compteurs ===== #}
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 mb-8">
    {{ ui.stat('Lignes lues', import.lignesTotal, 'list', 'indigo') }}
    {{ ui.stat('Décisions appliquées', import.lignesTraitees, 'circle-check', 'green') }}
    {{ ui.stat('Lignes ignorées', import.lignesIgnorees, 'circle-minus', 'amber') }}
    {{ ui.stat('Lignes en erreur', import.lignesErreur, 'circle-exclamation', 'red') }}
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    {# ===== Détail des anomalies ===== #}
    <div class="lg:col-span-2 bg-white rounded-lg border border-slate-200 overflow-hidden">
        <div class="px-6 py-5 border-b border-slate-200">
            <h2 class="text-sm font-bold text-slate-800">Lignes à examiner</h2>
            <p class="text-xs text-slate-600 mt-0.5">
                Seules les lignes ignorées ou en erreur sont détaillées ici
            </p>
        </div>

        {% if anomalies is not empty %}
            <div class="overflow-x-auto">
                <table class="w-full min-w-[720px]">
                    <thead class="bg-slate-50 border-b border-slate-200">
                        <tr>
                            {{ ui.th('Ligne') }}
                            {{ ui.th('Numéro VAE') }}
                            {{ ui.th('Décision') }}
                            {{ ui.th('Motif') }}
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        {% for ligne in anomalies %}
                            {% set erreur = ligne.issue == 'erreur' %}
                            <tr class="{{ erreur ? 'bg-red-50/40' : '' }}">
                                <td class="px-6 py-4 text-xs text-slate-500 tabular-nums">
                                    {{ ligne.numero ?? '—' }}
                                </td>
                                <td class="px-6 py-4">
                                    <span class="font-mono text-xs {{ erreur ? 'text-red-700' : 'text-slate-600' }}">
                                        {{ ligne.numero_vae ?: '—' }}
                                    </span>
                                    {% if ligne.candidat is defined and ligne.candidat %}
                                        <p class="text-xs text-slate-600 mt-0.5">{{ ligne.candidat }}</p>
                                    {% endif %}
                                </td>
                                <td class="px-6 py-4">
                                    <span class="text-xs font-mono text-slate-500">{{ ligne.decision ?: '—' }}</span>
                                </td>
                                <td class="px-6 py-4">
                                    <div class="flex items-start gap-2">
                                        <i class="fas fa-{{ erreur ? 'circle-exclamation text-red-500' : 'circle-minus text-amber-500' }} text-xs mt-0.5 shrink-0"></i>
                                        <p class="text-xs leading-relaxed {{ erreur ? 'text-red-800' : 'text-slate-600' }}">
                                            {{ ligne.motif }}
                                        </p>
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% else %}
            {{ ui.etat_vide(
                'circle-check',
                'Aucune anomalie',
                'Toutes les lignes du fichier ont été traitées sans réserve.'
            ) }}
        {% endif %}
    </div>

    {# ===== Récapitulatif ===== #}
    <div class="space-y-6">
        <div class="bg-white rounded-lg border border-slate-200 overflow-hidden">
            <div class="px-6 py-5 border-b border-slate-200">
                <h2 class="text-sm font-bold text-slate-800">Import</h2>
            </div>
            <dl class="divide-y divide-slate-100">
                {% set lignes = {
                    'Type': import.type.libelle,
                    'Fichier': import.nomFichier,
                    'Statut': import.statut.libelle,
                    'Réalisé par': import.auteur ? import.auteur.nomComplet : '—',
                    'Date': import.creation|date('d/m/Y à H\\hi')
                } %}
                {% for libelle, valeur in lignes %}
                    <div class="px-6 py-3.5 flex items-start justify-between gap-3">
                        <dt class="text-xs text-slate-600 shrink-0">{{ libelle }}</dt>
                        <dd class="text-xs font-semibold text-slate-700 text-right break-all">{{ valeur }}</dd>
                    </div>
                {% endfor %}
            </dl>
        </div>

        <div class="flex flex-col gap-3">
            <a href="{{ path('app_admin_jury_' ~ import.type.value) }}"
               class="inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-lg text-sm font-medium
                      text-slate-600 bg-slate-100 hover:bg-slate-200 transition duration-200">
                <i class="fas fa-arrow-left text-xs"></i>Retour à l'import
            </a>
            <a href="{{ path('app_admin_dashboard') }}"
               class="inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-lg text-sm font-medium text-white
                      bg-indigo-600 hover:bg-indigo-700 transition duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-600 focus-visible:ring-offset-2">
                <i class="fas fa-chart-column text-xs"></i>Voir le suivi national
            </a>
        </div>
    </div>
</div>
{% endblock %}
