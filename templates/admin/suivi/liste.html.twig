{#
    Liste nationale des candidats ayant franchi une étape de décision.

    Gabarit générique : SuiviController le sert pour « recevables » comme pour
    « éligibles ». Titre, description, icône et route d'export lui sont passés,
    de sorte qu'une nouvelle liste ne demande pas un nouveau gabarit.
#}
{% extends 'base_dashboard.html.twig' %}
{% import 'partials/_ui.html.twig' as ui %}

{% block title %}{{ titre }} — Administration VAE{% endblock %}

{% block body %}
{{ ui.bandeau(
    titre,
    filtre_centre ? filtre_centre.nom : 'Tous les centres',
    icone,
    candidatures|length,
    'candidat(s)'
) }}

<div class="bg-white rounded-lg border border-slate-200 overflow-hidden">
    <div class="px-6 py-5 border-b border-slate-200 flex flex-col lg:flex-row lg:items-center justify-between gap-4">
        <form method="get" class="flex flex-col sm:flex-row gap-3">
            <select name="centre" onchange="this.form.submit()"
                    class="px-3.5 py-2.5 rounded-lg border border-slate-500 text-sm text-slate-700 bg-white
                           focus:outline-none focus:ring-2 focus:ring-indigo-600 focus:border-indigo-600 transition duration-200">
                <option value="">Tous les centres</option>
                {% for centre in centres %}
                    <option value="{{ centre.id }}" {{ filtre_centre and filtre_centre.id == centre.id ? 'selected' : '' }}>
                        {{ centre.nom }}
                    </option>
                {% endfor %}
            </select>
            <button type="submit"
                    class="px-4 py-2.5 rounded-lg text-sm font-medium text-slate-600 bg-slate-100 hover:bg-slate-200 transition duration-200">
                Filtrer
            </button>
        </form>

        <div class="flex gap-2 shrink-0">
            <a href="{{ path(route, filtre_centre ? {centre: filtre_centre.id, export: 'excel'} : {export: 'excel'}) }}"
               class="inline-flex items-center gap-2 px-4 py-2.5 rounded-lg text-sm font-medium
                      text-green-700 bg-green-50 border border-green-200 hover:bg-green-100 transition duration-200">
                <i class="fas fa-file-excel text-xs"></i>Excel
            </a>
            <a href="{{ path(route, filtre_centre ? {centre: filtre_centre.id, export: 'pdf'} : {export: 'pdf'}) }}"
               target="_blank" rel="noopener"
               class="inline-flex items-center gap-2 px-4 py-2.5 rounded-lg text-sm font-medium
                      text-red-700 bg-red-50 border border-red-200 hover:bg-red-100 transition duration-200">
                <i class="fas fa-file-pdf text-xs"></i>PDF
            </a>
        </div>
    </div>

    {% if candidatures is not empty %}
        <div class="overflow-x-auto">
            <table class="w-full min-w-[900px]">
                <thead class="bg-slate-50 border-b border-slate-200">
                    <tr>
                        {{ ui.th('Numéro') }}
                        {{ ui.th('Candidat') }}
                        {{ ui.th('Centre') }}
                        {{ ui.th('Métier') }}
                        {{ ui.th('Diplôme') }}
                        {{ ui.th('Statut') }}
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    {% for candidature in candidatures %}
                        <tr class="hover:bg-slate-50/70 transition duration-200">
                            <td class="px-6 py-4">
                                <span class="font-mono text-xs font-semibold text-indigo-600">{{ candidature.numero }}</span>
                            </td>
                            <td class="px-6 py-4">
                                <p class="text-sm text-slate-700">
                                    {{ candidature.user ? candidature.user.nomComplet : '—' }}
                                </p>
                                <p class="text-xs text-slate-600 mt-0.5">
                                    {{ candidature.user and candidature.user.contact ? candidature.user.contact : '—' }}
                                </p>
                            </td>
                            <td class="px-6 py-4 text-sm text-slate-600">
                                {{ candidature.centre ? candidature.centre.nom : '—' }}
                            </td>
                            <td class="px-6 py-4 text-sm text-slate-600">
                                {{ candidature.metier ? candidature.metier.libelle : '—' }}
                            </td>
                            <td class="px-6 py-4 text-sm text-slate-600">{{ candidature.diplomedemande ?: '—' }}</td>
                            <td class="px-6 py-4">
                                {{ include('partials/_statut_badge.html.twig', { statut: statut_candidature(candidature) }) }}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% else %}
        {{ ui.etat_vide(
            icone,
            'Aucun candidat',
            filtre_centre
                ? 'Aucun dossier de ce centre n\'a encore franchi cette étape du parcours.'
                : description
        ) }}
    {% endif %}
</div>
{% endblock %}
