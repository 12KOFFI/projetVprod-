{# Détail d'un règlement et journal de ses échanges avec la passerelle (F5.7). #}
{% extends 'base_dashboard.html.twig' %}
{% import 'partials/_ui.html.twig' as ui %}

{% block title %}Règlement {{ paiement.referencePaiement }} — Administration VAE{% endblock %}

{% block body %}
{{ ui.bandeau(
    paiement.type.libelle,
    'Dossier ' ~ (candidature ? candidature.numero : '—')
        ~ ' — ' ~ (candidature and candidature.user ? candidature.user.nomComplet : 'candidat inconnu'),
    'receipt'
) }}

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    {# ===== Journal des transactions ===== #}
    <div class="lg:col-span-2 bg-white rounded-lg border border-slate-200 overflow-hidden">
        <div class="px-6 py-5 border-b border-slate-200">
            <h2 class="text-sm font-bold text-slate-800">Journal des transactions</h2>
            <p class="text-xs text-slate-600 mt-0.5">
                Chaque échange avec la passerelle, réponse du fournisseur comprise
            </p>
        </div>

        {% if transactions is not empty %}
            <div class="divide-y divide-slate-100">
                {% for transaction in transactions %}
                    <div class="px-6 py-4" x-data="{ ouvert: false }">
                        <div class="flex flex-wrap items-center justify-between gap-3">
                            <div class="min-w-0">
                                <div class="flex flex-wrap items-center gap-2">
                                    {{ ui.badge(transaction.statut.libelle, transaction.statut.couleur) }}
                                    <span class="font-mono text-xs text-slate-500">{{ transaction.reference }}</span>
                                </div>
                                <p class="text-xs text-slate-600 mt-1.5">
                                    {{ transaction.creation|date('d/m/Y à H\\hi\\ms') }}
                                    · {{ transaction.passerelle }}
                                    {% if transaction.adresseIp %} · {{ transaction.adresseIp }}{% endif %}
                                </p>
                                {% if transaction.messageErreur %}
                                    <p class="text-xs text-red-600 mt-1.5">
                                        <i class="fas fa-circle-exclamation mr-1"></i>
                                        {{ transaction.codeErreur }} — {{ transaction.messageErreur }}
                                    </p>
                                {% endif %}
                            </div>

                            {% if transaction.reponseFournisseur %}
                                <button type="button" @click="ouvert = !ouvert"
                                        class="text-xs font-medium text-indigo-600 hover:text-indigo-700 transition duration-200 shrink-0">
                                    <span x-text="ouvert ? 'Masquer' : 'Réponse brute'"></span>
                                    <i class="fas fa-chevron-down ml-1 text-xs transition-transform duration-200"
                                       :class="{ 'rotate-180': ouvert }"></i>
                                </button>
                            {% endif %}
                        </div>

                        {% if transaction.reponseFournisseur %}
                            <pre x-show="ouvert" x-cloak x-transition
                                 class="mt-3 p-3 rounded-lg bg-slate-900 text-slate-200 text-xs overflow-x-auto"
                            >{{ transaction.reponseFournisseur|json_encode(constant('JSON_PRETTY_PRINT') b-or constant('JSON_UNESCAPED_UNICODE') b-or constant('JSON_UNESCAPED_SLASHES')) }}</pre>
                        {% endif %}
                    </div>
                {% endfor %}
            </div>
        {% else %}
            {{ ui.etat_vide('receipt', 'Aucune transaction', 'Ce règlement n\'a encore donné lieu à aucun échange.') }}
        {% endif %}
    </div>

    {# ===== Récapitulatif ===== #}
    <div class="space-y-6">
        <div class="bg-white rounded-lg border border-slate-200 overflow-hidden">
            <div class="px-6 py-5 border-b border-slate-200">
                <h2 class="text-sm font-bold text-slate-800">Règlement</h2>
            </div>
            <dl class="divide-y divide-slate-100">
                {% set lignes = {
                    'Montant': (paiement.montant|number_format(0, ',', ' ')) ~ ' ' ~ paiement.devise,
                    'Statut': paiement.statut.libelle,
                    'Référence': paiement.referencePaiement,
                    'Identifiant externe': paiement.identifiantExterne,
                    'Moyen': paiement.moyenPaiement ? paiement.moyenPaiement.libelle : null,
                    'Tentatives': paiement.tentatives,
                    'Initié le': paiement.dateInitiation ? paiement.dateInitiation|date('d/m/Y à H\\hi') : null,
                    'Réglé le': paiement.datePaiement ? paiement.datePaiement|date('d/m/Y à H\\hi') : null
                } %}
                {% for libelle, valeur in lignes %}
                    <div class="px-6 py-3.5 flex items-start justify-between gap-3">
                        <dt class="text-xs text-slate-600 shrink-0">{{ libelle }}</dt>
                        <dd class="text-xs font-semibold text-slate-700 text-right break-all">{{ valeur ?: '—' }}</dd>
                    </div>
                {% endfor %}
            </dl>
        </div>

        {% if paiement.statut.value == 'reussi' %}
            <div class="bg-white rounded-lg border border-slate-200 p-5">
                <p class="text-xs font-semibold uppercase tracking-wide text-slate-600">Remboursement</p>
                <p class="text-xs text-slate-500 mt-2 leading-relaxed">
                    Le remboursement crée une transaction inverse. Il ne fait pas revenir le dossier
                    en arrière : l'avancement déjà acquis est conservé.
                </p>

                <form method="post" action="{{ path('app_admin_paiement_rembourser', {id: paiement.id}) }}" class="mt-4"
                      onsubmit="return confirm('Rembourser définitivement ce règlement ?');">
                    <input type="hidden" name="_token" value="{{ csrf_token('rembourser_' ~ paiement.id) }}">
                    <button type="submit"
                            class="w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-lg text-sm font-medium
                                   text-red-700 bg-red-50 border border-red-200 hover:bg-red-100 transition duration-200">
                        <i class="fas fa-rotate-left text-xs"></i>Rembourser
                    </button>
                </form>
            </div>
        {% endif %}

        <a href="{{ path('app_admin_paiement_index') }}"
           class="w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-lg text-sm font-medium
                  text-slate-600 bg-slate-100 hover:bg-slate-200 transition duration-200">
            <i class="fas fa-arrow-left text-xs"></i>Retour à la liste
        </a>
    </div>
</div>
{% endblock %}
