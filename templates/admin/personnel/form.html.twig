{# Écran E2.8 : création et modification d'un compte du personnel. #}
{% extends 'base_dashboard.html.twig' %}
{% import 'partials/_ui.html.twig' as ui %}

{% block title %}{{ creation ? 'Nouveau compte' : 'Modifier un compte' }} — Administration VAE{% endblock %}

{% block body %}
{{ ui.bandeau(
    creation ? 'Nouveau compte du personnel' : 'Modifier un compte',
    creation
        ? 'Le mot de passe initial sera généré automatiquement et affiché une seule fois.'
        : utilisateur.nomComplet,
    'user-plus'
) }}

<div class="max-w-3xl">
    <a href="{{ path('app_admin_personnel_index') }}"
       class="inline-flex items-center gap-2 text-sm text-slate-500 hover:text-indigo-600 transition duration-200 mb-5">
        <i class="fas fa-arrow-left text-xs"></i>
        Retour aux comptes
    </a>

    {#
      Le champ métier n'est requis que pour un accompagnateur (V1.3 de M1) : Alpine
      le met en évidence selon le rôle choisi, la validation serveur restant seule
      juge (règle transverse S2).
    #}
    {{ form_start(form, {attr: {
        class: 'space-y-6',
        'x-data': '{ role: ' ~ (form.role.vars.value ? '"' ~ form.role.vars.value ~ '"' : '""') ~ ' }'
    }}) }}

        <div class="bg-white rounded-lg border border-slate-200 overflow-hidden">
            <div class="px-6 py-4 border-b border-slate-200 bg-slate-50">
                <h2 class="text-xs font-semibold uppercase tracking-wide text-slate-600">
                    Rôle et rattachement
                </h2>
            </div>

            <div class="px-6 py-6 md:px-8 grid grid-cols-1 md:grid-cols-2 gap-5">
                <div class="md:col-span-2">
                    {{ form_label(form.role, null, {label_attr: {class: 'block text-xs font-semibold text-slate-600 mb-1.5'}}) }}
                    {{ form_widget(form.role, {attr: {
                        'x-model': 'role',
                        class: 'w-full px-3.5 py-2.5 rounded-lg border border-slate-500 text-sm text-slate-700 bg-white
                                focus:outline-none focus:ring-2 focus:ring-indigo-600 focus:border-indigo-600 transition duration-200'
                    }}) }}
                    <p class="text-xs text-slate-600 mt-1.5">{{ form.role.vars.help }}</p>
                    {{ form_errors(form.role) }}
                </div>

                <div x-show="role !== 'ROLE_ADMIN'">
                    {{ ui.champ(form.centre) }}
                </div>

                <div x-show="role === 'ROLE_ACCOMPAGNATEUR'" style="display: none">
                    {{ ui.champ(form.metier) }}
                </div>
            </div>
        </div>

        <div class="bg-white rounded-lg border border-slate-200 overflow-hidden">
            <div class="px-6 py-4 border-b border-slate-200 bg-slate-50">
                <h2 class="text-xs font-semibold uppercase tracking-wide text-slate-600">
                    Identité et contact
                </h2>
            </div>

            <div class="px-6 py-6 md:px-8 grid grid-cols-1 md:grid-cols-2 gap-5">
                {{ ui.champ(form.nom) }}
                {{ ui.champ(form.prenoms) }}
                {{ ui.champ(form.nomJeuneFille) }}
                {{ ui.champ(form.email) }}
                {{ ui.champ(form.contact) }}
                {{ ui.champ(form.sexe) }}
                {{ ui.champ(form.datenaissance) }}
                {{ ui.champ(form.lieunaissance) }}
                {{ ui.champ(form.nationalite) }}
                {{ ui.champ(form.situationmat) }}
                {{ ui.champ(form.residence) }}
                {{ ui.champ(form.boitePostale) }}
            </div>
        </div>

        {% if creation %}
            <div class="rounded-lg bg-amber-50 border border-amber-200 px-5 py-4">
                <p class="text-xs font-semibold text-amber-800 flex items-center gap-2">
                    <i class="fas fa-key"></i>
                    Mot de passe initial
                </p>
                <p class="text-xs text-amber-700 mt-1.5 leading-relaxed">
                    Un mot de passe aléatoire sera généré à l'enregistrement et affiché une
                    seule fois. Communiquez-le hors bande : son changement sera demandé à la
                    première connexion.
                </p>
            </div>
        {% endif %}

        <div class="flex items-center justify-end gap-3">
            <a href="{{ path('app_admin_personnel_index') }}"
               class="px-4 py-2.5 rounded-lg text-sm font-medium text-slate-500 hover:bg-slate-100 transition duration-200">
                Annuler
            </a>
            <button type="submit"
                    class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg text-sm font-medium text-white
                           bg-indigo-600 hover:bg-indigo-700 transition duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-600 focus-visible:ring-offset-2">
                <i class="fas fa-check text-xs"></i>
                {{ creation ? 'Créer le compte' : 'Enregistrer les modifications' }}
            </button>
        </div>
    {{ form_end(form) }}
</div>
{% endblock %}
