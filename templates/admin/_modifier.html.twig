{#
  Écran de modification commun aux référentiels (E2.1 à E2.5).
  Attend : titre, sous_titre, icone, form, route_retour, champs (liste de noms).
#}
{% extends 'base_dashboard.html.twig' %}
{% import 'partials/_ui.html.twig' as ui %}

{% block title %}{{ titre }} — Administration VAE{% endblock %}

{% block body %}
{{ ui.bandeau(titre, sous_titre, icone, '', '') }}

<div class="max-w-2xl">
    <a href="{{ path(route_retour) }}"
       class="inline-flex items-center gap-2 text-sm text-slate-500 hover:text-indigo-600 transition duration-200 mb-5">
        <i class="fas fa-arrow-left text-xs"></i>
        Retour à la liste
    </a>

    <div class="bg-white rounded-lg border border-slate-200 overflow-hidden">
        {{ form_start(form, {attr: {class: 'px-6 py-6 md:px-8 md:py-7 space-y-5'}}) }}
            {% for nom in champs %}
                {{ ui.champ(attribute(form, nom)) }}
            {% endfor %}

            <div class="flex items-center justify-end gap-3 pt-3 border-t border-slate-100">
                <a href="{{ path(route_retour) }}"
                   class="px-4 py-2.5 rounded-lg text-sm font-medium text-slate-500 hover:bg-slate-100 transition duration-200">
                    Annuler
                </a>
                <button type="submit"
                        class="inline-flex items-center gap-2 px-4 py-2.5 rounded-lg text-sm font-medium text-white
                               bg-indigo-600 hover:bg-indigo-700 transition duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-600 focus-visible:ring-offset-2">
                    <i class="fas fa-check text-xs"></i>
                    Enregistrer les modifications
                </button>
            </div>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
