{# Écran E2.6 : offre de formation d'un centre — quels métiers, combien de places. #}
{% extends 'base_dashboard.html.twig' %}
{% import 'partials/_ui.html.twig' as ui %}

{% block title %}Offre de {{ centre.nom }} — Administration VAE{% endblock %}

{% block body %}
<div x-data="{ modale: {{ form.vars.submitted and not form.vars.valid ? 'true' : 'false' }} }">

    {{ ui.bandeau(
        centre.nom,
        'Métiers ouverts dans ce centre'
            ~ (centre.localite ? ' — ' ~ centre.localite.libelle : ''),
        'list-check',
        offre|length,
        'métier(s) ouvert(s)'
    ) }}

    <a href="{{ path('app_admin_centre_index') }}"
       class="inline-flex items-center gap-2 text-sm text-slate-500 hover:text-indigo-600 transition duration-200 mb-5">
        <i class="fas fa-arrow-left text-xs"></i>
        Retour aux centres
    </a>

    <div class="bg-white rounded-lg border border-slate-200 overflow-hidden">
        <div class="px-6 py-5 border-b border-slate-200 flex flex-col md:flex-row md:items-center justify-between gap-4">
            <div>
                <h2 class="text-sm font-semibold text-slate-700">Offre de formation</h2>
                <p class="text-xs text-slate-600 mt-0.5">
                    Un candidat ne peut choisir qu'un métier ouvert dans son centre.
                </p>
            </div>

            <button type="button" @click="modale = true"
                    class="inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-lg text-sm font-medium text-white
                           bg-indigo-600 hover:bg-indigo-700 transition duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-600 focus-visible:ring-offset-2">
                <i class="fas fa-plus text-xs"></i>
                Ouvrir un métier
            </button>
        </div>

        {% if offre|length > 0 %}
            <div class="overflow-x-auto">
                <table class="w-full min-w-[720px]">
                    <thead class="bg-slate-50 border-b border-slate-200">
                        <tr>
                            {{ ui.th('Métier') }}
                            {{ ui.th('Filière') }}
                            {{ ui.th('Statut du métier') }}
                            {{ ui.th('Places') }}
                            {{ ui.th('Actions', 'text-right') }}
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        {% for ligne in offre %}
                            <tr class="hover:bg-slate-50/70 transition duration-200">
                                <td class="px-6 py-4 text-sm font-medium text-slate-700">
                                    {{ ligne.metier ? ligne.metier.libelle : '—' }}
                                </td>
                                <td class="px-6 py-4 text-sm text-slate-500">
                                    {{ ligne.metier and ligne.metier.filiere ? ligne.metier.filiere.libelle : '—' }}
                                </td>
                                <td class="px-6 py-4">
                                    {% if ligne.metier and ligne.metier.statut == 'actif' %}
                                        {{ ui.badge('Actif', 'green') }}
                                    {% else %}
                                        {{ ui.badge('Inactif', 'amber') }}
                                    {% endif %}
                                </td>
                                <td class="px-6 py-4">
                                    {# Mise à jour du nombre de places sans quitter la liste (POST + CSRF). #}
                                    <form method="post"
                                          action="{{ path('app_admin_centre_metier_modifier', {id: centre.id, offre: ligne.id}) }}"
                                          class="flex items-center gap-2">
                                        <input type="hidden" name="_token" value="{{ csrf_token('places_offre_' ~ ligne.id) }}">
                                        <input type="number" name="nbrplace" min="1" value="{{ ligne.nbrplace }}"
                                               class="w-20 px-2.5 py-1.5 rounded-lg border border-slate-500 text-sm text-slate-700 font-mono
                                                      focus:outline-none focus:ring-2 focus:ring-indigo-600 focus:border-indigo-600 transition duration-200">
                                        <button type="submit" title="Mettre à jour les places" aria-label="Mettre à jour les places"
                                                class="inline-flex items-center justify-center w-8 h-8 rounded-lg bg-indigo-50 text-indigo-600
                                                       hover:bg-indigo-100 transition-all duration-150">
                                            <i class="fas fa-check text-xs"></i>
                                        </button>
                                    </form>
                                </td>
                                <td class="px-6 py-4">
                                    <div class="flex items-center justify-end gap-2">
                                        {{ ui.bouton_post(
                                            path('app_admin_centre_metier_supprimer', {id: centre.id, offre: ligne.id}),
                                            'supprimer_offre_' ~ ligne.id,
                                            'trash', 'Retirer de l\'offre', 'red',
                                            'Retirer ce métier de l\'offre de ce centre ?'
                                        ) }}
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% else %}
            {{ ui.etat_vide(
                'list-check',
                'Aucun métier ouvert',
                'Tant qu\'aucun métier n\'est ouvert dans ce centre, aucun candidat ne peut y déposer de dossier.',
                'Utilisez le bouton « Ouvrir un métier »'
            ) }}
        {% endif %}
    </div>

    <div x-show="modale" style="display: none" class="fixed inset-0 z-40 flex items-center justify-center p-4">
        <div class="absolute inset-0 bg-slate-900/50 backdrop-blur-sm" @click="modale = false"></div>

        <div x-show="modale"
             x-transition:enter="transition ease-out duration-200"
             x-transition:enter-start="opacity-0 translate-y-3"
             x-transition:enter-end="opacity-100 translate-y-0"
             class="relative bg-white rounded-lg shadow-xl border border-slate-200 w-full max-w-md">
            <div class="px-6 py-5 border-b border-slate-200 flex items-center justify-between">
                <h2 class="text-base font-semibold text-slate-800">Ouvrir un métier</h2>
                <button type="button" @click="modale = false"
                        class="w-8 h-8 rounded-lg bg-slate-100 text-slate-600 hover:bg-slate-200 transition duration-150">
                    <i class="fas fa-xmark text-xs"></i>
                </button>
            </div>

            {{ form_start(form, {attr: {class: 'px-6 py-6 space-y-5'}}) }}
                {{ ui.champ(form.metier) }}
                {{ ui.champ(form.nbrplace) }}

                <div class="flex items-center justify-end gap-3 pt-2">
                    <button type="button" @click="modale = false"
                            class="px-4 py-2.5 rounded-lg text-sm font-medium text-slate-500 hover:bg-slate-100 transition duration-200">
                        Annuler
                    </button>
                    <button type="submit"
                            class="inline-flex items-center gap-2 px-4 py-2.5 rounded-lg text-sm font-medium text-white
                                   bg-indigo-600 hover:bg-indigo-700 transition duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-600 focus-visible:ring-offset-2">
                        <i class="fas fa-check text-xs"></i>
                        Ouvrir ce métier
                    </button>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}
