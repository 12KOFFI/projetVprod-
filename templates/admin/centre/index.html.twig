{# Écran E2.5 : liste des centres filtrable par direction régionale, localité et type. #}
{% extends 'base_dashboard.html.twig' %}
{% import 'partials/_ui.html.twig' as ui %}

{% block title %}Centres — Administration VAE{% endblock %}

{% block body %}
<div x-data="{ modale: {{ form.vars.submitted and not form.vars.valid ? 'true' : 'false' }} }">

    {{ ui.bandeau(
        'Centres',
        'Établissements de formation et entreprises accueillant les candidats.',
        'building',
        pagination.getTotalItemCount,
        'enregistré(s)'
    ) }}

    <div class="bg-white rounded-lg border border-slate-200 overflow-hidden">
        <div class="px-6 py-5 border-b border-slate-200 flex flex-col lg:flex-row lg:items-center justify-between gap-4">
            {#
              Le filtre localité est repeuplé par l'endpoint F2.8 quand la direction
              régionale change : la liste complète serait ingérable à l'échelle du pays.
            #}
            <form method="get" class="flex flex-col sm:flex-row gap-3 flex-1"
                  x-data="{
                      localites: [],
                      async chargerLocalites(id) {
                          this.localites = [];
                          if (!id) return;
                          const reponse = await fetch('/admin/api/directions-regionales/' + id + '/localites');
                          if (reponse.ok) { this.localites = await reponse.json(); }
                      }
                  }">
                <div class="relative flex-1 max-w-xs">
                    <i class="fas fa-magnifying-glass absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-500 text-sm"></i>
                    <input type="search" name="q" value="{{ recherche }}" placeholder="Rechercher un centre"
                           class="w-full pl-10 pr-3.5 py-2.5 rounded-lg border border-slate-500 text-sm text-slate-700
                                  focus:outline-none focus:ring-2 focus:ring-indigo-600 focus:border-indigo-600 transition duration-200">
                </div>

                <select name="dr" @change="chargerLocalites($event.target.value)"
                        class="px-3.5 py-2.5 rounded-lg border border-slate-500 text-sm text-slate-700 bg-white
                               focus:outline-none focus:ring-2 focus:ring-indigo-600 focus:border-indigo-600 transition duration-200">
                    <option value="">Toutes les directions régionales</option>
                    {% for dr in directions_regionales %}
                        <option value="{{ dr.id }}" {{ filtre_dr and filtre_dr.id == dr.id ? 'selected' : '' }}>
                            {{ dr.libelle }}
                        </option>
                    {% endfor %}
                </select>

                {#
                  Deux listes exclusives plutôt qu'un select réécrit par Alpine :
                  celle du serveur reflète le filtre courant, celle de l'endpoint
                  prend le relais dès que la direction régionale change.
                #}
                <select name="localite" x-show="localites.length === 0" :disabled="localites.length > 0"
                        class="px-3.5 py-2.5 rounded-lg border border-slate-500 text-sm text-slate-700 bg-white
                               focus:outline-none focus:ring-2 focus:ring-indigo-600 focus:border-indigo-600 transition duration-200">
                    <option value="">Toutes les localités</option>
                    {% for localite in localites %}
                        <option value="{{ localite.id }}" {{ filtre_localite and filtre_localite.id == localite.id ? 'selected' : '' }}>
                            {{ localite.libelle }}
                        </option>
                    {% endfor %}
                </select>

                <select name="localite" x-show="localites.length > 0" style="display: none"
                        :disabled="localites.length === 0"
                        class="px-3.5 py-2.5 rounded-lg border border-slate-500 text-sm text-slate-700 bg-white
                               focus:outline-none focus:ring-2 focus:ring-indigo-600 focus:border-indigo-600 transition duration-200">
                    <option value="">Toutes les localités</option>
                    <template x-for="localite in localites" :key="localite.id">
                        <option :value="localite.id" x-text="localite.libelle"></option>
                    </template>
                </select>

                <select name="type"
                        class="px-3.5 py-2.5 rounded-lg border border-slate-500 text-sm text-slate-700 bg-white
                               focus:outline-none focus:ring-2 focus:ring-indigo-600 focus:border-indigo-600 transition duration-200">
                    <option value="">Tous les types</option>
                    <option value="etablissement" {{ filtre_type == 'etablissement' ? 'selected' : '' }}>Établissement</option>
                    <option value="entreprise" {{ filtre_type == 'entreprise' ? 'selected' : '' }}>Entreprise</option>
                </select>

                <button type="submit"
                        class="px-4 py-2.5 rounded-lg text-sm font-medium text-slate-600 bg-slate-100 hover:bg-slate-200 transition duration-200">
                    Filtrer
                </button>
            </form>

            <button type="button" @click="modale = true"
                    class="inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-lg text-sm font-medium text-white
                           bg-indigo-600 hover:bg-indigo-700 transition duration-200 shrink-0 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-600 focus-visible:ring-offset-2">
                <i class="fas fa-plus text-xs"></i>
                Nouveau centre
            </button>
        </div>

        {% if pagination.getTotalItemCount > 0 %}
            <div class="overflow-x-auto">
                <table class="w-full min-w-[840px]">
                    <thead class="bg-slate-50 border-b border-slate-200">
                        <tr>
                            {{ ui.th('Centre') }}
                            {{ ui.th('Type') }}
                            {{ ui.th('Localité') }}
                            {{ ui.th('Direction régionale') }}
                            {{ ui.th('Actions', 'text-right') }}
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        {% for centre in pagination %}
                            <tr class="hover:bg-slate-50/70 transition duration-200">
                                <td class="px-6 py-4 text-sm font-medium text-slate-700">{{ centre.nom }}</td>
                                <td class="px-6 py-4">
                                    {% if centre.type == 'etablissement' %}
                                        {{ ui.badge('Établissement', 'blue') }}
                                    {% else %}
                                        {{ ui.badge('Entreprise', 'indigo') }}
                                    {% endif %}
                                </td>
                                <td class="px-6 py-4 text-sm text-slate-500">
                                    {{ centre.localite ? centre.localite.libelle : '—' }}
                                </td>
                                <td class="px-6 py-4 text-sm text-slate-600">
                                    {{ centre.localite and centre.localite.directionRegionale
                                        ? centre.localite.directionRegionale.libelle : '—' }}
                                </td>
                                <td class="px-6 py-4">
                                    <div class="flex items-center justify-end gap-2">
                                        {{ ui.bouton_lien(
                                            path('app_admin_centre_metier_index', {id: centre.id}),
                                            'list-check', 'Gérer l\'offre de métiers', 'indigo'
                                        ) }}
                                        {{ ui.bouton_lien(
                                            path('app_admin_centre_modifier', {id: centre.id}),
                                            'pen', 'Modifier'
                                        ) }}
                                        {{ ui.bouton_post(
                                            path('app_admin_centre_supprimer', {id: centre.id}),
                                            'supprimer_centre_' ~ centre.id,
                                            'trash', 'Supprimer', 'red',
                                            'Supprimer « ' ~ centre.nom ~ ' » ?'
                                        ) }}
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>

            {{ ui.pagination(pagination) }}
        {% else %}
            {{ ui.etat_vide(
                'building',
                recherche or filtre_dr or filtre_localite or filtre_type ? 'Aucun résultat' : 'Aucun centre',
                recherche or filtre_dr or filtre_localite or filtre_type
                    ? 'Aucun centre ne correspond aux critères sélectionnés.'
                    : 'Un candidat choisit toujours un centre : créez-en au moins un, puis ouvrez-y des métiers.',
                recherche or filtre_dr or filtre_localite or filtre_type ? null : 'Utilisez le bouton « Nouveau centre »'
            ) }}
        {% endif %}
    </div>

    <div x-show="modale" style="display: none" class="fixed inset-0 z-40 flex items-center justify-center p-4">
        <div class="absolute inset-0 bg-slate-900/50 backdrop-blur-sm" @click="modale = false"></div>

        <div x-show="modale"
             x-transition:enter="transition ease-out duration-200"
             x-transition:enter-start="opacity-0 translate-y-3"
             x-transition:enter-end="opacity-100 translate-y-0"
             class="relative bg-white rounded-lg shadow-xl border border-slate-200 w-full max-w-md">
            <div class="px-6 py-5 border-b border-slate-200 flex items-center justify-between">
                <h2 class="text-base font-semibold text-slate-800">Nouveau centre</h2>
                <button type="button" @click="modale = false"
                        class="w-8 h-8 rounded-lg bg-slate-100 text-slate-600 hover:bg-slate-200 transition duration-150">
                    <i class="fas fa-xmark text-xs"></i>
                </button>
            </div>

            {{ form_start(form, {attr: {class: 'px-6 py-6 space-y-5'}}) }}
                {{ ui.champ(form.type) }}
                {{ ui.champ(form.localite) }}
                {{ ui.champ(form.nom) }}

                <div class="flex items-center justify-end gap-3 pt-2">
                    <button type="button" @click="modale = false"
                            class="px-4 py-2.5 rounded-lg text-sm font-medium text-slate-500 hover:bg-slate-100 transition duration-200">
                        Annuler
                    </button>
                    <button type="submit"
                            class="inline-flex items-center gap-2 px-4 py-2.5 rounded-lg text-sm font-medium text-white
                                   bg-indigo-600 hover:bg-indigo-700 transition duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-600 focus-visible:ring-offset-2">
                        <i class="fas fa-check text-xs"></i>
                        Enregistrer
                    </button>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}
