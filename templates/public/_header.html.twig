<header x-data="{ menuOuvert: false, defile: false, espaceOuvert: false }"
        @scroll.window="defile = window.scrollY > 24"
        class="fixed top-0 inset-x-0 z-50 transition-shadow duration-200"
        :class="defile ? 'shadow-sm' : ''">

    <div class="bg-white/90 backdrop-blur-lg border-b border-slate-200">
        <div class="max-w-6xl mx-auto px-4 sm:px-6">
            <div class="flex items-center justify-between h-[72px] gap-4">

                {# Le logo reste visible sur téléphone (h-8) ; c'est le sous-titre
                   institutionnel qui disparaît sous 768 px pour laisser la place. #}
                <a href="{{ path('app_home') }}" class="flex min-w-0 items-center gap-2.5 sm:gap-3 rounded-lg" aria-label="VAE Côte d'Ivoire — accueil">
                    <img src="{{ asset('image/logo.png') }}" alt="" class="h-8 sm:h-9 w-auto shrink-0" aria-hidden="true">
                    <span class="min-w-0 leading-none">
                        <span class="block text-sm sm:text-[0.95rem] font-extrabold tracking-tight text-slate-800 truncate">VAE Côte d'Ivoire</span>
                        <span class="hidden md:block text-xs font-medium text-slate-500 mt-0.5 whitespace-nowrap">Validation des Acquis de l'Expérience</span>
                    </span>
                </a>

                <nav class="hidden lg:flex items-center gap-1" aria-label="Navigation principale">
                    <a href="{{ path('app_home') }}#session" class="px-3 py-2 rounded-lg text-sm font-medium text-slate-600 hover:text-indigo-700 hover:bg-indigo-50 transition-colors duration-200 whitespace-nowrap">La session</a>
                    <a href="{{ path('app_session_deroulement') }}" class="px-3 py-2 rounded-lg text-sm font-medium text-slate-600 hover:text-indigo-700 hover:bg-indigo-50 transition-colors duration-200 whitespace-nowrap">Déroulement</a>
                    {# Le pied de page (#contact) est inclus sur chaque page publique : ancre locale, sans rechargement. #}
                         <a href="{{ path('app_home') }}#conditions-candidature" class="ml-2 px-4 py-2 rounded-lg text-sm font-semibold text-white bg-[#ED8F33] hover:bg-[#ED8F33]/90 transition-colors duration-200 whitespace-nowrap">Vérifier les conditions</a>
                    <a href="#contact" class="px-3 py-2 rounded-lg text-sm font-medium text-slate-600 hover:text-indigo-700 hover:bg-indigo-50 transition-colors duration-200 whitespace-nowrap">Contact</a>
              
                </nav>

                <div class="flex items-center gap-2 shrink-0 min-w-0">
                    {% if app.user %}
                        <a href="{{ path('app_dashboard') }}"
                           class="hidden sm:inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-indigo-600 text-white text-sm font-semibold hover:bg-indigo-700 transition-colors duration-200">
                            <i class="fas fa-gauge-high" aria-hidden="true"></i>
                            Mon espace
                        </a>
                    {% else %}
                        {# Menu « Mon espace » : un point d'entrée par type de compte, comme sur vae.gouv.fr. #}
                        <div class="relative hidden sm:block" @keydown.escape.window="espaceOuvert = false" @click.outside="espaceOuvert = false">
                            <button type="button"
                                    @click="espaceOuvert = !espaceOuvert"
                                    :aria-expanded="espaceOuvert ? 'true' : 'false'"
                                    aria-haspopup="true" aria-controls="menu-espace"
                                    class="inline-flex min-h-[44px] items-center gap-2 rounded-lg bg-indigo-600 px-4 text-sm font-semibold text-white transition-colors duration-200 hover:bg-indigo-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600">
                                <i class="fas fa-circle-user" aria-hidden="true"></i>
                                Mon espace
                                <i class="fas fa-chevron-down text-xs transition-transform duration-200" :class="espaceOuvert ? 'rotate-180' : ''" aria-hidden="true"></i>
                            </button>

                            <div id="menu-espace" x-show="espaceOuvert" x-cloak
                                 x-transition:enter="transition ease-out duration-150"
                                 x-transition:enter-start="opacity-0 -translate-y-1"
                                 x-transition:enter-end="opacity-100 translate-y-0"
                                 x-transition:leave="transition ease-in duration-100"
                                 x-transition:leave-start="opacity-100 translate-y-0"
                                 x-transition:leave-end="opacity-0 -translate-y-1"
                                 class="absolute right-0 top-full mt-2 w-80 overflow-hidden rounded-lg border border-slate-200 bg-white shadow-lg">
                                <a href="{{ path('app_login') }}" class="flex items-start gap-3 px-4 py-3.5 transition-colors duration-150 hover:bg-indigo-50 focus-visible:outline focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-indigo-600">
                                    <span class="mt-0.5 flex h-10 w-10 shrink-0 items-center justify-center rounded-md bg-indigo-50 text-indigo-700" aria-hidden="true"><i class="fas fa-user"></i></span>
                                    <span>
                                        <span class="block text-sm font-bold text-slate-800">Candidat</span>
                                        <span class="mt-0.5 block text-sm leading-snug text-slate-600">Suivre mon dossier, régler mes frais, voir mes résultats.</span>
                                    </span>
                                </a>
                                <a href="{{ path('app_login', {'profil': 'professionnel'}) }}" class="flex items-start gap-3 border-t border-slate-200 px-4 py-3.5 transition-colors duration-150 hover:bg-indigo-50 focus-visible:outline focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-indigo-600">
                                    <span class="mt-0.5 flex h-10 w-10 shrink-0 items-center justify-center rounded-md bg-indigo-50 text-indigo-700" aria-hidden="true"><i class="fas fa-user-tie"></i></span>
                                    <span>
                                        <span class="block text-sm font-bold text-slate-800">Professionnels de la VAE</span>
                                        <span class="mt-0.5 block text-sm leading-snug text-slate-600">Conseillers, accompagnateurs, agents d'accueil et administrateurs.</span>
                                    </span>
                                </a>
                            </div>
                        </div>
                    {% endif %}

                    <button type="button"
                            @click="menuOuvert = !menuOuvert"
                            :aria-expanded="menuOuvert ? 'true' : 'false'"
                            aria-controls="menu-mobile"
                            class="lg:hidden flex h-11 w-11 items-center justify-center rounded-lg bg-slate-100 text-slate-700 hover:bg-indigo-600 hover:text-white transition-colors duration-200 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600">
                        <span class="sr-only">Ouvrir le menu</span>
                        <i class="fas fa-bars" x-show="!menuOuvert" aria-hidden="true"></i>
                        <i class="fas fa-xmark" x-show="menuOuvert" x-cloak aria-hidden="true"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div id="menu-mobile"
         x-show="menuOuvert"
         x-cloak
         x-transition:enter="transition ease-out duration-200"
         x-transition:enter-start="opacity-0 -translate-y-1"
         x-transition:enter-end="opacity-100 translate-y-0"
         x-transition:leave="transition ease-in duration-150"
         x-transition:leave-start="opacity-100 translate-y-0"
         x-transition:leave-end="opacity-0 -translate-y-1"
         class="lg:hidden bg-white border-b border-slate-200 shadow-lg max-h-[calc(100vh-72px)] overflow-y-auto">
        <nav class="max-w-6xl mx-auto px-4 py-4 flex flex-col gap-1" aria-label="Navigation mobile">
            <a href="{{ path('app_home') }}#session" @click="menuOuvert = false" class="px-4 py-3 rounded-lg text-sm font-medium text-slate-700 hover:bg-indigo-50 hover:text-indigo-700 transition-colors duration-200">La session</a>
            <a href="{{ path('app_session_deroulement') }}" @click="menuOuvert = false" class="px-4 py-3 rounded-lg text-sm font-medium text-slate-700 hover:bg-indigo-50 hover:text-indigo-700 transition-colors duration-200">Déroulement</a>
            <a href="#contact" @click="menuOuvert = false" class="px-4 py-3 rounded-lg text-sm font-medium text-slate-700 hover:bg-indigo-50 hover:text-indigo-700 transition-colors duration-200">Contact</a>

            <div class="h-px bg-slate-200 my-3"></div>

            <a href="{{ path('app_home') }}#conditions-candidature" @click="menuOuvert = false" class="px-4 py-3 rounded-lg bg-[#ED8F33] text-white text-sm font-semibold text-center hover:bg-[#ED8F33]/90 transition-colors duration-200">Vérifier les conditions</a>

            {% if app.user %}
                <a href="{{ path('app_dashboard') }}" class="px-4 py-3 rounded-lg bg-indigo-600 text-white text-sm font-semibold text-center">Mon espace</a>
            {% else %}
                <p class="px-4 pt-2 text-sm font-bold text-slate-800">Mon espace</p>
                <a href="{{ path('app_login') }}" class="flex items-center gap-3 px-4 py-3 rounded-lg bg-slate-100 text-slate-800 text-sm font-semibold hover:bg-indigo-50 transition-colors duration-200">
                    <i class="fas fa-user text-indigo-700" aria-hidden="true"></i>Candidat
                </a>
                <a href="{{ path('app_login', {'profil': 'professionnel'}) }}" class="flex items-center gap-3 px-4 py-3 rounded-lg bg-slate-100 text-slate-800 text-sm font-semibold hover:bg-indigo-50 transition-colors duration-200">
                    <i class="fas fa-user-tie text-indigo-700" aria-hidden="true"></i>Professionnels de la VAE
                </a>
            {% endif %}
        </nav>
    </div>
</header>

{# Compense la hauteur de l'en-tête fixe. #}
<div class="h-[72px]" aria-hidden="true"></div>
