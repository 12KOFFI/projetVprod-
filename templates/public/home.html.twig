{% extends 'public/base.html.twig' %}

{% block title %}VAE Côte d'Ivoire — Session 2026 de certification des compétences{% endblock %}

{% block meta %}
    <meta name="author" content="DAIP — Direction de l'Apprentissage et de l'Insertion Professionnelle">
    <meta name="description" content="Session 2026 de certification des compétences par la VAE : obtenez un CQP ou un CAP grâce à votre expérience. Accueil et inscription du 21 septembre au 17 octobre 2026 dans 30 centres VAE.">
    <meta name="keywords" content="VAE, Côte d'Ivoire, DAIP, session 2026, validation des acquis, CQP, CAP, artisan, certification">
{% endblock %}

{% block body %}
{% import _self as page %}

{# Bouton vers un document officiel de la session. Tant que le document n'est pas
   déposé dans public/document/, le bouton reste visible mais inactif plutôt
   que de mener à une erreur 404. #}
{% macro document(doc, titre, detail) %}
    {% set extension = doc.chemin|split('.')|last|upper %}
    {% if doc.disponible %}
        <a href="{{ asset(doc.chemin) }}" download
           class="group flex flex-wrap items-center gap-x-4 gap-y-3 min-h-[64px] rounded-lg border border-slate-300 bg-white px-4 py-4 text-left transition-colors duration-200 hover:border-indigo-600 hover:bg-indigo-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600 sm:px-5">
            <span class="shrink-0 w-11 h-11 rounded-md bg-indigo-50 border border-indigo-100 flex items-center justify-center text-indigo-700 group-hover:bg-white" aria-hidden="true">
                <i class="fas {{ extension == 'DOCX' ? 'fa-file-word' : 'fa-file-pdf' }} text-lg"></i>
            </span>
            <span class="min-w-0 flex-1 basis-40">
                <span class="block text-base font-bold text-slate-800">{{ titre }}</span>
                <span class="block mt-0.5 text-sm text-slate-600">{{ detail }} · {{ extension }}</span>
            </span>
            <span class="inline-flex min-h-[44px] w-full shrink-0 items-center justify-center gap-2 rounded-md bg-indigo-600 px-3 text-sm font-semibold text-white group-hover:bg-indigo-700 sm:w-auto">
                <i class="fas fa-download" aria-hidden="true"></i>Télécharger
            </span>
            <span class="sr-only">(télécharge le document {{ extension }})</span>
        </a>
    {% else %}
        <div aria-disabled="true"
             class="flex items-center gap-4 rounded-lg border border-slate-200 bg-white px-4 py-4 text-left sm:px-5">
            <span class="shrink-0 w-11 h-11 rounded-md bg-slate-100 border border-slate-200 flex items-center justify-center text-slate-500" aria-hidden="true">
                <i class="fas {{ extension == 'DOCX' ? 'fa-file-word' : 'fa-file-pdf' }} text-lg"></i>
            </span>
            <span class="min-w-0 flex-1">
                <span class="block text-base font-bold text-slate-800">{{ titre }}</span>
                <span class="block mt-0.5 text-sm text-slate-600">{{ detail }} · document {{ extension }} bientôt disponible</span>
            </span>
        </div>
    {% endif %}
{% endmacro %}

{# ============================================================
   1. Annonce de la session
   ============================================================ #}
<section id="session" class="bg-primary-50 border-b border-primary-200 scroll-mt-24">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-8 sm:py-10 md:py-16 grid gap-8 lg:gap-14 lg:grid-cols-12 lg:items-center">

        <div class="lg:col-span-7">
            <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-primary-900 leading-[1.1] text-balance">
                Faites reconnaître votre métier par un diplôme officiel
            </h1>

            <p class="mt-4 sm:mt-5 text-base sm:text-lg leading-relaxed text-slate-700 max-w-[52ch]">
                Avec la VAE, faites valider votre expérience pour obtenir un
                Certificat de Qualification Professionnelle (CQP) ou un
                Certificat d'Aptitude Professionnelle (CAP).
            </p>

            <div class="mt-7 flex items-start gap-4 rounded-lg border border-primary-200 bg-white p-4 sm:p-5">
                <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-md bg-primary-100 text-primary-800" aria-hidden="true">
                    <i class="fas fa-calendar-days text-lg"></i>
                </span>
                <p class="text-base text-slate-700">
                    Accueil et inscription
                    <strong class="block text-lg font-bold text-primary-900 tabular-nums">du 21 septembre au 17 octobre 2026</strong>
                </p>
            </div>

            <div class="mt-6 sm:mt-7 flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-6">
                <a href="#conditions-candidature"
                   class="inline-flex min-h-[52px] w-full items-center justify-center gap-2 rounded-lg bg-primary-800 px-7 text-base font-bold text-white transition-colors duration-200 hover:bg-primary-900 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-800 sm:w-auto">
                    Vérifier les conditions
                    <i class="fas fa-arrow-down text-sm" aria-hidden="true"></i>
                </a>
                <a href="{{ path('app_session_deroulement') }}"
                   class="inline-flex min-h-[44px] items-center justify-center gap-2 rounded-lg px-2 text-base font-semibold text-primary-800 underline underline-offset-4 hover:text-primary-900 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-800">
                    Voir le déroulement
                </a>
            </div>

            {# Sur téléphone, les trois chiffres passent en lignes : en colonnes,
               les libellés se cassent mot à mot sous 360 px. #}
            <dl class="mt-8 sm:mt-9 max-w-lg border-t border-primary-200 pt-2 sm:pt-6 flex flex-col divide-y divide-primary-200 sm:grid sm:grid-cols-3 sm:gap-4 sm:divide-y-0">
                <div class="flex flex-row-reverse items-baseline justify-between gap-3 py-2.5 sm:flex-col-reverse sm:items-start sm:justify-end sm:gap-1 sm:py-0">
                    <dt class="text-sm text-slate-700">travailleurs et artisans</dt>
                    <dd class="text-2xl font-extrabold text-primary-900 tabular-nums">1&nbsp;500</dd>
                </div>
                <div class="flex flex-row-reverse items-baseline justify-between gap-3 py-2.5 sm:flex-col-reverse sm:items-start sm:justify-end sm:gap-1 sm:py-0">
                    <dt class="text-sm text-slate-700">métiers concernés</dt>
                    <dd class="text-2xl font-extrabold text-primary-900 tabular-nums">30</dd>
                </div>
                <div class="flex flex-row-reverse items-baseline justify-between gap-3 py-2.5 sm:flex-col-reverse sm:items-start sm:justify-end sm:gap-1 sm:py-0">
                    <dt class="text-sm text-slate-700">centres VAE</dt>
                    <dd class="text-2xl font-extrabold text-primary-900 tabular-nums">30</dd>
                </div>
            </dl>
        </div>

        {# Carrousel de photos de métiers : défilement automatique, avec pause (WCAG 2.2.2),
           flèches, points, et arrêt si l'utilisateur préfère réduire les animations. #}
        {% set diapositives = [
            { fichier: 'carrousel/couturier-atelier.jpg', metier: 'Couture', position: 'object-[center_25%]' },
            { fichier: 'carrousel/menuisier.jpg', metier: 'Menuiserie', position: 'object-[center_30%]' },
            { fichier: 'carrousel/soudeur.jpg', metier: 'Soudure', position: 'object-[70%_center]' }
        ] %}
        <div class="order-first lg:order-none lg:col-span-5" id="carrousel"
             role="region" aria-roledescription="carrousel" aria-label="Des artisans à leur métier">
            <div class="relative aspect-[4/3] overflow-hidden rounded-lg border border-primary-200 bg-primary-100 lg:aspect-auto lg:h-[30rem]" id="carrousel-diapositives" aria-live="off">
                {% for d in diapositives %}
                    <figure data-diapositive role="group" aria-roledescription="diapositive" aria-label="{{ loop.index }} sur {{ diapositives|length }}"
                            class="absolute inset-0 m-0 transition-opacity duration-700 motion-reduce:transition-none {{ loop.first ? 'opacity-100' : 'opacity-0' }}"
                            {% if not loop.first %}aria-hidden="true"{% endif %}>
                        <img src="{{ asset('image/' ~ d.fichier) }}" alt="" width="1000" height="750"
                             {% if loop.first %}fetchpriority="high"{% else %}loading="lazy"{% endif %}
                             class="h-full w-full object-cover {{ d.position }} transition-transform duration-[1600ms] ease-out motion-reduce:transition-none {{ loop.first ? 'scale-100' : 'scale-110' }}">
                        <figcaption class="absolute bottom-3 left-3 inline-flex items-center gap-2 rounded-md bg-white px-3 py-1.5 text-sm font-semibold text-primary-900 transition duration-500 delay-300 ease-out motion-reduce:transition-none {{ loop.first ? 'translate-y-0 opacity-100' : 'translate-y-4 opacity-0' }}">
                            <i class="fas fa-screwdriver-wrench text-primary-700" aria-hidden="true"></i>{{ d.metier }}
                        </figcaption>
                    </figure>
                {% endfor %}
            </div>

            <div class="mt-3 flex items-center justify-between gap-3">
                <div class="flex items-center gap-1" role="group" aria-label="Choisir une photo">
                    {% for d in diapositives %}
                        <button type="button" data-point aria-label="Photo {{ loop.index }} : {{ d.metier }}" {% if loop.first %}aria-current="true"{% endif %}
                                class="group flex h-11 w-8 items-center justify-center rounded-md focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-primary-800">
                            <span class="h-2.5 w-2.5 rounded-full {{ loop.first ? 'bg-primary-800' : 'bg-primary-300' }} transition-colors duration-200 group-hover:bg-primary-600" data-pastille></span>
                        </button>
                    {% endfor %}
                </div>
                <div class="flex items-center gap-1">
                    <button type="button" data-precedent aria-label="Photo précédente"
                            class="flex h-11 w-11 items-center justify-center rounded-md border border-primary-200 bg-white text-primary-800 transition-colors duration-200 hover:bg-primary-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-800">
                        <i class="fas fa-chevron-left" aria-hidden="true"></i>
                    </button>
                    <button type="button" data-pause aria-label="Mettre le défilement en pause"
                            class="flex h-11 w-11 items-center justify-center rounded-md border border-primary-200 bg-white text-primary-800 transition-colors duration-200 hover:bg-primary-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-800">
                        <i class="fas fa-pause" aria-hidden="true" data-pause-icone></i>
                    </button>
                    <button type="button" data-suivant aria-label="Photo suivante"
                            class="flex h-11 w-11 items-center justify-center rounded-md border border-primary-200 bg-white text-primary-800 transition-colors duration-200 hover:bg-primary-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-800">
                        <i class="fas fa-chevron-right" aria-hidden="true"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>
</section>


{# ============================================================
   2. Conditions et dossier de candidature
   ============================================================ #}
<section id="conditions" class="py-10 sm:py-14 md:py-24 bg-slate-50 border-b border-slate-200 scroll-mt-24">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">

        <div class="grid lg:grid-cols-12 gap-6 items-start">

            {# Conditions + frais #}
            <div class="lg:col-span-7 rounded-lg bg-white border border-slate-200">
                <div class="p-5 sm:p-6 md:p-8">
                    <h3 id="conditions-candidature" class="scroll-mt-24 flex items-center gap-3 text-xl font-bold text-slate-800"><i class="fas fa-clipboard-check text-indigo-700" aria-hidden="true"></i>Conditions de candidature</h3>

                    <ul class="mt-6 space-y-5">
                        <li class="flex gap-4">
                            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-md bg-indigo-50 text-indigo-700" aria-hidden="true"><i class="fas fa-flag"></i></span>
                            <span class="text-base text-slate-700 pt-1.5">Être de nationalité ivoirienne</span>
                        </li>
                        <li class="flex gap-4">
                            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-md bg-indigo-50 text-indigo-700" aria-hidden="true"><i class="fas fa-cake-candles"></i></span>
                            <span class="text-base text-slate-700 pt-1.5">Être âgé de <strong class="font-semibold text-slate-800 tabular">21 ans</strong> au moins</span>
                        </li>
                        <li class="flex gap-4">
                            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-md bg-indigo-50 text-indigo-700" aria-hidden="true"><i class="fas fa-briefcase"></i></span>
                            <div class="min-w-0 flex-1">
                                <p class="text-base text-slate-700 pt-1.5">
                                    Justifier d'une expérience professionnelle en lien direct
                                    avec le métier visé, d'une durée minimale de&nbsp;:
                                </p>
                                <table class="mt-3 w-full max-w-sm text-left border border-slate-200 rounded-md overflow-hidden">
                                    <caption class="sr-only">Durée d'expérience minimale selon le diplôme visé</caption>
                                    <thead class="bg-slate-50">
                                        <tr>
                                            <th scope="col" class="px-4 py-2 text-sm font-semibold text-slate-600">Diplôme visé</th>
                                            <th scope="col" class="px-4 py-2 text-sm font-semibold text-slate-600">Expérience minimale</th>
                                        </tr>
                                    </thead>
                                    <tbody class="divide-y divide-slate-200">
                                        <tr>
                                            <th scope="row" class="px-4 py-2.5 text-base font-bold text-slate-800">CQP</th>
                                            <td class="px-4 py-2.5 text-base text-slate-700 tabular">5 ans</td>
                                        </tr>
                                        <tr>
                                            <th scope="row" class="px-4 py-2.5 text-base font-bold text-slate-800">CAP</th>
                                            <td class="px-4 py-2.5 text-base text-slate-700 tabular">7 ans</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </li>
                        <li class="flex gap-4">
                            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-md bg-indigo-50 text-indigo-700" aria-hidden="true"><i class="fas fa-money-bill-wave"></i></span>
                            <span class="text-base text-slate-700 pt-1.5">Avoir réglé les frais de participation à la session VAE</span>
                        </li>
                    </ul>
                </div>

                {# Frais de participation — séparés pour que le montant se lise d'un coup d'œil. #}
                <div class="border-t border-slate-200 p-5 sm:p-6 md:p-8">
                    <h3 class="flex items-center gap-3 text-xl font-bold text-slate-800"><i class="fas fa-coins text-indigo-700" aria-hidden="true"></i>Frais de participation</h3>

                    <dl class="mt-5 grid sm:grid-cols-2 gap-3">
                        <div class="rounded-md border border-slate-200 px-5 py-4">
                            <dt class="flex items-center gap-2 text-sm font-medium text-slate-600"><i class="fas fa-building text-indigo-700" aria-hidden="true"></i>Secteur formel</dt>
                            <dd class="mt-1 text-2xl font-extrabold text-slate-800 tabular whitespace-nowrap">120&nbsp;000&nbsp;FCFA</dd>
                        </div>
                        <div class="rounded-md border border-slate-200 px-5 py-4">
                            <dt class="flex items-center gap-2 text-sm font-medium text-slate-600"><i class="fas fa-store text-indigo-700" aria-hidden="true"></i>Secteur informel</dt>
                            <dd class="mt-1 text-2xl font-extrabold text-slate-800 tabular whitespace-nowrap">75&nbsp;000&nbsp;FCFA</dd>
                        </div>
                    </dl>

                    <p class="mt-4 text-sm leading-relaxed text-slate-600 max-w-[68ch]">
                        Ces frais couvrent l'inscription et l'analyse de l'éligibilité,
                        l'accompagnement et les droits d'examen de certification.
                    </p>
                </div>
            </div>

            {# Pièces du dossier #}
            <div id="preparer-dossier" class="lg:col-span-5 rounded-lg bg-white border border-slate-200 p-5 sm:p-6 md:p-8">
                <h3 class="flex items-center gap-3 text-xl font-bold text-slate-800"><i class="fas fa-folder-open text-indigo-700" aria-hidden="true"></i>Ce que vous devez préparer</h3>
                <p class="mt-2 text-sm text-slate-600">Ces pièces sont à présenter dans votre centre VAE.</p>

                {% set pieces = [
                  
                    { quantite: '1 copie', libelle: "Extrait de naissance ou jugement supplétif", icon: 'fa-file-signature' },
                    { quantite: '1 copie', libelle: "Pièce d'identité", icon: 'fa-id-card' },
                    { quantite: '1 copie', libelle: "Carte CMU", icon: 'fa-address-card' },
                    { quantite: '1 photos', libelle: "Photos d'identité couleur (même tirage)", icon: 'fa-image' }
                ] %}

                <ul class="mt-6 divide-y divide-slate-100">
                    {% for piece in pieces %}
                        <li class="flex items-start justify-between gap-3 py-3.5">
                            <div class="flex items-start gap-3 min-w-0">
                                <div class="w-10 h-10 rounded-md bg-indigo-50 text-indigo-700 flex items-center justify-center shrink-0">
                                    <i class="fas {{ piece.icon }} text-base" aria-hidden="true"></i>
                                </div>
                                <div>
                                    <span class="text-sm sm:text-base font-medium text-slate-800 block">{{ piece.libelle }}</span>
                                    {% if piece.note is defined %}
                                        <span class="inline-flex items-center gap-1 text-xs text-amber-700 font-medium mt-0.5">
                                            <i class="fas fa-circle-info text-[10px]" aria-hidden="true"></i>
                                            {{ piece.note }}
                                        </span>
                                    {% endif %}
                                </div>
                            </div>
                            <span class="shrink-0 inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-slate-100 text-slate-700 border border-slate-200">
                                {{ piece.quantite }}
                            </span>
                        </li>
                    {% endfor %}
                </ul>
            </div>
        </div>

        <div class="mt-10 border-t border-slate-300 pt-8">
            <div class="max-w-2xl">
                <h3 class="flex items-center gap-3 text-xl font-bold text-slate-800"><i class="fas fa-magnifying-glass text-indigo-700" aria-hidden="true"></i>Vérifiez votre métier et votre centre VAE</h3>
                <p class="mt-2 text-base leading-relaxed text-slate-600">
                    Ce document liste les centres VAE et, pour chacun, les métiers (CQP et CAP) qu'il propose. Trouvez votre métier pour connaître le centre où vous préinscrire.
                </p>
            </div>
            <div class="mt-5 max-w-2xl">
                {{ page.document(documents.liste, 'Centres VAE et métiers par centre', '30 centres VAE et leurs métiers, CQP et CAP') }}
            </div>
        </div>

        <div id="preinscription" class="mt-10 border-t border-slate-300 pt-8 md:flex md:items-center md:justify-between md:gap-8">
            <div class="max-w-2xl">
                <h3 class="flex items-center gap-3 text-2xl font-bold text-slate-800"><i class="fas fa-circle-check text-indigo-700" aria-hidden="true"></i>Vous remplissez les conditions ?</h3>
                <p class="mt-2 text-base leading-relaxed text-slate-600">
                    Vous pouvez maintenant commencer votre préinscription en ligne. Vous présenterez ensuite les pièces de votre dossier dans votre centre VAE.
                </p>
            </div>
            <a href="{{ path('app_register') }}"
               class="mt-5 md:mt-0 inline-flex w-full md:w-auto items-center justify-center gap-2 min-h-[52px] px-7 py-3.5 rounded-lg bg-indigo-600 text-white text-base font-bold hover:bg-indigo-700 transition-colors duration-200 whitespace-nowrap focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600">
                Commencer ma préinscription
                <i class="fas fa-arrow-right text-sm" aria-hidden="true"></i>
            </a>
        </div>
    </div>
</section>


{# ============================================================
   3. Carte informative : le déroulement détaillé vit désormais sur sa
   propre page (app_session_deroulement). L'accueil n'en garde qu'une
   porte d'entrée, pour ne pas concurrencer la vérification des
   conditions de candidature, qui reste l'objectif de cette page.
   L'ancre #deroulement est conservée : des liens externes la visent.
   ============================================================ #}
<section id="deroulement" class="py-10 sm:py-14 md:py-24 bg-white scroll-mt-24">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">

        {% set apercu_phases = [
            'Accueil et inscription',
            'Recevabilité des dossiers et éligibilité',
            'Accompagnement des candidats',
            'Épreuves de certification'
        ] %}

        <a href="{{ path('app_session_deroulement') }}"
           class="group block rounded-lg border border-slate-200 bg-white p-5 sm:p-6 md:p-8 transition-colors duration-200 motion-reduce:transition-none hover:border-indigo-600 hover:bg-indigo-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600">
            <div class="grid gap-6 lg:grid-cols-12 lg:gap-10">

                <div class="lg:col-span-7">
                    {# Icône au-dessus du titre sur téléphone : à côté, elle décalait
                       titre et texte d'un cran par rapport à la liste des phases. #}
                    <div class="flex flex-col items-start gap-3 sm:flex-row sm:gap-4">
                        <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-md border border-indigo-100 bg-indigo-50 text-indigo-700 transition-colors duration-200 motion-reduce:transition-none group-hover:bg-white" aria-hidden="true">
                            <i class="fas fa-list-check text-lg"></i>
                        </span>
                        <div class="min-w-0">
                            <h2 class="text-xl sm:text-2xl md:text-3xl font-bold tracking-tight text-slate-800 text-balance">
                                Tout savoir sur le déroulement de la session VAE 2026
                            </h2>
                            <p class="mt-2.5 text-base leading-relaxed text-slate-600 max-w-[60ch]">
                                Quatre phases, de l'inscription aux épreuves de certification&nbsp;:
                                ce qui se passe à chaque étape, à quelle date, et ce que vous avez à faire.
                            </p>
                        </div>
                    </div>
                </div>

                <div class="lg:col-span-5">
                    <ol class="grid gap-2.5 sm:grid-cols-2 sm:gap-x-6 lg:grid-cols-1">
                        {% for phase in apercu_phases %}
                            <li class="flex items-center gap-3">
                                <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full border border-indigo-200 bg-white text-xs font-bold text-indigo-700 tabular-nums">{{ loop.index }}</span>
                                <span class="text-sm font-medium text-slate-700">{{ phase }}</span>
                            </li>
                        {% endfor %}
                    </ol>
                </div>
            </div>

            <p class="mt-6 inline-flex min-h-[44px] items-center gap-2 text-base font-bold text-indigo-700">
                Voir le déroulement détaillé
                <i class="fas fa-arrow-right text-sm transition-transform duration-200 motion-reduce:transition-none group-hover:translate-x-1" aria-hidden="true"></i>
            </p>
        </a>
    </div>
</section>


{# ============================================================
   4. Aide à l'inscription
   ============================================================ #}
<section class="py-10 sm:py-14 md:py-20 bg-slate-50 border-t border-slate-200">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
        <div class="grid lg:grid-cols-12 gap-8 items-center">
            <div class="lg:col-span-7">
                <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-slate-800 text-balance">
                    Besoin d'aide pour votre préinscription ?
                </h2>
                <p class="mt-4 text-base leading-[1.75] text-slate-600 max-w-[62ch]">
                    Vous n'êtes pas à l'aise avec les démarches en ligne&nbsp;? Rendez-vous directement dans un centre VAE&nbsp;: un agent d'accueil vous aidera à vous préinscrire et à préparer votre dossier.
                </p>
            </div>
            <div class="lg:col-span-5 flex justify-center lg:justify-end">
                <div class="flex h-40 w-40 items-center justify-center rounded-lg border border-indigo-100 bg-indigo-50 sm:h-48 sm:w-48">
                    <img src="{{ asset('image/assistance.svg') }}" alt="" aria-hidden="true" class="h-20 w-24 sm:h-24 sm:w-28">
                </div>
            </div>
        </div>
    </div>
</section>


{# ============================================================
   5. Qui êtes-vous ? — entrées de connexion par profil.
   En bas de page, volontairement : l'accueil oriente d'abord vers la
   vérification des conditions de candidature. Les deux cartes
   réutilisent la logique d'authentification existante — même route
   app_login, seul le paramètre `profil` change, comme dans le menu
   « Mon espace » de l'en-tête.
   ============================================================ #}
<section id="qui-etes-vous" class="py-10 sm:py-14 md:py-24 bg-white border-t border-slate-200 scroll-mt-24">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">

        <div class="max-w-2xl">
            <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-slate-800 text-balance">
                Qui êtes-vous&nbsp;?
            </h2>
            <p class="mt-3 text-base leading-[1.75] text-slate-600">
                Vous avez déjà un compte&nbsp;? Rejoignez l'espace qui correspond à votre rôle.
            </p>
        </div>

        {% set profils = [
            {
                titre: 'Candidat',
                icone: 'fa-user',
                accroche: "Transformez votre expérience professionnelle en diplôme reconnu.",
                detail: "Suivez l'avancement de votre dossier, réglez vos frais et consultez vos résultats.",
                action: 'Accéder à mon espace candidat',
                url: path('app_login')
            },
            {
                titre: 'Professionnels de la VAE',
                icone: 'fa-user-tie',
                accroche: "Accompagnez les candidats et instruisez les dossiers de votre centre.",
                detail: "Conseillers VAE, accompagnateurs, agents d'accueil et administrateurs.",
                action: 'Accéder à mon espace professionnel',
                url: path('app_login', {'profil': 'professionnel'})
            }
        ] %}

        <div class="mt-8 grid gap-4 sm:grid-cols-2 sm:gap-5">
            {% for profil in profils %}
                <a href="{{ profil.url }}"
                   class="group flex flex-col rounded-lg border border-slate-200 bg-white p-5 sm:p-6 transition-colors duration-200 motion-reduce:transition-none hover:border-indigo-600 hover:bg-indigo-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600">
                    <span class="flex h-14 w-14 items-center justify-center rounded-md border border-indigo-100 bg-indigo-50 text-2xl text-indigo-700 transition-colors duration-200 motion-reduce:transition-none group-hover:bg-white" aria-hidden="true">
                        <i class="fas {{ profil.icone }}"></i>
                    </span>

                    <h3 class="mt-4 text-xl font-bold text-slate-800">{{ profil.titre }}</h3>
                    <p class="mt-2 text-base leading-relaxed text-slate-700">{{ profil.accroche }}</p>
                    <p class="mt-1.5 text-sm leading-relaxed text-slate-600">{{ profil.detail }}</p>

                    <span class="mt-5 inline-flex min-h-[44px] items-center gap-2 text-base font-bold text-indigo-700">
                        {{ profil.action }}
                        <i class="fas fa-arrow-right text-sm transition-transform duration-200 motion-reduce:transition-none group-hover:translate-x-1" aria-hidden="true"></i>
                    </span>
                </a>
            {% endfor %}
        </div>

        <p class="mt-6 flex flex-wrap items-center gap-x-2 gap-y-1 text-base text-slate-700">
            <i class="fas fa-circle-info text-[#ED8F33]" aria-hidden="true"></i>
            Vous n'avez pas encore de compte&nbsp;?
            <a href="#conditions-candidature" class="inline-flex min-h-[32px] items-center font-semibold text-indigo-700 underline underline-offset-4 hover:text-indigo-800 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600">
                Vérifiez d'abord les conditions de candidature
            </a>
        </p>
    </div>
</section>

{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
(function () {
    var racine = document.getElementById('carrousel');
    if (!racine) { return; }
    var diapos = racine.querySelectorAll('[data-diapositive]');
    var points = racine.querySelectorAll('[data-point]');
    var zone = document.getElementById('carrousel-diapositives');
    var boutonPause = racine.querySelector('[data-pause]');
    var iconePause = racine.querySelector('[data-pause-icone]');
    var courant = 0, minuteur = null, enPause = false, survol = false;
    var reduit = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function afficher(n) {
        courant = (n + diapos.length) % diapos.length;
        diapos.forEach(function (d, i) {
            var actif = i === courant;
            d.classList.toggle('opacity-100', actif);
            d.classList.toggle('opacity-0', !actif);
            var img = d.querySelector('img');
            var legende = d.querySelector('figcaption');
            img.classList.toggle('scale-100', actif);
            img.classList.toggle('scale-110', !actif);
            legende.classList.toggle('translate-y-0', actif);
            legende.classList.toggle('opacity-100', actif);
            legende.classList.toggle('translate-y-4', !actif);
            legende.classList.toggle('opacity-0', !actif);
            if (actif) { d.removeAttribute('aria-hidden'); } else { d.setAttribute('aria-hidden', 'true'); }
        });
        points.forEach(function (p, i) {
            var actif = i === courant;
            var pastille = p.querySelector('[data-pastille]');
            pastille.classList.toggle('bg-primary-800', actif);
            pastille.classList.toggle('bg-primary-300', !actif);
            if (actif) { p.setAttribute('aria-current', 'true'); } else { p.removeAttribute('aria-current'); }
        });
    }

    function arreter() { if (minuteur) { clearInterval(minuteur); minuteur = null; } }
    function demarrer() {
        arreter();
        if (enPause || survol || document.hidden) { return; }
        minuteur = setInterval(function () { afficher(courant + 1); }, 3000);
    }
    function majPause() {
        iconePause.classList.toggle('fa-pause', !enPause);
        iconePause.classList.toggle('fa-play', enPause);
        boutonPause.setAttribute('aria-label', enPause ? 'Reprendre le défilement' : 'Mettre le défilement en pause');
        zone.setAttribute('aria-live', enPause ? 'polite' : 'off');
    }

    racine.querySelector('[data-precedent]').addEventListener('click', function () { afficher(courant - 1); demarrer(); });
    racine.querySelector('[data-suivant]').addEventListener('click', function () { afficher(courant + 1); demarrer(); });
    points.forEach(function (p, i) { p.addEventListener('click', function () { afficher(i); demarrer(); }); });
    boutonPause.addEventListener('click', function () { enPause = !enPause; majPause(); demarrer(); });
    racine.addEventListener('mouseenter', function () { survol = true; arreter(); });
    racine.addEventListener('mouseleave', function () { survol = false; demarrer(); });
    racine.addEventListener('focusin', arreter);
    racine.addEventListener('focusout', demarrer);
    document.addEventListener('visibilitychange', demarrer);

    // Pas de défilement automatique si l'utilisateur préfère réduire les animations.
    enPause = reduit;
    majPause();
    demarrer();
})();
</script>
{% endblock %}
