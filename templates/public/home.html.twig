{% extends 'public/base.html.twig' %}

{% block title %}Côte d'Ivoire VAE — Session 2026 de certification des compétences{% endblock %}

{% block meta %}
    <meta name="author" content="DAIP — Direction de l'Apprentissage et de l'Insertion Professionnelle">
    <meta name="description" content="Session 2026 de certification des compétences par la VAE : obtenez un CQP ou un CAP grâce à votre expérience. Accueil et inscription du 21 septembre au 17 octobre 2026 dans 30 centres VAE.">
    <meta name="keywords" content="VAE, Côte d'Ivoire, DAIP, session 2026, validation des acquis, CQP, CAP, artisan, certification">
{% endblock %}

{# ============================================================
   L'accueil est un parcours en quatre étapes, à suivre dans l'ordre
   sans l'aide d'un agent : 1. voir le déroulement, 2. vérifier les
   conditions, 3. réunir le dossier de candidature, 4. commencer la
   préinscription (ou se faire accompagner).
   ============================================================ #}

{# En-tête d'étape : la pastille numérotée porte l'ordre du parcours. #}
{% macro etape(numero, titre, id) %}
    <div class="flex items-center gap-3 sm:gap-4">
        <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-primary-700 text-lg font-bold text-white tabular-nums sm:h-12 sm:w-12 sm:text-xl" aria-hidden="true">{{ numero }}</span>
        <h2 {% if id %}id="{{ id }}"{% endif %} class="scroll-mt-24 text-2xl font-bold tracking-tight text-slate-800 text-balance md:text-3xl">
            <span class="sr-only">Étape {{ numero }}&nbsp;: </span>{{ titre }}
        </h2>
    </div>
{% endmacro %}

{# Lien de fin d'étape vers la suivante. #}
{% macro etape_suivante(libelle, ancre, marge) %}
    <a href="#{{ ancre }}"
       class="{{ marge|default('mt-8') }} inline-flex min-h-[48px] w-full items-center justify-center gap-2 rounded-lg border border-primary-300 bg-white px-5 py-2 text-center text-base font-semibold text-primary-800 transition-colors duration-200 motion-reduce:transition-none hover:border-primary-500 hover:bg-primary-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-700 sm:w-auto">
        {{ libelle }}
        <i class="fas fa-arrow-down text-sm" aria-hidden="true"></i>
    </a>
{% endmacro %}

{# Pictogrammes du parcours VAE : grille 64×64, un seul trait, sans remplissage.
   pathLength="1" permet de les « dessiner » en animant stroke-dashoffset. #}
{% macro picto(numero) %}
    {% if numero == 1 %}
        <rect x="14" y="8" width="30" height="44" rx="3" pathLength="1"/>
        <path d="M20 18h18M20 26h18M20 34h10" pathLength="1"/>
        <path d="M38 55l14-14 5 5-14 14h-5z" pathLength="1"/>
    {% elseif numero == 2 %}
        <path d="M32 12v40M22 54h20M14 18h36" pathLength="1"/>
        <circle cx="32" cy="10" r="2" pathLength="1"/>
        <path d="M14 18L7 34M14 18l7 16M7 34a7 4 0 0 0 14 0" pathLength="1"/>
        <path d="M50 18l-7 16M50 18l7 16M43 34a7 4 0 0 0 14 0" pathLength="1"/>
    {% elseif numero == 3 %}
        <circle cx="20" cy="24" r="6" pathLength="1"/>
        <path d="M8 52v-4a12 12 0 0 1 24 0v4" pathLength="1"/>
        <circle cx="42" cy="30" r="5" pathLength="1"/>
        <path d="M32 52v-3a10 10 0 0 1 20 0v3" pathLength="1"/>
        <path d="M46 4h12a3 3 0 0 1 3 3v6a3 3 0 0 1-3 3h-6l-4 4v-4h-2a3 3 0 0 1-3-3V7a3 3 0 0 1 3-3z" pathLength="1"/>
    {% elseif numero == 4 %}
        <rect x="14" y="10" width="36" height="46" rx="3" pathLength="1"/>
        <path d="M24 10V8a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v2" pathLength="1"/>
        <path d="M21 26l3 3 5-6M33 26h10M21 40l3 3 5-6M33 40h10" pathLength="1"/>
    {% else %}
        <rect x="6" y="10" width="38" height="28" rx="2" pathLength="1"/>
        <path d="M14 20h22M14 28h14" pathLength="1"/>
        <g class="text-[#ED8F33]">
            <circle cx="48" cy="44" r="8" pathLength="1"/>
            <path d="M44 51l-3 9 7-3 7 3-3-9" pathLength="1"/>
        </g>
    {% endif %}
{% endmacro %}

{# Visage d'un personnage du parcours, recadré sur la tête, pour les pastilles. #}
{% macro visage(chemin, cadrage) %}
    <img src="{{ asset(chemin) }}" alt="" width="44" height="44" loading="lazy" decoding="async" aria-hidden="true"
         class="h-full w-full scale-[1.9] object-cover object-top {{ cadrage|default('origin-[50%_22%]') }}">
{% endmacro %}

{% block body %}
{% import _self as page %}

{% set parcours = [
    { libelle: 'Accueil et inscription', cadrage: 'origin-[68%_22%]' },
    { libelle: 'Recevabilité des dossiers et éligibilité', cadrage: 'origin-[32%_18%]' },
    { libelle: 'Accompagnement des candidats', cadrage: 'origin-[30%_22%]' },
    { libelle: 'Épreuves de certification', cadrage: 'origin-[33%_20%]' },
    { libelle: 'Diplôme CQP / CAP', cadrage: 'origin-[60%_42%]' }
] %}

{% set etapes_page = [
    { libelle: 'Voir le déroulement', ancre: 'deroulement' },
    { libelle: 'Conditions de candidature', ancre: 'conditions-candidature' },
    { libelle: 'Dossier de candidature', ancre: 'dossier-candidature' },
    { libelle: 'Commencer ma préinscription', ancre: 'preinscription' }
] %}

{# ============================================================
   En-tête : annonce de la session et parcours en 4 étapes.
   Sur téléphone : titre → texte et dates → animation → étapes.
   ============================================================ #}
<section id="session" class="bg-primary-50 border-b border-primary-200 scroll-mt-24">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-8 sm:py-10 md:py-16 grid grid-cols-1 gap-6 sm:gap-8 lg:grid-cols-12 lg:gap-x-14 lg:gap-y-7">

        <div class="lg:col-span-7 lg:self-end">
            <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-primary-900 leading-[1.1] text-balance">
                Votre expérience professionnelle vaut un diplôme
            </h1>
            <p class="mt-4 sm:mt-5 text-base sm:text-lg leading-relaxed text-slate-700 max-w-[52ch]">
               Avec la VAE, faites reconnaître vos compétences par un Certificat de Qualification Professionnelle (CQP) ou un Certificat d’Aptitude Professionnelle (CAP).
            </p>
            <p class="mt-5 inline-flex items-start gap-3 rounded-lg border border-primary-200 bg-white px-4 py-3 text-base text-slate-700">
                <i class="fas fa-calendar-days mt-1 text-primary-700" aria-hidden="true"></i>
                <span>Accueil et inscription <strong class="font-bold text-primary-900 tabular-nums">du 21 septembre au 17 octobre 2026</strong></span>
            </p>
        </div>

        {# Le parcours VAE en motion design, en 5 « phases » (la page, elle, a
           4 « étapes » : deux numérotations distinctes, deux mots distincts).
           Sans JavaScript, la liste statique des phases reste affichée ; avec,
           elle devient la version lue par les lecteurs d'écran. #}
        <div class="lg:col-span-5 lg:col-start-8 lg:row-span-2 lg:row-start-1 lg:self-center">
            <div x-data="parcoursVae"
                 @mouseenter="survol = true; planifier()" @mouseleave="survol = false; planifier()"
                 @focusin="focus = $event.target.matches(':focus-visible'); planifier()" @focusout="focus = false; planifier()"
                 role="group" aria-label="Le parcours VAE en 5 phases"
                 class="relative flex flex-col rounded-lg border border-primary-200 bg-white p-4 sm:p-6 lg:h-[32rem]">

                <ol :class="anime ? 'sr-only' : ''" class="space-y-3">
                    {% for e in parcours %}
                        <li class="flex items-center gap-3">
                            <span class="flex h-11 w-11 shrink-0 items-center justify-center overflow-hidden rounded-full border border-primary-200 bg-primary-50 text-primary-700" aria-hidden="true">
                                {% if avatars %}
                                    {{ page.visage(avatars[loop.index0], e.cadrage ?? null) }}
                                {% else %}
                                    <svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6 [&_*]:[vector-effect:non-scaling-stroke]">{{ page.picto(loop.index) }}</svg>
                                {% endif %}
                            </span>
                            <span class="text-base font-semibold text-primary-900">
                                {{ e.libelle }}
                            </span>
                        </li>
                    {% endfor %}
                </ol>

                <div x-cloak class="flex flex-1 flex-col">
                    <button type="button" @click="basculer()"
                            :aria-label="enPause ? 'Reprendre l\'animation' : 'Mettre l\'animation en pause'"
                            class="absolute right-3 top-3 z-10 flex h-11 w-11 items-center justify-center rounded-md border border-primary-200 bg-white text-primary-800 transition-colors duration-200 hover:bg-primary-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-700">
                        <i class="fas" :class="enPause ? 'fa-play' : 'fa-pause'" aria-hidden="true"></i>
                    </button>

                    <div aria-hidden="true" class="relative {{ avatars ? 'h-[19rem] sm:h-[22rem]' : 'h-56 sm:h-60' }} lg:h-auto lg:flex-1">
                        {% for e in parcours %}
                            {% set i = loop.index0 %}
                            <div class="absolute inset-0 flex flex-col items-center justify-center px-6 text-center transition-opacity motion-reduce:transition-none"
                                 :class="estActive({{ i }}) ? 'opacity-100 duration-300' : 'opacity-0 duration-200'">
                                {% if avatars %}
                                    {# Personnage dans un hexagone : la tête dépasse du haut,
                                       le buste est coupé par les deux pans du bas. #}
                                    <div class="relative h-52 w-52 sm:h-64 sm:w-64 lg:h-72 lg:w-72">
                                        <div class="absolute inset-x-0 bottom-0 h-[82%] transition-transform duration-500 ease-out motion-reduce:transition-none [clip-path:polygon(50%_0,100%_25%,100%_75%,50%_100%,0_75%,0_25%)] {{ loop.last ? 'bg-[#ED8F33]/25' : (loop.index is odd ? 'bg-primary-100' : 'bg-primary-200') }}"
                                             :class="estActive({{ i }}) ? 'scale-100' : 'scale-90'"></div>
                                        <img src="{{ asset(avatars[i]) }}" alt="" width="512" height="512" loading="lazy" decoding="async"
                                             class="absolute inset-0 h-full w-full object-contain object-bottom transition duration-700 ease-out motion-reduce:transition-none [clip-path:polygon(0_0,100%_0,100%_79.5%,50%_100%,0_79.5%)]"
                                             :class="estActive({{ i }}) ? 'translate-y-0 opacity-100 delay-100' : 'translate-y-4 opacity-0'">
                                    </div>
                                {% else %}
                                <svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                                     class="h-24 w-24 text-primary-700 lg:h-32 lg:w-32 [&_*]:[stroke-dasharray:1] [&_*]:transition-[stroke-dashoffset] [&_*]:duration-700 [&_*]:ease-out motion-reduce:[&_*]:transition-none"
                                     :class="estActive({{ i }}) ? '[&_*]:[stroke-dashoffset:0]' : '[&_*]:[stroke-dashoffset:1]'">{{ page.picto(loop.index) }}</svg>
                                {% endif %}
                                <div class="mt-4 transition duration-[400ms] ease-out motion-reduce:transition-none"
                                     :class="estActive({{ i }}) ? 'opacity-100 translate-y-0 delay-150' : 'opacity-0 translate-y-2'">
                                    <p class="text-lg font-bold leading-snug text-primary-900 text-balance sm:text-xl">{{ e.libelle }}</p>
                                </div>
                            </div>
                        {% endfor %}
                    </div>

                    {# Rail de progression : un point par phase, chacun est un bouton
                       (zone tactile de 44 px autour d'un point de 12 à 16 px). #}
                    <div class="relative mt-4">
                        <span class="absolute left-[22px] right-[22px] top-1/2 h-0.5 -translate-y-1/2 bg-primary-100" aria-hidden="true"></span>
                        <span class="absolute left-[22px] right-[22px] top-1/2 h-0.5 -translate-y-1/2 origin-left bg-primary-700 transition-transform ease-out motion-reduce:transition-none"
                              :class="[echelles[active], active === 0 ? 'duration-0' : 'duration-[600ms]']" aria-hidden="true"></span>
                        <ol class="relative flex items-center justify-between">
                            {% for e in parcours %}
                                {% set i = loop.index0 %}
                                <li>
                                    <button type="button" @click="aller({{ i }})"
                                            :aria-current="active === {{ i }} ? 'step' : false"
                                            aria-label="Phase {{ loop.index }} : {{ e.libelle }}"
                                            class="group flex h-11 w-11 items-center justify-center rounded-full focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-700">
                                        <span class="block rounded-full transition-all duration-300 ease-out motion-reduce:transition-none" :class="classePoint({{ i }})" aria-hidden="true"></span>
                                    </button>
                                </li>
                            {% endfor %}
                        </ol>
                    </div>
                </div>
            </div>
        </div>

        <div class="lg:col-span-7 lg:self-start">
            {# Les trois étapes de cette page, à suivre dans l'ordre. #}
            <nav aria-label="Les étapes de votre démarche">
                <ol class="grid grid-cols-1 gap-px overflow-hidden rounded-lg border border-primary-200 bg-primary-100 sm:grid-cols-2">
                    {% for e in etapes_page %}
                        <li class="bg-white">
                            <a href="#{{ e.ancre }}"
                               class="group flex h-full min-h-[56px] items-center gap-3 px-4 py-3 transition-colors duration-200 motion-reduce:transition-none hover:bg-primary-50 focus-visible:outline focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-primary-700">
                                <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-primary-700 text-sm font-bold text-white tabular-nums" aria-hidden="true">{{ loop.index }}</span>
                                <span class="min-w-0 flex-1 text-base font-semibold leading-snug text-primary-900"><span class="sr-only">Étape {{ loop.index }}&nbsp;: </span>{{ e.libelle }}</span>
                                <i class="fas fa-arrow-down text-sm text-primary-700 transition-transform duration-200 motion-reduce:transition-none group-hover:translate-y-0.5 lg:hidden" aria-hidden="true"></i>
                            </a>
                        </li>
                    {% endfor %}
                </ol>
            </nav>

        </div>
    </div>
</section>


{# ============================================================
   ÉTAPE 1 — Voir le déroulement.
   Les quatre phases sont montrées par l'animation de l'en-tête ; l'étape
   garde l'accès au déroulement détaillé (app_session_deroulement).
   L'ancre #deroulement est conservée : des liens externes la visent.
   ============================================================ #}
<section id="deroulement" class="py-10 sm:py-12 md:py-14 bg-white scroll-mt-24">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
        {{ page.etape(1, 'Voir le déroulement') }}

        <div class="mt-6 flex flex-col gap-6 lg:flex-row lg:items-center lg:gap-8">
        <a href="{{ path('app_session_deroulement') }}"
           class="group flex flex-1 flex-col items-start gap-4 rounded-lg border border-slate-200 bg-white p-5 transition-colors duration-200 motion-reduce:transition-none hover:border-indigo-600 hover:bg-indigo-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600 sm:flex-row sm:gap-5 sm:p-6">
            <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-md border border-indigo-100 bg-indigo-50 text-indigo-700 transition-colors duration-200 motion-reduce:transition-none group-hover:bg-white" aria-hidden="true">
                <i class="fas fa-list-check text-lg"></i>
            </span>
            <div class="min-w-0">
                <h3 class="text-xl font-bold tracking-tight text-slate-800 text-balance">
                    Tout savoir sur le déroulement de la session VAE 2026
                </h3>
                <p class="mt-2.5 text-base leading-relaxed text-slate-600 max-w-[60ch]">
                    Quatre phases, de l'inscription aux épreuves de certification&nbsp;:
                    ce qui se passe à chaque étape, à quelle date, et ce que vous avez à faire.
                </p>
                <p class="mt-3 inline-flex min-h-[44px] items-center gap-2 text-base font-bold text-indigo-700">
                    Voir le déroulement détaillé
                    <i class="fas fa-arrow-right text-sm transition-transform duration-200 motion-reduce:transition-none group-hover:translate-x-1" aria-hidden="true"></i>
                </p>
            </div>
        </a>

        {{ page.etape_suivante('Étape suivante : les conditions', 'conditions-candidature', 'lg:shrink-0') }}
        </div>
    </div>
</section>


{# ============================================================
   ÉTAPE 2 — Conditions de candidature.
   Ordre des questions de l'artisan : puis-je candidater ? mon métier
   et mon centre ? combien, et quelles pièces apporter ?
   ============================================================ #}
<section class="py-10 sm:py-14 md:py-20 bg-slate-50 border-y border-slate-200">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
        {{ page.etape(2, 'Conditions de candidature', 'conditions-candidature') }}

        {# 2.1 — Les quatre conditions, en tuiles. #}
        <ul class="mt-6 grid grid-cols-1 gap-3 md:grid-cols-2">
            <li class="flex gap-4 rounded-lg border border-slate-200 bg-white p-4 sm:p-5">
                <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-md bg-indigo-50 text-indigo-700" aria-hidden="true"><i class="fas fa-flag"></i></span>
                <span class="text-base text-slate-700 pt-2.5">Être de nationalité ivoirienne</span>
            </li>
            <li class="flex gap-4 rounded-lg border border-slate-200 bg-white p-4 sm:p-5">
                <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-md bg-indigo-50 text-indigo-700" aria-hidden="true"><i class="fas fa-cake-candles"></i></span>
                <span class="text-base text-slate-700 pt-2.5">Être âgé de <strong class="font-semibold text-slate-800 tabular-nums">21 ans</strong> au moins</span>
            </li>
            <li class="flex gap-4 rounded-lg border border-slate-200 bg-white p-4 sm:p-5">
                <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-md bg-indigo-50 text-indigo-700" aria-hidden="true"><i class="fas fa-briefcase"></i></span>
                <div class="min-w-0 flex-1">
                    <p class="text-base text-slate-700 pt-2.5">
                        Justifier d'une expérience professionnelle en lien direct
                        avec le métier visé, d'une durée minimale de&nbsp;:
                    </p>
                    <p class="sr-only">Durée d'expérience minimale selon le diplôme visé</p>
                    <dl class="mt-3 grid max-w-xs grid-cols-2 gap-2">
                        <div class="rounded-md border border-slate-200 bg-slate-50 px-3 py-2.5">
                            <dt class="text-sm font-bold text-slate-600">CQP</dt>
                            <dd class="text-2xl font-extrabold text-slate-800 tabular-nums whitespace-nowrap">5 ans</dd>
                        </div>
                        <div class="rounded-md border border-slate-200 bg-slate-50 px-3 py-2.5">
                            <dt class="text-sm font-bold text-slate-600">CAP</dt>
                            <dd class="text-2xl font-extrabold text-slate-800 tabular-nums whitespace-nowrap">7 ans</dd>
                        </div>
                    </dl>
                </div>
            </li>
            {# La condition porte aussi les montants : un seul endroit pour les frais. #}
            <li class="flex gap-4 rounded-lg border border-slate-200 bg-white p-4 sm:p-5">
                <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-md bg-indigo-50 text-indigo-700" aria-hidden="true"><i class="fas fa-money-bill-wave"></i></span>
                <div class="min-w-0 flex-1">
                    <p class="text-base text-slate-700 pt-2.5">Avoir réglé les frais de participation à la session VAE</p>
                    <dl class="mt-3 grid grid-cols-1 gap-2 sm:grid-cols-2 md:grid-cols-1 lg:grid-cols-2">
                        <div class="rounded-md border border-slate-200 bg-slate-50 px-3 py-2.5">
                            <dt class="flex items-center gap-2 text-sm font-bold text-slate-600"><i class="fas fa-building text-indigo-700" aria-hidden="true"></i>Secteur formel</dt>
                            <dd class="text-xl font-extrabold text-slate-800 tabular-nums whitespace-nowrap sm:text-2xl">120&nbsp;000&nbsp;FCFA</dd>
                        </div>
                        <div class="rounded-md border border-slate-200 bg-slate-50 px-3 py-2.5">
                            <dt class="flex items-center gap-2 text-sm font-bold text-slate-600"><i class="fas fa-store text-indigo-700" aria-hidden="true"></i>Secteur informel</dt>
                            <dd class="text-xl font-extrabold text-slate-800 tabular-nums whitespace-nowrap sm:text-2xl">75&nbsp;000&nbsp;FCFA</dd>
                        </div>
                    </dl>
                    <p class="mt-3 text-sm leading-relaxed text-slate-600">
                        Ces frais couvrent l'inscription et l'analyse de l'éligibilité,
                        l'accompagnement et les droits d'examen de certification.
                    </p>
                </div>
            </li>
        </ul>

        {# 2.2 — Métier et centre : deux grandes entrées vers la page dédiée
           (app_metiers_centres), où tous les métiers et tous les centres sont
           affichés et se filtrent pendant la frappe. #}
        <div class="mt-10">
            <h3 class="flex items-center gap-3 text-xl font-bold text-slate-800"><i class="fas fa-magnifying-glass text-indigo-700" aria-hidden="true"></i>Vérifiez votre métier et votre centre VAE</h3>

            {% set acces = [
                { url: path('app_metiers_centres') ~ '#metiers', icone: 'fa-screwdriver-wrench', titre: 'Voir tous les métiers VAE', detail: 'Mon métier est-il concerné ? Consultez la liste des métiers de la session 2026.' },
                { url: path('app_metiers_centres') ~ '#centres', icone: 'fa-location-dot', titre: 'Trouver mon centre VAE', detail: 'Trouvez le centre VAE de votre ville et les métiers qu’il propose.' }
            ] %}
            <ul class="mt-5 grid grid-cols-1 gap-4 md:grid-cols-2">
                {% for a in acces %}
                    <li>
                        <a href="{{ a.url }}"
                           class="group flex h-full min-h-[96px] items-center gap-4 rounded-lg border-2 border-primary-200 bg-white p-5 transition-colors duration-200 motion-reduce:transition-none hover:border-primary-700 hover:bg-primary-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-700 sm:p-6">
                            <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-lg bg-primary-700 text-xl text-white" aria-hidden="true">
                                <i class="fas {{ a.icone }}"></i>
                            </span>
                            <span class="min-w-0 flex-1">
                                <span class="block text-lg font-bold leading-snug text-primary-900 text-balance">{{ a.titre }}</span>
                                <span class="mt-1 block text-sm leading-relaxed text-slate-600">{{ a.detail }}</span>
                            </span>
                            <i class="fas fa-arrow-right shrink-0 text-lg text-primary-700 transition-transform duration-200 motion-reduce:transition-none group-hover:translate-x-1" aria-hidden="true"></i>
                        </a>
                    </li>
                {% endfor %}
            </ul>
        </div>

        {{ page.etape_suivante('Étape suivante : le dossier de candidature', 'dossier-candidature') }}
    </div>
</section>


{# ============================================================
