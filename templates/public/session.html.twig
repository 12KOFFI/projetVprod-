{% extends 'public/base.html.twig' %}

{% block title %}Déroulement de la session 2026 — VAE Côte d'Ivoire{% endblock %}

{% block meta %}
    <meta name="author" content="DAIP — Direction de l'Apprentissage et de l'Insertion Professionnelle">
    <meta name="description" content="Les quatre phases de la session 2026 de certification par la VAE : accueil et inscription du 21 septembre au 17 octobre 2026, recevabilité et éligibilité, accompagnement, épreuves de certification.">
    <meta name="keywords" content="VAE, Côte d'Ivoire, DAIP, session 2026, déroulement, calendrier, recevabilité, éligibilité, accompagnement, certification">
{% endblock %}

{% block body %}

{# ============================================================
   En-tête de page
   ============================================================ #}
<section class="bg-primary-50 border-b border-primary-200">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-8 sm:py-12 md:py-16">

        <nav aria-label="Fil d'Ariane" class="mb-6">
            <ol class="flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-primary-800">
                <li>
                    <a href="{{ path('app_home') }}" class="inline-flex min-h-[32px] items-center font-medium underline underline-offset-4 hover:text-primary-900 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-800">Accueil</a>
                </li>
                <li aria-hidden="true"><i class="fas fa-chevron-right text-[0.625rem]"></i></li>
                <li aria-current="page" class="font-semibold text-primary-900">Déroulement de la session 2026</li>
            </ol>
        </nav>

        <div class="grid gap-6 lg:grid-cols-12 lg:items-end lg:gap-10">
            <div class="lg:col-span-7">
                <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-primary-900 leading-[1.1] text-balance">
                    Déroulement de la session 2026
                </h1>
                <p class="mt-4 text-base sm:text-lg leading-relaxed text-slate-700 max-w-[58ch]">
                    Quatre phases, de l'inscription aux épreuves de certification.
                    Cette page détaille ce qui se passe à chaque étape et ce que
                    vous avez à faire.
                </p>
            </div>

            <div class="lg:col-span-5">
                <div class="flex items-start gap-4 rounded-lg border border-primary-200 bg-white p-4 sm:p-5">
                    <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-md bg-primary-100 text-primary-800" aria-hidden="true">
                        <i class="fas fa-calendar-days text-lg"></i>
                    </span>
                    <p class="text-base text-slate-700">
                        Accueil et inscription
                        <strong class="block text-lg font-bold text-primary-900 tabular-nums">du 21 septembre au 17 octobre 2026</strong>
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>


{# ============================================================
   Les quatre phases
   La numérotation porte la chronologie : elle informe.
   ============================================================ #}
<section class="py-10 sm:py-14 md:py-24 bg-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">

        {% set phases = [
            {
                titre: 'Accueil et inscription',
                icone: 'fa-file-pen',
                periode: 'Du 21 septembre au 17 octobre 2026',
                activites: [
                    "Préinscription en ligne sur cette plateforme.",
                    "Enregistrement du dossier de candidature (pièces administratives et justificatifs de l'expérience professionnelle) dans l'un des 30 centres VAE.",
                    "Paiement des frais de participation à la session VAE via Trésor Pay."
                ]
            },
            {
                titre: "Recevabilité des dossiers et éligibilité",
                icone: 'fa-scale-balanced',
                activites: [
                    "Orientation dans le choix de la certification visée.",
                    "Aide à la constitution du dossier de preuves (pièces administratives et justificatifs de l'expérience professionnelle).",
                    "Tenue du jury local de recevabilité.",
                    "Tenue du jury national d'éligibilité.",
                    "Publication des résultats des candidats éligibles sur cette plateforme."
                ]
            },
            {
                titre: 'Accompagnement des candidats',
                icone: 'fa-handshake-angle',
                activites: [
                    "Les accompagnateurs aident les candidats à élaborer leur livret de preuves et à se préparer aux épreuves de certification."
                ]
            },
            {
                titre: 'Épreuves de certification',
                icone: 'fa-award',
                activites: [
                    "Épreuves d'entretien et de mise en situation professionnelle, selon le calendrier fixé."
                ]
            }
        ] %}

        <ol class="border-t border-slate-200">
            {% for phase in phases %}
                <li class="grid lg:grid-cols-12 gap-x-8 gap-y-3 py-6 sm:py-8 border-b border-slate-200">
                    <div class="lg:col-span-4 flex gap-3 sm:gap-4">
                        <span class="shrink-0 w-10 h-10 rounded-full border-2 {{ loop.first ? 'border-indigo-600 bg-indigo-600 text-white' : 'border-indigo-200 bg-white text-indigo-700' }} flex items-center justify-center text-base font-bold tabular-nums">
                            {{ loop.index }}
                        </span>
                        <span class="hidden sm:flex shrink-0 w-10 h-10 rounded-md bg-indigo-50 text-indigo-700 items-center justify-center" aria-hidden="true">
                            <i class="fas {{ phase.icone }}"></i>
                        </span>
                        <div class="min-w-0 pt-1.5">
                            <h2 class="text-lg font-bold text-slate-800 text-balance">{{ phase.titre }}</h2>
                            {% if phase.periode is defined %}
                                <p class="mt-1.5 inline-flex items-center gap-2 text-sm font-semibold text-indigo-700 tabular-nums">
                                    <i class="fas fa-calendar-days" aria-hidden="true"></i>
                                    {{ phase.periode }}
                                </p>
                            {% endif %}
                        </div>
                    </div>

                    <div class="lg:col-span-8 lg:pt-1.5">
                        {% if phase.activites|length > 1 %}
                            <ul class="space-y-2.5">
                                {% for activite in phase.activites %}
                                    <li class="flex gap-3 text-base leading-relaxed text-slate-700 max-w-[68ch]">
                                        <span class="shrink-0 mt-[0.7rem] w-1.5 h-1.5 rounded-full bg-slate-500" aria-hidden="true"></span>
                                        <span>{{ activite }}</span>
                                    </li>
                                {% endfor %}
                            </ul>
                        {% else %}
                            <p class="text-base leading-relaxed text-slate-700 max-w-[68ch]">{{ phase.activites|first }}</p>
                        {% endif %}
                    </div>
                </li>
            {% endfor %}
        </ol>
    </div>
</section>


{# ============================================================
   Retour au parcours : la vérification des conditions reste
   l'étape préalable à toute préinscription.
   ============================================================ #}
<section class="py-10 sm:py-14 md:py-20 bg-slate-50 border-t border-slate-200">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-center lg:gap-10">
            <div class="lg:col-span-7">
                <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-slate-800 text-balance">
                    Avant de vous préinscrire, vérifiez les conditions
                </h2>
                <p class="mt-3 text-base leading-[1.75] text-slate-600 max-w-[62ch]">
                    Nationalité, âge, durée d'expérience professionnelle et frais
                    de participation&nbsp;: assurez-vous de remplir les conditions,
                    puis préparez les pièces de votre dossier.
                </p>
            </div>
            <div class="lg:col-span-5 flex flex-col gap-3 sm:flex-row sm:flex-wrap lg:justify-end">
                <a href="{{ path('app_home') }}#conditions-candidature"
                   class="inline-flex min-h-[52px] items-center justify-center gap-2 rounded-lg bg-primary-800 px-6 text-base font-bold text-white transition-colors duration-200 hover:bg-primary-900 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-800">
                    Vérifier les conditions
                    <i class="fas fa-arrow-right text-sm" aria-hidden="true"></i>
                </a>
                <a href="{{ path('app_home') }}"
                   class="inline-flex min-h-[52px] items-center justify-center gap-2 rounded-lg border border-slate-300 bg-white px-6 text-base font-semibold text-slate-700 transition-colors duration-200 hover:bg-slate-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-800">
                    Retour à l'accueil
                </a>
            </div>
        </div>
    </div>
</section>

{% endblock %}
