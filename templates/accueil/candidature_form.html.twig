{# Modification d'un dossier préinscrit par l'agent d'accueil (même formulaire que le candidat). #}
{% extends 'base_dashboard.html.twig' %}
{% import 'partials/_ui.html.twig' as ui %}

{% block title %}Modifier le dossier {{ candidature.numero }} — Accueil{% endblock %}

{% block body %}
{{ ui.bandeau(
    'Modifier le dossier',
    candidature.numero ~ ' — ' ~ (candidature.user ? candidature.user.nomComplet : 'candidat inconnu') ~ " · modifiable tant que son étude n'est pas acceptée",
    'pen-to-square'
) }}

{{ form_start(form, {attr: {novalidate: 'novalidate', 'x-data': 'depotCandidature()', '@submit': 'verifierAvantEnvoi($event)'}}) }}
<div class="space-y-6">

    {% if form.vars.errors|length > 0 %}
        <div role="alert" class="rounded-lg p-4 text-sm bg-red-50 text-red-800 border border-red-200">
            <div class="flex items-start gap-3">
                <i class="fas fa-exclamation-circle text-red-600 mt-0.5" aria-hidden="true"></i>
                <div>{{ form_errors(form) }}</div>
            </div>
        </div>
    {% endif %}

    {# ===== Formation visée ===== #}
    <div class="bg-white rounded-lg border border-slate-200 p-6">
        {{ ui.section('Formation visée', 'Le centre de dépôt du dossier ne peut pas être changé', 'graduation-cap', 'indigo') }}

        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            <div>
                <p class="block text-xs font-semibold text-slate-600 mb-1.5">Centre de dépôt</p>
                <div class="w-full px-3.5 py-2.5 rounded-lg border border-slate-200 bg-slate-50 text-sm text-slate-600">
                    <i class="fas fa-lock text-xs mr-1.5 opacity-60" aria-hidden="true"></i>{{ candidature.centre ? candidature.centre.nom : '—' }}
                </div>
            </div>
            {{ ui.champ(form.metier, '', {'x-ref': 'metier', '@change': 'chargerCertifications()'},
                ui.choix_initial(form.metier, candidature.metier ? candidature.metier.libelle : null, 'un métier')) }}
        </div>
    </div>

    {# ===== Expérience professionnelle ===== #}
    <div class="bg-white rounded-lg border border-slate-200 p-6">
        {{ ui.section('Expérience professionnelle', 'Elle aide à choisir le diplôme visé', 'briefcase', 'amber') }}

        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            {{ ui.champ(form.nbAnneesExperience) }}
            {{ ui.champ(
                form.certification,
                '',
                {'x-ref': 'certification', 'data-centre': form.vars.data.centre ? form.vars.data.centre.id : ''},
                '<span x-show="chargementCertifications"><i class="fas fa-circle-notch fa-spin mr-1"></i>Chargement des diplômes du centre…</span>'
                    ~ ui.choix_initial(form.certification, candidature.diplomedemande, 'un diplôme')
            ) }}
            {{ ui.champ(form.situationPro) }}
            {{ ui.champ(form.diplome) }}
            {{ ui.champ(form.titrepro) }}
        </div>

        <div class="mt-5 rounded-lg bg-amber-50 border border-amber-200 p-4">
            <div class="flex items-start gap-3">
                <i class="fas fa-lightbulb text-amber-500 mt-0.5" aria-hidden="true"></i>
                <p class="text-xs text-amber-800 leading-relaxed">
                    Au moins 5 ans d'expérience pour le <strong>CQP</strong> ; au moins 7 ans pour
                    le <strong>CAP</strong>.
                </p>
            </div>
        </div>
    </div>

    {# ===== Entreprise ===== #}
    <div class="bg-white rounded-lg border border-slate-200 p-6">
        {{ ui.section('Entreprise ou atelier', 'Facultatif', 'building', 'orange') }}

        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            {{ ui.champ(form.nomEntreprise) }}
            {{ ui.champ(form.refentreprise) }}
            {{ ui.champ(form.lieuExercice) }}
            {{ ui.champ(form.directionService) }}
            {{ ui.champ(form.fonction) }}
            {{ ui.champ(form.refContrat) }}
            {{ ui.champ(form.contactemployeur) }}
            {{ ui.champ(form.langue) }}
            {{ ui.champ(form.preciserlangue) }}
        </div>
    </div>

    {# ===== Pièces justificatives ===== #}
    <div class="bg-white rounded-lg border border-slate-200 p-6">
        {{ ui.section('Pièces justificatives', 'JPG, PNG ou PDF — 2 Mo maximum par pièce', 'paperclip', 'purple') }}

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            {% for champ, libelle in documents_obligatoires %}
                {% if form[champ] is defined %}
                    {{ ui.document(form[champ], libelle, true, attribute(candidature, champ)) }}
                {% endif %}
            {% endfor %}
        </div>
    </div>

    {# ===== Actions ===== #}
    <div class="bg-white rounded-lg border border-slate-200 p-5 flex flex-col sm:flex-row items-center justify-between gap-4">
        <p class="text-xs text-slate-600 leading-relaxed">
            <i class="fas fa-user-shield mr-1.5 opacity-60" aria-hidden="true"></i>
            Cette modification sera enregistrée à votre nom pour traçabilité.
        </p>

        <div class="flex flex-col sm:flex-row gap-3 w-full sm:w-auto">
            {# Pas de lien vers /candidature/{id} : le dossier reste modifiable, donc
               cette route y renverrait aussitôt plutôt que d'annuler quoi que ce soit. #}
            <a href="{{ path(is_granted('ROLE_ADMIN') ? 'app_admin_candidature_index' : 'app_accueil_candidatures') }}"
               class="inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-lg text-sm font-medium
                      text-slate-600 bg-slate-100 hover:bg-slate-200 transition duration-200">
                Annuler
            </a>
            <button type="submit"
                    class="inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-lg text-sm font-medium text-white
                           bg-indigo-600 hover:bg-indigo-700 transition duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-600 focus-visible:ring-offset-2">
                <i class="fas fa-floppy-disk text-xs" aria-hidden="true"></i>Enregistrer les modifications
            </button>
        </div>
    </div>
</div>
{{ form_end(form) }}
{% endblock %}
