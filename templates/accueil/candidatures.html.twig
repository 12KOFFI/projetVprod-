{# Écran E3.9 : liste des candidatures du centre de l'agent. #}
{% extends 'base_dashboard.html.twig' %}
{% import 'partials/_ui.html.twig' as ui %}

{% block title %}Candidatures — {{ centre.nom }}{% endblock %}

{% block body %}
{{ ui.bandeau(
    'Candidatures du centre',
    centre.nom,
    'folder-open',
    pagination.getTotalItemCount,
    'dossier(s)'
) }}

<div class="bg-white rounded-lg border border-slate-200 overflow-hidden">
    <div class="px-6 py-5 border-b border-slate-200 flex flex-col lg:flex-row lg:items-center justify-between gap-4">
        <form method="get" class="flex flex-col sm:flex-row gap-3 flex-1">
            <div class="relative flex-1 max-w-xs">
                <i class="fas fa-magnifying-glass absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-500 text-sm"></i>
                <input type="search" name="q" value="{{ recherche }}" placeholder="Numéro VAE, nom ou téléphone"
                       class="w-full pl-10 pr-3.5 py-2.5 rounded-lg border border-slate-500 text-sm text-slate-700
                              focus:outline-none focus:ring-2 focus:ring-indigo-600 focus:border-indigo-600 transition duration-200">
            </div>

            <select name="statut" onchange="this.form.submit()"
                    class="px-3.5 py-2.5 rounded-lg border border-slate-500 text-sm text-slate-700 bg-white
                           focus:outline-none focus:ring-2 focus:ring-indigo-600 focus:border-indigo-600 transition duration-200">
                <option value="">Tous les statuts</option>
                {% for valeur, libelle in statuts %}
                    <option value="{{ valeur }}" {{ filtre_statut == valeur ? 'selected' : '' }}>{{ libelle }}</option>
                {% endfor %}
            </select>

            <button type="submit"
                    class="px-4 py-2.5 rounded-lg text-sm font-medium text-slate-600 bg-slate-100 hover:bg-slate-200 transition duration-200">
                Filtrer
            </button>
        </form>

        <a href="{{ path('app_accueil_inscription') }}"
           class="inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-lg text-sm font-medium text-white
                  bg-indigo-600 hover:bg-indigo-700 transition duration-200 shrink-0 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-600 focus-visible:ring-offset-2">
            <i class="fas fa-user-plus text-xs"></i>Nouvelle préinscription
        </a>
    </div>

    {% if pagination.getTotalItemCount > 0 %}
        {# ===== Tableau, à partir de l'écran large ===== #}
        <div class="hidden lg:block overflow-x-auto">
            <table class="w-full min-w-[900px]">
                <thead class="bg-slate-50 border-b border-slate-200">
                    <tr>
                        {{ ui.th('Numéro') }}
                        {{ ui.th('Candidat') }}
                        {{ ui.th('Métier') }}
                        {{ ui.th('Statut') }}
                        {{ ui.th('Déposé le') }}
                        {{ ui.th('Actions', 'text-right') }}
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    {% for candidature in pagination %}
                        <tr class="hover:bg-slate-50/70 transition duration-200">
                            <td class="px-6 py-4">
                                <span class="font-mono text-xs font-semibold text-indigo-600">{{ candidature.numero }}</span>
                            </td>
                            <td class="px-6 py-4">
                                <p class="text-sm font-medium text-slate-700">
                                    {{ candidature.user ? candidature.user.nomComplet : '—' }}
                                </p>
                                <p class="text-xs text-slate-600 mt-0.5">
                                    {{ candidature.user and candidature.user.contact ? candidature.user.contact : '—' }}
                                </p>
                            </td>
                            <td class="px-6 py-4 text-sm text-slate-600">
                                {{ candidature.metier ? candidature.metier.libelle : '—' }}
                            </td>
                            <td class="px-6 py-4">
                                {{ include('partials/_statut_badge.html.twig', { statut: statut_candidature(candidature) }) }}
                            </td>
                            <td class="px-6 py-4 text-sm text-slate-600 tabular-nums">
                                {{ candidature.creation ? candidature.creation|date('d/m/Y') : '—' }}
                            </td>
                            <td class="px-6 py-4 text-right">
                                {# Droits pilotés par CandidatureVoter : tout agent du centre, et non le seul auteur du dossier. #}
                                <div class="inline-flex items-center justify-end gap-2">
                                    {% if is_granted('CANDIDATURE_VIEW', candidature) %}
                                        {{ ui.bouton_lien(path('app_accueil_candidature', {id: candidature.id, mode: 'lecture'}), 'eye', 'Consulter', 'indigo', 'le dossier ' ~ candidature.numero) }}
                                    {% endif %}
                                    {% if is_granted('CANDIDATURE_EDIT', candidature) %}
                                        {{ ui.bouton_lien(path('app_accueil_candidature_modifier', {id: candidature.id}), 'pen', 'Modifier', 'amber', 'le dossier ' ~ candidature.numero) }}
                                    {% endif %}
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        {# ===== Liste empilée, sur petit écran ===== #}
        <ul class="lg:hidden divide-y divide-slate-100">
            {% for candidature in pagination %}
                <li class="px-4 py-4">
                    <div class="flex items-start justify-between gap-3">
                        <div class="min-w-0">
                            <p class="font-mono text-xs font-semibold text-indigo-600 tabular-nums">{{ candidature.numero }}</p>
                            <p class="text-sm font-medium text-slate-800 mt-1 truncate">
                                {{ candidature.user ? candidature.user.nomComplet : '—' }}
                            </p>
                            <p class="text-xs text-slate-600 mt-0.5 tabular-nums">
                                {{ candidature.user and candidature.user.contact ? candidature.user.contact : '—' }}
                            </p>
                            <p class="text-xs text-slate-600 mt-0.5">
                                {{ candidature.metier ? candidature.metier.libelle : '—' }}
                            </p>
                            {% if candidature.creation %}
                                <p class="text-xs text-slate-600 mt-0.5 tabular-nums">
                                    Déposé le {{ candidature.creation|date('d/m/Y') }}
                                </p>
                            {% endif %}
                        </div>
                        <div class="shrink-0">
                            {{ include('partials/_statut_badge.html.twig', { statut: statut_candidature(candidature) }) }}
                        </div>
                    </div>
                    <div class="mt-3 grid grid-cols-2 gap-2">
                        {% if is_granted('CANDIDATURE_VIEW', candidature) %}
                            {{ ui.bouton_lien(path('app_accueil_candidature', {id: candidature.id, mode: 'lecture'}), 'eye', 'Consulter', 'indigo', 'le dossier ' ~ candidature.numero) }}
                        {% endif %}
                        {% if is_granted('CANDIDATURE_EDIT', candidature) %}
                            {{ ui.bouton_lien(path('app_accueil_candidature_modifier', {id: candidature.id}), 'pen', 'Modifier', 'amber', 'le dossier ' ~ candidature.numero) }}
                        {% endif %}
                    </div>
                </li>
            {% endfor %}
        </ul>

        {{ ui.pagination(pagination) }}
    {% else %}
        {{ ui.etat_vide(
            'folder-open',
            'Aucune candidature',
            recherche or filtre_statut
                ? 'Aucun dossier ne correspond à votre recherche.'
                : 'Aucun dossier n\'a encore été déposé dans ce centre.',
            recherche or filtre_statut ? null : 'Commencez par une nouvelle préinscription'
        ) }}
    {% endif %}
</div>
{% endblock %}
