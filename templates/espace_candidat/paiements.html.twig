{# Écran E5.1 : les trois règlements du parcours (F5.4). #}
{% extends 'base_dashboard.html.twig' %}
{% import 'partials/_ui.html.twig' as ui %}

{% block title %}Mes paiements — VAE Côte d'Ivoire{% endblock %}

{% block body %}
{{ ui.bandeau(
    'Mes paiements',
    'Dossier ' ~ candidature.numero ~ ' — les trois règlements du parcours VAE.',
    'credit-card'
) }}

{% if simulation %}
    <div class="mb-6 rounded-lg bg-amber-50 border border-amber-200 p-4">
        <div class="flex items-start gap-3">
            <i class="fas fa-flask text-amber-500 mt-0.5"></i>
            <p class="text-xs text-amber-800 leading-relaxed">
                <strong>Mode simulation</strong> — la passerelle de paiement n'est pas encore raccordée.
                Aucun montant réel n'est prélevé : les règlements effectués ici servent à éprouver le parcours.
            </p>
        </div>
    </div>
{% endif %}

{# Fiche d'inscription : contrepartie du règlement des frais de dossier. #}
{% if fiche_disponible %}
    <div class="mb-6 bg-white rounded-lg border border-green-200 p-5">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div class="flex items-start gap-3">
                <div class="w-9 h-9 rounded-lg bg-green-50 text-green-500 flex items-center justify-center shrink-0">
                    <i class="fas fa-file-circle-check text-sm"></i>
                </div>
                <div>
                    <p class="text-sm font-semibold text-slate-800">Votre inscription est définitive</p>
                    <p class="text-xs text-slate-500 mt-0.5 leading-relaxed">
                        Votre fiche d'inscription est disponible : téléchargez-la et conservez-la.
                    </p>
                </div>
            </div>

            <a href="{{ path('app_candidat_fiche_inscription') }}" target="_blank" rel="noopener"
               class="inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-lg text-sm font-medium text-white
                      bg-indigo-600 hover:bg-indigo-700 transition duration-200 shrink-0 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-600 focus-visible:ring-offset-2">
                <i class="fas fa-file-pdf text-xs"></i>Ma fiche d'inscription
            </a>
        </div>
    </div>
{% endif %}

<div class="space-y-4">
    {% for ligne in frais %}
        {% set paiement = ligne.paiement %}
        {% set statut = paiement ? paiement.statut : null %}
        {% set echoue = statut is not null and statut.value == 'echoue' %}

        <div class="bg-white rounded-lg border p-5 md:p-6 transition-all duration-200
                    {% if ligne.regle %}border-green-200
                    {% elseif ligne.debloque %}border-indigo-200
                    {% elseif echoue %}border-red-200
                    {% else %}border-slate-200{% endif %}">
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-5">
                <div class="flex items-start gap-4 min-w-0">
                    {# L'état du frais se lit d'abord à son icône. #}
                    <div class="w-12 h-12 rounded-lg flex items-center justify-center shrink-0
                                {% if ligne.regle %}bg-green-50 text-green-500
                                {% elseif ligne.debloque %}bg-indigo-50 text-indigo-500
                                {% elseif echoue %}bg-red-50 text-red-500
                                {% else %}bg-slate-100 text-slate-500{% endif %}">
                        <i class="fas fa-{% if ligne.regle %}circle-check{% elseif ligne.debloque %}credit-card{% elseif echoue %}circle-exclamation{% else %}lock{% endif %} text-lg"></i>
                    </div>

                    <div class="min-w-0">
                        <div class="flex flex-wrap items-center gap-2">
                            <p class="text-sm font-bold text-slate-800">
                                {{ ligne.type.ordre }}. {{ ligne.type.libelle }}
                            </p>
                            {% if statut %}
                                {{ ui.badge(statut.libelle, statut.couleur) }}
                            {% elseif not ligne.debloque %}
                                {{ ui.badge('Verrouillé', 'slate') }}
                            {% endif %}
                        </div>

                        <p class="text-lg font-bold text-slate-800 tabular-nums mt-1.5">
                            {{ ligne.montant|number_format(0, ',', ' ') }} <span class="text-xs font-medium text-slate-600">FCFA</span>
                        </p>

                        {% if ligne.motif %}
                            <p class="text-xs text-slate-600 mt-1.5 leading-relaxed">{{ ligne.motif }}</p>
                        {% endif %}

                        {% if paiement and paiement.datePaiement %}
                            <p class="text-xs text-slate-600 mt-1.5">
                                Réglé le {{ paiement.datePaiement|date('d/m/Y à H\\hi') }}
                                {% if paiement.referencePaiement %}
                                    · réf. <span class="font-mono">{{ paiement.referencePaiement }}</span>
                                {% endif %}
                            </p>
                        {% endif %}
                    </div>
                </div>

                <div class="flex flex-wrap gap-2 shrink-0">
                    {% if ligne.regle and paiement %}
                        <a href="{{ path('app_candidat_paiement_recu', {id: paiement.id}) }}" target="_blank" rel="noopener"
                           class="inline-flex items-center gap-2 px-4 py-2.5 rounded-lg text-sm font-medium
                                  text-green-700 bg-green-50 border border-green-200 hover:bg-green-100 transition duration-200">
                            <i class="fas fa-receipt text-xs"></i>Mon reçu
                        </a>
                    {% elseif ligne.debloque %}
                        <a href="{{ path('app_candidat_paiement_payer', {type: ligne.type.value}) }}"
                           class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg text-sm font-medium text-white
                                  bg-indigo-600 hover:bg-indigo-700 transition duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-600 focus-visible:ring-offset-2">
                            <i class="fas fa-{{ echoue ? 'rotate-right' : 'credit-card' }} text-xs"></i>
                            {{ echoue ? 'Réessayer' : 'Payer' }}
                        </a>
                    {% else %}
                        <span class="inline-flex items-center gap-2 px-4 py-2.5 rounded-lg text-sm font-medium
                                     text-slate-600 bg-slate-50 border border-slate-200 cursor-not-allowed">
                            <i class="fas fa-lock text-xs"></i>Verrouillé
                        </span>
                    {% endif %}
                </div>
            </div>

            {% if echoue and paiement and paiement.tentatives > 0 %}
                <div class="mt-4 rounded-lg bg-red-50 border border-red-200 p-3">
                    <p class="text-xs text-red-800 leading-relaxed">
                        <i class="fas fa-circle-exclamation mr-1.5"></i>
                        Le dernier règlement n'a pas abouti ({{ paiement.tentatives }} tentative(s)).
                        Vous pouvez réessayer, éventuellement avec un autre moyen de paiement.
                    </p>
                </div>
            {% endif %}
        </div>
    {% endfor %}
</div>

<div class="mt-6">
    <a href="{{ path('app_candidat_dashboard') }}"
       class="inline-flex items-center gap-2 px-4 py-2.5 rounded-lg text-sm font-medium
              text-slate-600 bg-slate-100 hover:bg-slate-200 transition duration-200">
        <i class="fas fa-arrow-left text-xs"></i>Retour à mon espace
    </a>
</div>
{% endblock %}
