{# Écran E3.3 : confirmation de dépôt et remise du numéro VAE (F3.4). #}
{% extends 'base_dashboard.html.twig' %}
{% import 'partials/_ui.html.twig' as ui %}

{% block title %}Dossier déposé — VAE Côte d'Ivoire{% endblock %}

{% block body %}
<div class="max-w-2xl mx-auto">
    <div class="bg-white rounded-2xl border border-slate-200 overflow-hidden">
        <div class="bg-green-700 px-6 py-10 text-center text-white">
            <div class="w-16 h-16 mx-auto mb-4 rounded-2xl bg-white text-green-700 flex items-center justify-center">
                <i class="fas fa-check text-2xl" aria-hidden="true"></i>
            </div>
            <h1 class="text-xl md:text-2xl font-bold tracking-tight">Votre dossier a été déposé</h1>
            <p class="text-green-50 text-sm mt-2 max-w-md mx-auto leading-relaxed">
                Conservez précieusement votre numéro d'inscription : il vous servira à suivre
                votre dossier et à consulter vos résultats.
            </p>
        </div>

        <div class="px-6 py-8 text-center border-b border-slate-100">
            <p class="text-xs font-semibold uppercase tracking-widest text-slate-600 mb-3">
                Votre numéro d'inscription
            </p>
            <p class="font-mono text-2xl md:text-3xl font-bold tracking-tight text-indigo-600
                      bg-indigo-50 border border-indigo-100 rounded-xl py-4 px-6 inline-block">
                {{ candidature.numero }}
            </p>
        </div>

        <dl class="divide-y divide-slate-100">
            <div class="px-6 py-4 flex items-center justify-between gap-3">
                <dt class="text-sm text-slate-600">Métier visé</dt>
                <dd class="text-sm font-semibold text-slate-700 text-right">
                    {{ candidature.metier ? candidature.metier.libelle : '—' }}
                </dd>
            </div>
            <div class="px-6 py-4 flex items-center justify-between gap-3">
                <dt class="text-sm text-slate-600">Centre</dt>
                <dd class="text-sm font-semibold text-slate-700 text-right">
                    {{ candidature.centre ? candidature.centre.nom : '—' }}
                </dd>
            </div>
            <div class="px-6 py-4 flex items-center justify-between gap-3">
                <dt class="text-sm text-slate-600">Diplôme visé</dt>
                <dd class="text-sm font-semibold text-slate-700 text-right">{{ candidature.diplomedemande ?: '—' }}</dd>
            </div>
            <div class="px-6 py-4 flex items-center justify-between gap-3">
                <dt class="text-sm text-slate-600">Statut</dt>
                <dd>{{ include('partials/_statut_badge.html.twig', { statut: statut_candidature(candidature) }) }}</dd>
            </div>
        </dl>

        <div class="px-6 py-5 bg-amber-50 border-t border-amber-200">
            <div class="flex items-start gap-3">
                <i class="fas fa-circle-info text-amber-500 mt-0.5"></i>
                <p class="text-xs text-amber-800 leading-relaxed">
                    Votre inscription n'est pas encore définitive. Elle le deviendra une fois votre
                    dossier accepté par le conseiller VAE, puis les frais de dossier réglés.
                </p>
            </div>
        </div>

        <div class="px-6 py-5">
            <a href="{{ path('app_candidat_dashboard') }}"
               class="w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-lg text-sm font-medium text-white
                      bg-indigo-600 hover:bg-indigo-700 transition-colors duration-200">
                <i class="fas fa-route text-xs"></i>Suivre mon dossier
            </a>
        </div>
    </div>
</div>
{% endblock %}
