{# Écrans E3.2 et E3.5 : dépôt et modification du dossier par le candidat. #}
{% extends 'base_dashboard.html.twig' %}
{% import 'partials/_ui.html.twig' as ui %}

{% set edition = candidature is not null %}

{% block title %}{{ edition ? 'Modifier mon dossier' : 'Déposer mon dossier' }} — VAE Côte d'Ivoire{% endblock %}

{% block body %}
{{ ui.bandeau(
    edition ? 'Modifier mon dossier' : 'Déposer mon dossier de candidature',
    edition
        ? 'Dossier ' ~ candidature.numero ~ " — modifiable tant que son étude n'est pas acceptée."
        : 'Renseignez votre parcours et joignez vos pièces justificatives.',
    edition ? 'pen-to-square' : 'file-circle-plus'
) }}

{{ form_start(form, {attr: {novalidate: 'novalidate', 'x-data': 'depotCandidature()', '@submit': 'verifierAvantEnvoi($event)'}}) }}
<div class="space-y-6">

    {% if form.vars.errors|length > 0 %}
        <div role="alert" class="rounded-lg p-4 text-sm bg-red-50 text-red-800 border border-red-200">
            <div class="flex items-start gap-3">
                <i class="fas fa-exclamation-circle text-red-600 mt-0.5" aria-hidden="true"></i>
                <div>{{ form_errors(form) }}</div>
            </div>
        </div>
    {% endif %}

    {# ===== Formation visée (indigo) ===== #}
    <div class="bg-white rounded-lg border border-slate-200 p-6">
        {{ ui.section('Formation visée', 'Centre de dépôt et métier de certification', 'graduation-cap', 'indigo') }}

        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            {% if form.centre is defined %}
                <div>
                    {{ form_label(form.centre, null, {label_attr: {class: 'block text-xs font-semibold text-slate-600 mb-1.5'}}) }}
                    {{ form_widget(form.centre, {attr: {
                        class: 'w-full px-3.5 py-2.5 rounded-lg border border-slate-500 text-sm text-slate-700 bg-white
                                focus:outline-none focus:ring-2 focus:ring-indigo-600 focus:border-indigo-600 transition duration-200',
                        'x-ref': 'centre',
                        '@change': 'chargerMetiers()'
                    }}) }}
                    {{ form_errors(form.centre) }}
                </div>
            {% endif %}

            <div>
                {{ form_label(form.metier, null, {label_attr: {class: 'block text-xs font-semibold text-slate-600 mb-1.5'}}) }}
                {{ form_widget(form.metier, {attr: {
                    class: 'w-full px-3.5 py-2.5 rounded-lg border border-slate-500 text-sm text-slate-700 bg-white
                            focus:outline-none focus:ring-2 focus:ring-indigo-600 focus:border-indigo-600 transition duration-200',
                    'x-ref': 'metier',
                    '@change': 'chargerCertifications()'
                }}) }}
                <p class="text-xs text-slate-600 mt-1.5" x-show="chargement">
                    <i class="fas fa-circle-notch fa-spin mr-1"></i>Chargement des métiers du centre…
                </p>
                {% if candidature is defined and candidature %}
                    {{ ui.choix_initial(form.metier, candidature.metier ? candidature.metier.libelle : null, 'un métier') }}
                {% endif %}
                {{ form_errors(form.metier) }}
            </div>
        </div>
    </div>

    {# ===== Expérience professionnelle (amber) ===== #}
    <div class="bg-white rounded-lg border border-slate-200 p-6">
        {{ ui.section('Expérience professionnelle', 'Elle vous aide à choisir le diplôme visé', 'briefcase', 'amber') }}

        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            {{ ui.champ(form.nbAnneesExperience) }}
            <div>
                {{ form_label(form.certification, null, {label_attr: {class: 'block text-xs font-semibold text-slate-600 mb-1.5'}}) }}
                {{ form_widget(form.certification, {attr: {
                    class: 'w-full px-3.5 py-2.5 rounded-lg border border-slate-500 text-sm text-slate-700 bg-white
                            focus:outline-none focus:ring-2 focus:ring-indigo-600 focus:border-indigo-600 transition duration-200',
                    'x-ref': 'certification',
                    'data-centre': form.vars.data.centre ? form.vars.data.centre.id : ''
                }}) }}
                <p class="text-xs text-slate-600 mt-1.5" x-show="chargementCertifications">
                    <i class="fas fa-circle-notch fa-spin mr-1"></i>Chargement des diplômes du centre…
                </p>
                {% if candidature is defined and candidature %}
                    {{ ui.choix_initial(form.certification, candidature.diplomedemande, 'un diplôme') }}
                {% endif %}
                {{ form_errors(form.certification) }}
            </div>
            {{ ui.champ(form.situationPro) }}
            {{ ui.champ(form.diplome) }}
            {{ ui.champ(form.titrepro) }}
        </div>

        <div class="mt-5 rounded-lg bg-amber-50 border border-amber-200 p-4">
            <div class="flex items-start gap-3">
                <i class="fas fa-lightbulb text-amber-500 mt-0.5"></i>
                <p class="text-xs text-amber-800 leading-relaxed">
                    Au moins 5 ans d'expérience pour le <strong>CQP</strong> ; au moins 7 ans pour
                    le <strong>CAP</strong>.
                </p>
            </div>
        </div>
    </div>

    {# ===== Entreprise (orange) ===== #}
    <div class="bg-white rounded-lg border border-slate-200 p-6">
        {{ ui.section('Entreprise ou atelier', 'Facultatif — à renseigner si vous exercez actuellement', 'building', 'orange') }}

        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            {{ ui.champ(form.nomEntreprise) }}
            {{ ui.champ(form.refentreprise) }}
            {{ ui.champ(form.lieuExercice) }}
            {{ ui.champ(form.directionService) }}
            {{ ui.champ(form.fonction) }}
            {{ ui.champ(form.refContrat) }}
            {{ ui.champ(form.contactemployeur) }}
            {{ ui.champ(form.langue) }}
            {{ ui.champ(form.preciserlangue) }}
        </div>
    </div>

    {# ===== Pièces justificatives (purple) ===== #}
    <div class="bg-white rounded-lg border border-slate-200 p-6">
        {{ ui.section('Pièces justificatives', 'Formats acceptés : JPG, PNG ou PDF — 2 Mo maximum par pièce', 'paperclip', 'purple') }}

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            {% for champ, libelle in documents_obligatoires %}
                {% if form[champ] is defined %}
                    {{ ui.document(
                        form[champ],
                        libelle,
                        true,
                        edition ? attribute(candidature, champ) : null
                    ) }}
                {% endif %}
            {% endfor %}
        </div>
    </div>

    {# ===== Actions ===== #}
    <div class="bg-white rounded-lg border border-slate-200 p-5 flex flex-col sm:flex-row items-center justify-between gap-4">
        <p class="text-xs text-slate-600 leading-relaxed">
            <i class="fas fa-lock mr-1.5 opacity-60"></i>
            Les champs marqués d'un <span class="text-red-500">*</span> sont obligatoires.
        </p>

        <div class="flex flex-col sm:flex-row gap-3 w-full sm:w-auto">
            <a href="{{ path('app_candidat_dashboard') }}"
               class="inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-lg text-sm font-medium
                      text-slate-600 bg-slate-100 hover:bg-slate-200 transition duration-200">
                Annuler
            </a>
            <button type="submit"
                    class="inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-lg text-sm font-medium text-white
                           bg-indigo-600 hover:bg-indigo-700 transition duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-600 focus-visible:ring-offset-2">
                <i class="fas fa-{{ edition ? 'floppy-disk' : 'paper-plane' }} text-xs"></i>
                {{ edition ? 'Enregistrer les modifications' : 'Déposer mon dossier' }}
            </button>
        </div>
    </div>
</div>
{{ form_end(form) }}
{% endblock %}

