{# Écran E5.2 : choix du moyen de règlement (F5.5). #}
{% extends 'base_dashboard.html.twig' %}
{% import 'partials/_ui.html.twig' as ui %}

{% block title %}Régler les {{ type.libelle|lower }} — VAE Côte d'Ivoire{% endblock %}

{% block body %}
<div class="max-w-2xl mx-auto">
    {% if simulation %}
        <div class="mb-6 rounded-lg bg-amber-50 border border-amber-200 p-4">
            <div class="flex items-start gap-3">
                <i class="fas fa-flask text-amber-500 mt-0.5"></i>
                <p class="text-xs text-amber-800 leading-relaxed">
                    <strong>SIMULATION — aucun paiement réel.</strong>
                    La passerelle du Trésor n'est pas encore raccordée : aucun montant ne sera prélevé.
                </p>
            </div>
        </div>
    {% endif %}

    <form method="post" x-data="{ moyen: '' }">
        <input type="hidden" name="_token" value="{{ csrf_token('paiement_' ~ type.value) }}">

        <div class="bg-white rounded-lg border border-slate-200 overflow-hidden">
            {# ===== Récapitulatif ===== #}
            <div class="px-6 py-8 text-center border-b border-slate-100">
                <p class="text-xs font-semibold uppercase tracking-wide text-slate-600">
                    {{ type.libelle }}
                </p>
                <p class="text-3xl font-bold text-indigo-600 tabular-nums mt-3">
                    {{ montant|number_format(0, ',', ' ') }}
                    <span class="text-base font-medium text-slate-600">FCFA</span>
                </p>
                <p class="text-xs text-slate-600 mt-3">
                    Dossier <span class="font-mono text-indigo-600">{{ candidature.numero }}</span>
                    · {{ candidature.metier ? candidature.metier.libelle : '—' }}
                </p>
            </div>

            {# ===== Moyens de paiement ===== #}
            <div class="p-6">
                <p class="text-xs font-semibold text-slate-600 mb-4">Choisissez votre moyen de paiement</p>

                <div class="space-y-3">
                    {% for option in moyens %}
                        <label class="flex items-center gap-4 p-4 rounded-lg border-2 cursor-pointer transition-all duration-200"
                               :class="moyen === '{{ option.value }}'
                                   ? 'border-indigo-500 bg-indigo-50/50'
                                   : 'border-slate-200 hover:border-indigo-300 hover:bg-indigo-50/20'">
                            <input type="radio" name="moyen" value="{{ option.value }}" x-model="moyen" required class="sr-only">

                            <div class="w-11 h-11 rounded-lg flex items-center justify-center shrink-0 transition-colors duration-200"
                                 :class="moyen === '{{ option.value }}' ? 'bg-indigo-100 text-indigo-600' : 'bg-slate-100 text-slate-600'">
                                <i class="fas fa-{{ option.icone }}"></i>
                            </div>

                            <div class="flex-1 min-w-0">
                                <p class="text-sm font-semibold text-slate-800">{{ option.libelle }}</p>
                                <p class="text-xs text-slate-600 mt-0.5">{{ option.description }}</p>
                            </div>

                            <span class="w-5 h-5 rounded-full border-2 flex items-center justify-center shrink-0 transition-colors duration-200"
                                  :class="moyen === '{{ option.value }}' ? 'border-indigo-600 bg-indigo-600' : 'border-slate-300'">
                                <i class="fas fa-check text-xs text-white" x-show="moyen === '{{ option.value }}'" x-cloak></i>
                            </span>
                        </label>
                    {% endfor %}
                </div>
            </div>

            {# ===== Actions ===== #}
            <div class="px-6 py-5 bg-slate-50 border-t border-slate-100 flex flex-col sm:flex-row gap-3">
                <a href="{{ path('app_candidat_paiements') }}"
                   class="flex-1 inline-flex items-center justify-center gap-2 px-4 py-3 rounded-lg text-sm font-medium
                          text-slate-600 bg-white border border-slate-200 hover:bg-slate-100 transition duration-200">
                    Annuler
                </a>
                <button type="submit" :disabled="!moyen"
                        class="flex-1 inline-flex items-center justify-center gap-2 px-5 py-3 rounded-lg text-sm font-medium text-white
                               bg-indigo-600 hover:bg-indigo-700 transition duration-200
                               disabled:opacity-50 disabled:cursor-not-allowed disabled:hover:translate-y-0 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-600 focus-visible:ring-offset-2">
                    <i class="fas fa-lock text-xs"></i>
                    Payer {{ montant|number_format(0, ',', ' ') }} FCFA
                </button>
            </div>
        </div>
    </form>
</div>
{% endblock %}
