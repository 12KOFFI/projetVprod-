{# Espace accompagnateur : candidats suivis et avancement de leur livret de preuves. #}
{% extends 'base_dashboard.html.twig' %}
{% import 'partials/_ui.html.twig' as ui %}

{% block title %}Espace accompagnateur — Côte d'Ivoire VAE{% endblock %}

{% block body %}
{{ ui.bandeau(
    'Espace accompagnateur',
    (accompagnateur.centre ? accompagnateur.centre.nom : 'Centre non renseigné')
        ~ (accompagnateur.metier ? ' · ' ~ accompagnateur.metier.libelle : ''),
    'hands-helping'
) }}

<div class="grid grid-cols-1 gap-3 sm:grid-cols-3 sm:gap-5 mb-6">
    {{ ui.stat('Candidats suivis', suivis|length, 'users', 'indigo') }}
    {{ ui.stat('Preuves déposées', total_preuves, 'book-open', 'green') }}
    {{ ui.stat('Livrets encore vides', sans_preuve, 'hourglass-half', 'amber') }}
</div>

<section class="bg-white rounded-lg border border-slate-200 overflow-hidden" aria-labelledby="suivis-titre">
    <div class="px-4 py-4 sm:px-6 sm:py-5 border-b border-slate-200">
        <h2 id="suivis-titre" class="text-sm font-bold text-slate-800">Mes candidats</h2>
        <p class="text-sm text-slate-600 mt-0.5">Candidats qui vous ont choisi et ont réglé les frais d'accompagnement.</p>
    </div>

    {% if suivis is not empty %}
        <div class="divide-y divide-slate-100">
            {% for candidature in suivis %}
                {% set n = nb_preuves[candidature.id] ?? 0 %}
                <a href="{{ path('app_accompagnement_candidat', {id: candidature.id}) }}"
                   class="flex flex-col gap-2 px-4 py-4 transition duration-150 hover:bg-slate-50 focus-visible:bg-slate-50 focus-visible:outline-none sm:flex-row sm:items-center sm:justify-between sm:px-6">
                    <div class="min-w-0">
                        <p class="font-mono text-sm font-semibold text-indigo-700">{{ candidature.numero }}</p>
                        <p class="mt-0.5 font-medium text-slate-900">{{ candidature.user.nomComplet }}</p>
                        <p class="text-sm text-slate-600">{{ candidature.metier ? candidature.metier.libelle : '—' }} · {{ candidature.diplomedemande ?: '—' }}</p>
                    </div>
                    <div class="flex shrink-0 items-center gap-3">
                        {{ include('partials/_statut_badge.html.twig', { statut: statut_candidature(candidature) }) }}
                        <span class="inline-flex items-center gap-1.5 text-sm {{ n == 0 ? 'text-amber-700' : 'text-slate-700' }}">
                            <i class="fas fa-book-open text-xs" aria-hidden="true"></i>{{ n }} preuve{{ n > 1 ? 's' }}
                        </span>
                        <i class="fas fa-chevron-right text-xs text-slate-500" aria-hidden="true"></i>
                    </div>
                </a>
            {% endfor %}
        </div>
    {% else %}
        {{ ui.etat_vide('users', 'Aucun candidat pour l\'instant', 'Les candidats éligibles de votre centre et de votre métier vous choisissent depuis leur espace ; ils apparaissent ici après le règlement des frais d\'accompagnement.') }}
    {% endif %}
</section>
{% endblock %}
