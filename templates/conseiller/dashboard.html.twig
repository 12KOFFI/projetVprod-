{# Écran E4.1 : tableau de bord du conseiller VAE (F4.1). #}
{% extends 'base_dashboard.html.twig' %}
{% import 'partials/_ui.html.twig' as ui %}

{% block title %}Espace conseiller — {{ centre.nom }}{% endblock %}

{% block body %}
<div class="relative mb-6 overflow-hidden rounded-2xl border border-primary-200 bg-primary-100 p-6 text-primary-900 md:p-8">

    <div class="relative z-10 flex flex-col lg:flex-row lg:items-center lg:justify-between gap-5">
        <div class="flex items-center gap-4">
            <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl border border-primary-200 bg-white text-2xl text-primary-700">
                <i class="fas fa-user-tie" aria-hidden="true"></i>
            </div>
            <div>
                <h1 class="text-2xl font-bold tracking-tight text-primary-900 md:text-3xl">Espace conseiller VAE</h1>
                <p class="text-primary-800 text-sm mt-0.5">{{ centre.nom }} — étude et recevabilité des dossiers.</p>
            </div>
        </div>
    </div>
    <div class="absolute inset-x-0 bottom-0 h-1 bg-[#ED8F33]" aria-hidden="true"></div>
</div>

{# ===== Indicateurs — Parcours du dossier ===== #}
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 mb-5">
    {{ ui.stat('Préinscrits à étudier', compteurs.a_traiter, 'inbox', 'amber') }}
    {{ ui.stat('Acceptés (attente paiement)', compteurs.attente_paiement, 'hourglass-half', 'indigo') }}
    {{ ui.stat('Candidats inscrits', compteurs.inscrits, 'gavel', 'indigo') }}
    {{ ui.stat('Recevables', compteurs.recevables, 'circle-check', 'green') }}
</div>

{# ===== Indicateurs — Synthèse ===== #}
<div class="grid grid-cols-1 sm:grid-cols-2 gap-5 mb-8">
    {{ ui.stat('Non recevables', compteurs.non_recevables, 'circle-xmark', 'red') }}
    {{ ui.stat('Mes dossiers en charge', ma_charge, 'folder-open', 'purple') }}
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    {# ===== Dossiers à traiter ===== #}
    <div class="lg:col-span-2 bg-white rounded-lg border border-slate-200 overflow-hidden">
        <div class="px-6 py-5 border-b border-slate-200 flex items-center justify-between gap-3">
            <div>
                <h2 class="text-sm font-bold text-slate-800">Dossiers en attente d'étude</h2>
                <p class="text-xs text-slate-600 mt-0.5">Les plus anciens d'abord</p>
            </div>
            <a href="{{ path('app_conseiller_candidatures') }}"
               class="text-xs font-medium text-indigo-600 hover:text-indigo-700 transition duration-200 shrink-0">
                Tout voir<i class="fas fa-arrow-right ml-1.5 text-xs"></i>
            </a>
        </div>

        {% if recents is not empty %}
            <div class="divide-y divide-slate-100">
                {% for candidature in recents %}
                    <a href="{{ path('app_conseiller_candidature', {id: candidature.id}) }}"
                       class="px-6 py-4 flex items-center justify-between gap-4 hover:bg-slate-50/70 transition duration-200">
                        <div class="min-w-0">
                            <p class="font-mono text-xs font-semibold text-indigo-600">{{ candidature.numero }}</p>
                            <p class="text-sm font-medium text-slate-700 mt-0.5 truncate">
                                {{ candidature.user ? candidature.user.nomComplet : '—' }}
                            </p>
                            <p class="text-xs text-slate-600 mt-0.5">
                                {{ candidature.metier ? candidature.metier.libelle : '—' }}
                                {% if candidature.creation %}
                                    · déposé le {{ candidature.creation|date('d/m/Y') }}
                                {% endif %}
                            </p>
                        </div>
                        <i class="fas fa-chevron-right text-slate-500 text-xs shrink-0"></i>
                    </a>
                {% endfor %}
            </div>
        {% else %}
            {{ ui.etat_vide(
                'inbox',
                'Aucun dossier en attente',
                'Tous les dossiers déposés dans votre centre ont été pris en charge.'
            ) }}
        {% endif %}
    </div>

    {# ===== Accès rapides ===== #}
    <div class="bg-white rounded-lg border border-slate-200 overflow-hidden">
        <div class="px-6 py-5 border-b border-slate-200">
            <h2 class="text-sm font-bold text-slate-800">Mes listes</h2>
        </div>
        <div class="p-6 space-y-3">
            <a href="{{ path('app_conseiller_mes_analyses') }}"
               class="w-full inline-flex items-center gap-3 px-4 py-3.5 rounded-lg text-sm font-medium
                      text-slate-700 bg-slate-100 hover:bg-slate-200 transition duration-200">
                <i class="fas fa-gavel text-slate-600"></i>
                <span class="text-left">
                    Mes dossiers inscrits
                    <span class="block text-xs font-normal text-slate-600">Recevabilité à prononcer</span>
                </span>
            </a>
            <a href="{{ path('app_impressions') }}"
               class="w-full inline-flex items-center gap-3 px-4 py-3.5 rounded-lg text-sm font-medium
                      text-slate-700 bg-slate-100 hover:bg-slate-200 transition duration-200">
                <i class="fas fa-print text-slate-600"></i>
                <span class="text-left">
                    Impressions
                    <span class="block text-xs font-normal text-slate-600">Fiche, recevables, statistiques</span>
                </span>
            </a>
            {% if compteurs.non_affectees > 0 %}
                <a href="{{ path('app_conseiller_candidatures', {portee: 'non_affectes'}) }}"
                   class="w-full inline-flex items-center gap-3 px-4 py-3.5 rounded-lg text-sm font-medium
                          text-amber-800 bg-amber-50 border border-amber-200 hover:bg-amber-100 transition duration-200">
                    <i class="fas fa-hand text-amber-500"></i>
                    <span class="text-left">
                        {{ compteurs.non_affectees }} dossier(s) sans conseiller
                        <span class="block text-xs font-normal text-amber-600">À prendre en charge</span>
                    </span>
                </a>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}

