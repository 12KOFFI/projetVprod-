{#
    Écran E4.3/E4.4 : fiche d'un dossier pour le conseiller VAE.

    Tant que l'étude reste à rendre, la fiche est un seul formulaire : le
    conseiller vérifie les pièces, joint le justificatif d'expérience
    professionnelle (obligatoire, lui seul le dépose), corrige au besoin les
    informations déclarées par le candidat, puis rend sa décision d'étude. La
    décision reste dans la colonne de droite pendant toute la lecture (en bas
    de page sur mobile) ; les corrections partent avec elle, en un seul envoi.

    Une fois l'étude acceptée, la fiche passe en lecture seule : la
    recevabilité revient au jury local du centre (jury_local/candidature.html.twig).
#}
{% extends 'base_dashboard.html.twig' %}
{% import 'partials/_ui.html.twig' as ui %}
{% import 'candidature/_depot.html.twig' as depot %}
{% import 'candidature/_fiche.html.twig' as fiche %}


{#
  Ligne d'une pièce en mode édition : consultation et remplacement. Le champ
  fichier, masqué, reste dans un conteneur qui porte l'anneau de focus du
  clavier. sur_changement : instruction Alpine ajoutée au contrôle du fichier.
#}
{% macro ligne_piece(form, candidature, champ, libelle, existant, par_le_conseiller = false, sur_changement = '') %}
<li id="piece-{{ champ }}" class="scroll-mt-6 px-5 py-4 sm:px-6" x-data="pieceJustificative()">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <div class="flex min-w-0 items-center gap-3">
            <span class="w-5 shrink-0 text-center text-lg" aria-hidden="true">
                <i class="fas fa-circle-check text-green-600" x-show="fichier" x-cloak></i>
                <i class="fas {{ existant ? (existant ends with '.pdf' ? 'fa-file-pdf text-slate-500' : 'fa-file-image text-slate-500') : 'fa-file-circle-xmark text-amber-600' }}" x-show="!fichier"></i>
            </span>
            <div class="min-w-0">
                <p class="text-sm font-medium text-slate-900">
                    {{ libelle }}<span class="ml-1 text-red-600" aria-hidden="true">*</span><span class="sr-only"> (obligatoire)</span>
                </p>
                <p class="text-sm {{ existant ? 'text-slate-600' : 'font-medium text-amber-800' }}" x-show="!fichier && !erreur">
                    {% if existant %}
                        {{ existant ends with '.pdf' ? 'Document PDF transmis' : 'Image transmise' }}
                    {% elseif par_le_conseiller %}
                        À joindre par vous
                    {% else %}
                        Non fournie par le candidat
                    {% endif %}
                </p>
                <p class="text-sm font-medium text-green-700" x-show="fichier" x-cloak
                   x-text="fichier ? 'Nouveau fichier : ' + fichier.nom + ' (' + fichier.taille + ' Mo), envoyé avec votre décision' : ''"></p>
                <p class="text-sm font-medium text-red-700" x-show="erreur" x-cloak x-text="erreur"></p>
            </div>
        </div>

        <div class="flex flex-wrap gap-2 sm:shrink-0">
            {% if existant %}
                <a href="{{ path('app_piece', {id: candidature.id, champ: champ}) }}" target="_blank" rel="noopener"
                   class="inline-flex min-h-[44px] items-center gap-2 rounded-lg border border-slate-300 bg-white px-4 text-sm font-medium text-indigo-700
                          transition duration-150 motion-reduce:transition-none hover:border-indigo-300 hover:bg-indigo-50
                          focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-600 focus-visible:ring-offset-2">
                    <i class="fas fa-arrow-up-right-from-square text-xs" aria-hidden="true"></i>Ouvrir<span class="sr-only"> : {{ libelle }}</span>
                </a>
            {% endif %}
            {% if form[champ] is defined %}
                <div class="inline-flex rounded-lg focus-within:ring-2 focus-within:ring-indigo-600 focus-within:ring-offset-2">
                    {{ form_widget(form[champ], {attr: {
                        class: 'sr-only',
                        '@change': 'verifier($event)' ~ (sur_changement ? '; ' ~ sur_changement : '')
                    }}) }}
                    <label for="{{ form[champ].vars.id }}"
                           class="inline-flex min-h-[44px] cursor-pointer items-center gap-2 rounded-lg px-4 text-sm font-medium
                                  transition duration-150 motion-reduce:transition-none
                                  {{ existant ? 'border border-slate-300 bg-white text-slate-700 hover:bg-slate-50' : 'bg-indigo-600 text-white hover:bg-indigo-700' }}">
                        <i class="fas fa-arrow-up-from-bracket text-xs" aria-hidden="true"></i>{{ existant ? 'Remplacer' : 'Joindre le fichier' }}<span class="sr-only"> : {{ libelle }}</span>
                    </label>
                </div>
            {% endif %}
        </div>
    </div>
    {% if form[champ] is defined %}
        {{ form_errors(form[champ]) }}
    {% endif %}
</li>
{% endmacro %}

{% set candidat = candidature.user %}
{% set etude = candidature.resultatEtude %}
{% set edition = form_candidature is not null %}

{% block title %}Dossier {{ candidature.numero }} — {{ candidat ? (candidat.nomComplet|title) : '' }} — Conseiller VAE{% endblock %}

{% block body %}
{% import _self as page %}

<a href="{{ path('app_conseiller_candidatures') }}"
   class="mb-4 inline-flex min-h-[44px] items-center gap-2 rounded-lg text-sm font-medium text-slate-700
          transition duration-150 motion-reduce:transition-none hover:text-indigo-700
          focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-600 focus-visible:ring-offset-2">
    <i class="fas fa-arrow-left text-xs" aria-hidden="true"></i>Retour à la liste des dossiers
</a>

{{ fiche.entete(candidature) }}

{# ===== Prise en charge : visible avant tout défilement ===== #}
{% if edition and is_granted('CANDIDATURE_EVALUATE_RECEVABILITE', candidature)
    and (candidature.conseiller is null or candidature.conseiller.id != app.user.id) %}
    {% set non_affecte = candidature.conseiller is null %}
    <div class="mb-6 flex flex-col gap-3 rounded-lg border p-4 sm:flex-row sm:items-center sm:justify-between
                {{ non_affecte ? 'border-amber-200 bg-amber-50' : 'border-slate-200 bg-white' }}">
        <p class="flex items-center gap-3 text-sm {{ non_affecte ? 'text-amber-900' : 'text-slate-700' }}">
            <i class="fas fa-user-check {{ non_affecte ? 'text-amber-700' : 'text-slate-500' }}" aria-hidden="true"></i>
            <span>
                {% if non_affecte %}
                    <strong class="font-semibold">Aucun conseiller ne suit ce dossier.</strong> Prenez-le en charge avant de l'étudier.
                {% else %}
                    Dossier suivi par <strong class="font-semibold text-slate-900">{{ candidature.conseiller.nomComplet }}</strong>.
                {% endif %}
            </span>
        </p>
        {{ ui.bouton_post(
            path('app_conseiller_affecter', {id: candidature.id}),
            'affecter_' ~ candidature.id,
            'user-check',
            non_affecte ? 'Prendre en charge' : 'Reprendre en charge',
            'indigo'
        ) }}
    </div>
{% endif %}

{% if edition %}
    {% set annees = candidature.nbAnneesExperience %}
    {% set manquantes = documents_obligatoires|filter((libelle, champ) => documents[champ] is not defined) %}
    {% set justificatif = candidature.fexperiencepro %}

    {{ form_start(form_candidature, {attr: {
        novalidate: 'novalidate',
        enctype: 'multipart/form-data',
        'x-data': 'depotCandidature()',
        '@submit': 'verifierAvantEnvoi($event)',
        action: path('app_conseiller_recevabilite', {id: candidature.id})
    }}) }}

    {% if form_candidature.vars.errors|length > 0 %}
        <div role="alert" class="mb-6 rounded-lg border border-red-200 bg-red-50 p-4 text-sm text-red-800">
            <div class="flex items-start gap-3">
                <i class="fas fa-circle-exclamation mt-0.5 text-red-600" aria-hidden="true"></i>
                <div>{{ form_errors(form_candidature) }}</div>
            </div>
        </div>
    {% endif %}

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-3"
         x-data="decisionDossier({{ (form_etude.statut.vars.value ?: null)|json_encode }}, { present: {{ justificatif ? 'true' : 'false' }}, cible: 'piece-fexperiencepro' })">

        <div class="space-y-6 lg:col-span-2 lg:row-start-1">

            {% if etude and etude.name != 'EN_ATTENTE' %}
                <div role="note" class="rounded-lg border border-amber-200 bg-amber-50 p-4 text-sm text-amber-900">
                    <p class="font-semibold">
                        Étude précédente : {{ etude.libelle|lower }}{% if candidature.etuDate %} le <span class="tabular-nums">{{ candidature.etuDate|date('d/m/Y') }}</span>{% endif %}.
                    </p>
                    {% if candidature.etuCom %}
                        <p class="mt-1 whitespace-pre-line">{{ candidature.etuCom }}</p>
                    {% endif %}
                    <p class="mt-2">Le candidat a pu corriger son dossier depuis : rendez une nouvelle décision.</p>
                </div>
            {% endif %}

            {# ===== Points de contrôle ===== #}
            <section class="overflow-hidden rounded-lg border border-slate-200 bg-white" aria-labelledby="titre-controle">
                {{ fiche.titre_panneau('Points de contrôle', 'À vérifier avant de rendre l\'étude.', 'titre-controle') }}
                <ul class="divide-y divide-slate-200">
                    <li class="flex items-start gap-3 px-5 py-4 sm:px-6">
                        {# Simple rappel de la déclaration du candidat : l'application ne
                           tire aucune conclusion, c'est le conseiller qui apprécie. #}
                        <i class="fas fa-circle-info mt-0.5 w-5 shrink-0 text-center text-slate-500" aria-hidden="true"></i>
                        <div class="min-w-0 text-sm">
                            <p class="font-medium text-slate-900">Déclaration du candidat</p>
                            <dl class="mt-1 grid grid-cols-1 gap-x-6 gap-y-1 sm:grid-cols-2">
                                <div>
                                    <dt class="inline text-slate-600">Années d'expérience :</dt>
                                    <dd class="inline font-medium text-slate-900 tabular-nums">{{ annees is not null ? annees ~ ' an(s)' : 'non renseignées' }}</dd>
                                </div>
                                <div>
                                    <dt class="inline text-slate-600">Diplôme visé :</dt>
                                    <dd class="inline font-medium text-slate-900">{{ candidature.diplomedemande ?: 'non renseigné' }}</dd>
                                </div>
                            </dl>
                        </div>
                    </li>
                    <li class="flex items-start gap-3 px-5 py-4 sm:px-6">
                        <i class="fas {{ manquantes is empty ? 'fa-circle-check text-green-600' : 'fa-triangle-exclamation text-amber-600' }} mt-0.5 w-5 shrink-0 text-center" aria-hidden="true"></i>
                        <div class="min-w-0 text-sm">
                            <p class="font-medium text-slate-900">Pièces du candidat</p>
                            <p class="mt-0.5 text-slate-700">
                                {% if manquantes is empty %}
                                    Les {{ documents_obligatoires|length }} pièces sont transmises. Ouvrez-les pour vérifier qu'elles sont lisibles et conformes.
                                {% else %}
                                    <span class="tabular-nums">{{ documents_obligatoires|length - manquantes|length }} sur {{ documents_obligatoires|length }}</span> transmises.
                                    Manquante{{ manquantes|length > 1 ? 's' }} : {{ manquantes|join(', ') }}.
                                {% endif %}
                            </p>
                        </div>
                    </li>
                   
                </ul>
            </section>

            {{ fiche.identite(candidat) }}

            {# ===== Pièces : consultation, remplacement, justificatif du conseiller ===== #}
            <section class="overflow-hidden rounded-lg border border-slate-200 bg-white" aria-labelledby="titre-pieces-edition">
                {{ fiche.titre_panneau('Pièces du dossier', 'Ouvrez chaque pièce pour la vérifier. Remplacez-la si elle est illisible ou erronée : JPG, PNG ou PDF, 2 Mo maximum.', 'titre-pieces-edition') }}
                <ul class="divide-y divide-slate-200">
                    {% for champ, libelle in documents_obligatoires %}
                        {{ page.ligne_piece(form_candidature, candidature, champ, libelle, attribute(candidature, champ)) }}
                    {% endfor %}
                </ul>
                <div class="border-t border-slate-200 bg-slate-50 px-5 py-4 sm:px-6">
                    <h3 class="text-sm font-semibold text-slate-900">À joindre par le conseiller VAE</h3>
                    <p class="mt-0.5 text-sm text-slate-700">
                        Obligatoire pour rendre l'étude.
                    </p>
                </div>
                <ul class="border-t border-slate-200">
                    {% for champ, libelle in documents_conseiller %}
                        {{ page.ligne_piece(form_candidature, candidature, champ, libelle, attribute(candidature, champ), true,
                            'piece.present = !!fichier || ' ~ (attribute(candidature, champ) ? 'true' : 'false') ~ '; pieceManquante = false') }}
                    {% endfor %}
                </ul>
            </section>

            {# ===== Informations déclarées, modifiables avant la décision ===== #}
          
            {{ depot.experience(form_candidature, 'Années de métier déclarées par le candidat') }}
            {{ depot.entreprise(form_candidature, 'Structure où le candidat exerce son métier') }}
            {{ depot.formation(form_candidature, candidature, candidature.centre ? candidature.centre.nom : null, 'Métier et diplôme visés par le candidat') }}
        </div>

        {# ===== Décision d'étude ===== #}
        <aside class="lg:col-start-3 lg:row-start-1">
            <section id="decision" aria-labelledby="titre-decision"
                     class="scroll-mt-6 overflow-hidden rounded-lg border border-slate-200 bg-white lg:sticky lg:top-6">
                {{ fiche.titre_panneau('Décision d\'étude', 'Après vérification des pièces et des informations.', 'titre-decision') }}

                <div class="space-y-5 px-5 py-5 sm:px-6">
                    {{ fiche.choix_decision(form_etude.statut, '1') }}

                    {{ ui.champ(form_etude.commentaire, '', {':required': "statut === '1'"},
                        '<span x-show="statut === \'1\'" x-cloak class="font-medium text-red-700">Obligatoire pour un refus : ce motif est communiqué au candidat.</span>'
                        ~ '<span x-show="statut !== \'1\'">Facultatif pour une acceptation.</span>') }}

                    <p class="rounded-lg border border-slate-200 bg-slate-50 p-3 text-sm text-slate-700" x-show="statut === '1'" x-cloak>
                        Le candidat verra le motif. Son dossier reste modifiable et pourra être étudié à nouveau.
                    </p>

                    <p class="text-sm font-medium text-red-700" role="alert" x-show="pieceManquante" x-cloak>
                        <i class="fas fa-circle-exclamation mr-1" aria-hidden="true"></i>Joignez d'abord le justificatif d'expérience professionnelle.
                    </p>

                    <div x-show="!confirmation">
                        <button type="submit" x-ref="enregistrer" @click.prevent="enregistrer($el)"
                                class="inline-flex min-h-[44px] w-full items-center justify-center gap-2 rounded-lg bg-indigo-600 px-5 text-sm font-semibold text-white
                                       transition duration-150 motion-reduce:transition-none hover:bg-indigo-700
                                       focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-600 focus-visible:ring-offset-2">
                            <i class="fas fa-floppy-disk text-xs" aria-hidden="true"></i>Enregistrer la décision
                        </button>
                    </div>

                    <div class="space-y-3 rounded-lg border border-indigo-200 bg-indigo-50 p-4" x-show="confirmation" x-cloak role="group" aria-labelledby="confirmation-etude">
                        <p id="confirmation-etude" class="text-sm text-slate-900">
                            Enregistrer l'étude <strong x-text="statut === '2' ? 'acceptée' : 'refusée'"></strong>
                            pour le dossier <span class="font-mono font-semibold tabular-nums">{{ candidature.numero }}</span> ?
                            Les corrections et les pièces jointes partent avec la décision.
                        </p>
                        <div class="flex flex-col gap-2 sm:flex-row lg:flex-col 2xl:flex-row">
                            <button type="submit" x-ref="confirmer"
                                    class="inline-flex min-h-[44px] flex-1 items-center justify-center gap-2 rounded-lg bg-indigo-600 px-4 text-sm font-semibold text-white
                                           transition duration-150 motion-reduce:transition-none hover:bg-indigo-700
                                           focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-600 focus-visible:ring-offset-2">
                                <i class="fas fa-check text-xs" aria-hidden="true"></i>Confirmer
                            </button>
                            <button type="button" @click="annuler()"
                                    class="inline-flex min-h-[44px] flex-1 items-center justify-center gap-2 rounded-lg border border-slate-300 bg-white px-4 text-sm font-medium text-slate-700
                                           transition duration-150 motion-reduce:transition-none hover:bg-slate-50
                                           focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-600 focus-visible:ring-offset-2">
                                Revenir
                            </button>
                        </div>
                    </div>
                </div>
            </section>
        </aside>
    </div>

    {# Jetons CSRF et champs résiduels du formulaire d'étude #}
    {{ form_rest(form_etude) }}
    {{ form_end(form_candidature) }}
{% else %}
    {# ===== Lecture seule : l'étude est acceptée ===== #}
    <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
        <div class="space-y-6 lg:col-span-2">
            {{ fiche.identite(candidat) }}
            {{ fiche.pieces(candidature, documents, documents_obligatoires|merge(documents_conseiller)) }}
            {{ fiche.informations(candidature) }}
        </div>
        <div class="space-y-6">
            {{ fiche.decisions(candidature) }}
        </div>
    </div>
{% endif %}
{% endblock %}
