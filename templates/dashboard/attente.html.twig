{% extends 'base_dashboard.html.twig' %}

{% block title %}Tableau de bord — Plateforme VAE{% endblock %}

{% block body %}
<div class="relative mb-6 overflow-hidden rounded-2xl border border-primary-200 bg-primary-100 p-6 text-primary-900 md:p-8">

    <div class="relative z-10 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div class="flex items-center gap-4">
            <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl border border-primary-200 bg-white text-2xl text-primary-700">
                <i class="fas fa-graduation-cap" aria-hidden="true"></i>
            </div>
            <div>
                <h1 class="text-2xl font-bold tracking-tight text-primary-900 md:text-3xl">Bonjour {{ app.user.prenoms|default('') }}</h1>
                <p class="text-primary-800 text-sm mt-0.5">
                    {{ role_libelle }}{% if app.user.centre %} — {{ app.user.centre.nom }}{% endif %}
                </p>
            </div>
        </div>
    </div>
    <div class="absolute inset-x-0 bottom-0 h-1 bg-[#ED8F33]" aria-hidden="true"></div>
</div>

<div class="bg-white rounded-lg border border-slate-200 p-10">
    <div class="max-w-md mx-auto text-center">
        <div class="w-16 h-16 mx-auto mb-5 rounded-lg bg-indigo-50 border border-indigo-100 flex items-center justify-center">
            <i class="fas fa-hard-hat text-2xl text-indigo-600"></i>
        </div>
        <h2 class="text-lg font-semibold text-slate-800">Votre espace est en cours de déploiement</h2>
        <p class="text-sm text-slate-500 mt-2 leading-relaxed">
            Les fonctionnalités réservées au rôle « {{ role_libelle }} » seront disponibles
            prochainement. Votre compte est actif et correctement rattaché.
        </p>

        {% if app.user.centre is null and role_libelle != 'Candidat' %}
            <div class="mt-6 rounded-lg bg-amber-50 border border-amber-200 px-4 py-3 text-left">
                <p class="text-xs font-semibold text-amber-800 flex items-center gap-2">
                    <i class="fas fa-triangle-exclamation"></i>
                    Compte non rattaché à un centre
                </p>
                <p class="text-xs text-amber-700 mt-1">
                    Aucune donnée ne peut vous être présentée tant que votre rattachement
                    n'est pas défini. Contactez l'administrateur.
                </p>
            </div>
        {% endif %}

        <a href="{{ path('app_logout') }}"
           class="inline-flex items-center gap-2 mt-7 px-4 py-2 bg-slate-100 text-slate-600 rounded-lg hover:bg-slate-200 transition text-sm font-medium">
            <i class="fas fa-right-from-bracket"></i>
            Se déconnecter
        </a>
    </div>
</div>
{% endblock %}
