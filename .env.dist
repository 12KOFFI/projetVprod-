# === Configuration par defaut du serveur (fichier versionne, SANS secret reel) ===
#
# Symfony charge ce fichier automatiquement quand aucun .env n'est present
# (c'est le cas apres un clone du depot : .env reste volontairement hors de Git).
# Il garantit que l'application demarre, mais il ne contient que des valeurs d'exemple.
#
# >>> ETAPE OBLIGATOIRE SUR LE SERVEUR <<<
# Copier ce fichier a la racine du projet sous le nom exact :  .env.local
# puis y renseigner les vraies valeurs (base de donnees, cle secrete, SMTP).
# .env.local est ignore par Git : les secrets ne remontent donc jamais sur GitHub.
# L'hebergeur n'ayant ni Composer ni la console Symfony, ce depot manuel
# (gestionnaire de fichiers cPanel ou FTP) est le seul moyen de configurer le site.


# --- Environnement ---
# Mode DEV : la barre de debug (Web Profiler) s'affiche en bas de chaque page,
# ce qui permet de diagnostiquer le deploiement sans acces a la console.
#
# /!\ ATTENTION SECURITE : en mode dev, tout visiteur peut consulter les requetes SQL,
# la configuration complete, les variables d'environnement (dont le mot de passe de la base)
# et les traces d'erreur detaillees. A reserver a la phase de mise en route.
APP_ENV=dev
APP_DEBUG=1

# Une fois le site valide : commenter les 2 lignes ci-dessus et decommenter celles-ci
# (plus de barre de debug, mais site nettement plus rapide et securise).
#APP_ENV=prod
#APP_DEBUG=0


# --- Cle secrete ---
# A remplacer dans .env.local par une valeur aleatoire unique (32 caracteres hexadecimaux).
APP_SECRET=a_remplacer_dans_env_local


# --- Base de donnees de production : daip_vae ---
# /!\ Sur cPanel, les noms de base et d'utilisateur sont prefixes par le login cPanel,
#     par exemple monlogin_daip_vae / monlogin_daipuser.
#     Verifier les noms exacts dans cPanel > "Bases de donnees MySQL".
# /!\ Ajuster serverVersion a la version reelle du serveur (visible dans phpMyAdmin) :
#     par exemple 8.0.32 pour MySQL, ou 10.11.2-MariaDB pour MariaDB.
DATABASE_URL="mysql://utilisateur:mot_de_passe@127.0.0.1:3306/daip_vae?serverVersion=8.0.32&charset=utf8mb4"


# --- Messagerie asynchrone (stockee en base, aucun service externe requis) ---
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0


# --- Envoi d'e-mails ---
# Renseigner dans .env.local les identifiants SMTP reels (compte mail cPanel ou service externe).
MAILER_DSN=smtp://utilisateur:mot_de_passe@hote:port?encryption=tls&auth_mode=login
