# ======================================================================
# .htaccess de PRODUCTION de la racine web.
#
# La racine web du domaine pointe sur ce dossier (public/), confirme dans
# cPanel > Domaines : c'est donc ce fichier qu'Apache lit, et le .htaccess de
# la racine du projet n'est jamais evalue.
#
# Durcissement repris de la branche de developpement (audit du 2026-10-29).
# Les regles qui visent les dossiers du projet (var/, stockage/, src/...) sont
# sans effet ici ; elles restent en place au cas ou la racine du site serait un
# jour deplacee a la racine du projet, ou que ce fichier y soit recopie.
# ======================================================================

DirectoryIndex index.php

<IfModule mod_negotiation.c>
    Options -MultiViews
</IfModule>

# Empeche le listing des repertoires d'assets
Options -Indexes

# ======================================================================
# 1. PROTECTION DES FICHIERS SENSIBLES
# ======================================================================

# Quel que soit leur dossier. « ^\.env.* » couvre aussi .env.local,
# .env.local.php et .env.prod.local ; « error_log » est le journal d'erreurs
# PHP que cPanel ecrit a cote du script.
<FilesMatch "(^\.env.*|^\.git.*|^\.ht.*|\.(lock|yml|yaml|sql|sql\.gz|log|bak|dist|twig|md)|composer\.(json|lock)|phpunit\.xml(\.dist)?|^error_log)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Dossiers internes du projet : jamais servis directement. Sans objet quand
    # la racine web est public/, determinant si elle remonte a la racine.
    #   stockage/ : pieces justificatives des candidats (CNI, photos, diplomes)
    #   var/      : cache, journaux, imports du jury, sauvegardes
    #   vendor/, src/, config/, templates/, migrations/, bin/... : code et configuration
    RewriteRule ^(?:bin|config|migrations|src|stockage|templates|tests|translations|var|vendor|node_modules|assets)(?:/|$) - [F,L]

    # Fichiers et dossiers caches (.env.local, .git/, .htaccess...), sauf
    # .well-known, dont cPanel a besoin pour renouveler le certificat HTTPS.
    RewriteRule (?:^|/)\.(?!well-known(?:/|$)) - [F,L]

    # Documents de travail et fichiers techniques poses a la racine servie
    # (modifs.txt, CLAUDE.md, rapports .docx, composer.json...). Les documents
    # publics, eux, sont dans document/ et restent telechargeables.
    RewriteCond %{REQUEST_URI} !^/robots\.txt$
    RewriteRule ^[^/]+\.(?:md|txt|docx|xlsx|lock|json|dist|bak|ini|log|sql|yaml|yml|cache|sh)$ - [F,L]
    RewriteRule ^(?:webpack|tailwind|postcss|playwright)\.config\.js$ - [F,L]

    # Aucun script PHP executable dans les dossiers de fichiers deposes ou
    # telechargeables : un .php televerse sous un nom d'image reste inerte.
    RewriteRule ^(?:public/)?media/.*\.php$ - [F,L]
    RewriteRule ^(?:public/)?image/.*\.php$ - [F,L]
    RewriteRule ^(?:public/)?document/.*\.php$ - [F,L]
</IfModule>

# ======================================================================
# 2. EN-TETES HTTP DE SECURITE
# (l'application les pose aussi via EntetesSecuriteSubscriber, qui n'ecrase
#  pas un en-tete deja present : les valeurs sont identiques des deux cotes)
# ======================================================================
<IfModule mod_headers.c>
    # Empeche l'integration du site dans une iframe externe (clickjacking sur
    # les boutons de decision, de paiement...)
    Header always set X-Frame-Options "SAMEORIGIN"

    # Empeche le navigateur de deviner le type MIME des fichiers
    Header always set X-Content-Type-Options "nosniff"

    # Ancien filtre XSS des navigateurs : desactive, comme le recommande
    # l'OWASP (« 1; mode=block » pouvait lui-meme etre detourne). La
    # protection reelle est l'echappement fait par l'application.
    Header always set X-XSS-Protection "0"

    # Les adresses internes (numeros de dossier, recherches) ne sont pas
    # transmises aux sites externes.
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Redirection HTTP -> HTTPS : a activer une fois le certificat confirme
# (ouvrir https://<domaine> sans alerte). Laisser commente si le site passe
# par Cloudflare en mode « Flexible » : cela creerait une boucle.
#<IfModule mod_rewrite.c>
#    RewriteCond %{HTTPS} off
#    RewriteCond %{REQUEST_URI} !^/\.well-known/
#    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
#</IfModule>

# ======================================================================
# 3. MODE MAINTENANCE
# S'active en deposant un fichier « maintenance.lock » dans la racine web,
# se desactive en le supprimant.
#
# AUCUNE exception d'adresse n'est active : pendant l'intervention, la page de
# maintenance s'affiche pour TOUT LE MONDE, administrateur compris. Pour
# reprendre la main, supprimer maintenance.lock (FTP ou gestionnaire de
# fichiers cPanel).
#
# Pour se reserver l'acces, decommenter la ligne ci-dessous en y mettant son
# adresse IP publique (relevable sur https://api.ipify.org). Les points
# doivent etre echappes, sans quoi ils valent « n'importe quel caractere » :
#
#     RewriteCond %{REMOTE_ADDR} !^203\.0\.113\.42$
#
# Attention : sur un acces grand public l'adresse est generalement dynamique,
# l'exception cessera donc de fonctionner apres un renouvellement de bail.
# ======================================================================
<IfModule mod_rewrite.c>
    RewriteCond %{DOCUMENT_ROOT}/maintenance.lock -f
#   RewriteCond %{REMOTE_ADDR} !^VOTRE\.ADRESSE\.IP\.ICI$
    RewriteCond %{REQUEST_URI} !^/maintenance\.html$
    RewriteRule ^(.*)$ /maintenance.html [R=503,L]
    ErrorDocument 503 /maintenance.html
</IfModule>

# ======================================================================
# 4. ROUTAGE SYMFONY
# ======================================================================
<IfModule mod_rewrite.c>
    # Pas de RewriteBase volontairement : mod_rewrite deduit alors la base du
    # prefixe du repertoire, ce qui vaut « / » quand la racine web pointe
    # directement sur public/ (le cas sur ce serveur) et « /public/ » si elle
    # pointait sur le dossier du projet. La substitution relative
    # « index.php » ci-dessous se resout donc correctement dans les deux
    # montages, la ou une valeur figee casserait l'un des deux.

    # Conserve l'en-tete Authorization (API / auth HTTP) avec PHP en CGI/FastCGI
    RewriteCond %{HTTP:Authorization} .+
    RewriteRule ^ - [E=HTTP_AUTHORIZATION:%0]

    # Les fichiers et dossiers reels (assets Encore, images, documents) sont servis tels quels
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [L]
</IfModule>

<IfModule !mod_rewrite.c>
    <IfModule mod_alias.c>
        RedirectMatch 307 ^/$ /index.php/
    </IfModule>
</IfModule>

# BEGIN cPanel-generated php ini directives
# Ces directives ne s'appliquent qu'en mod_php ou LiteSpeed (LSAPI) ; sous
# PHP-FPM elles sont ignorees et seul l'editeur INI de cPanel fait foi. Garder
# les deux sources coherentes, ainsi que le .htaccess de la racine du projet.
#
# /!\ Si l'editeur "MultiPHP INI Editor" de cPanel est reutilise, il reinjectera
#     sa propre section ici : verifier alors qu'elle ne fait pas doublon.
#
# Valeurs volontairement plus hautes que celles relevees sur le serveur
# (128M / 20M / 6M / 30s) : le depot de candidature televerse plusieurs pieces
# justificatives et la generation PDF depasse 30 s sur les gros dossiers.
# Regle a respecter : memory_limit >= post_max_size >= upload_max_filesize
<IfModule php8_module>
   php_flag display_errors Off
   php_flag log_errors On
   php_value error_log "error_log"
   php_value max_execution_time 150
   php_value max_input_time 120
   php_value max_input_vars 2000
   php_value memory_limit 256M
   php_value post_max_size 14M
   php_value upload_max_filesize 10M
   php_value session.gc_maxlifetime 1440
   php_flag zlib.output_compression On
</IfModule>
<IfModule lsapi_module>
   php_flag display_errors Off
   php_flag log_errors On
   php_value error_log "error_log"
   php_value max_execution_time 150
   php_value max_input_time 120
   php_value max_input_vars 2000
   php_value memory_limit 256M
   php_value post_max_size 14M
   php_value upload_max_filesize 10M
   php_value session.gc_maxlifetime 1440
   php_flag zlib.output_compression On
</IfModule>
# END cPanel-generated php ini directives

# php -- BEGIN cPanel-generated handler, do not edit
# Set the "ea-php83" package as the default "PHP" programming language.
# Indispensable ici : la racine web etant public/, le .htaccess de la racine du
# projet n'est pas lu et PHP retomberait sur la version par defaut de
# l'hebergement.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php83 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
